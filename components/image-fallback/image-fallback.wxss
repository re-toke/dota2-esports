/* :host 选择自定义组件本身，确保组件标签占满父容器。
   没有这个声明时，image-fallback 作为自定义组件默认尺寸由内容决定，
   而内部 .imgfb 的 width:100% 基于组件根节点，根节点为 0 时整个组件不显示，
   导致对阵模块的 logo 框看起来是空的（占位/图片都渲染为 0x0）。 */
:host {
  display: block;
  width: 100%;
  height: 100%;
}

.imgfb {
  position: relative;
  width: 100%;
  height: 100%;
  background: var(--card-bg-inset, #F1F3F5);
  overflow: hidden;
}
.imgfb--round { border-radius: 50%; }
/* 圆形模式（队徽/头像）：金色圆环，模拟队徽轮廓，让占位有"队徽感"而非空框 */
.imgfb--round .imgfb-ph {
  border: 2rpx solid rgba(200, 169, 81, 0.6);
  border-radius: 50%;
  box-sizing: border-box;
}
.imgfb-ph {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 斜线底纹：低透明度金色斜纹，暗示"占位状态"而非 bug 空框 */
  background-image: repeating-linear-gradient(
    -45deg,
    transparent 0,
    transparent 10rpx,
    rgba(200, 169, 81, 0.08) 10rpx,
    rgba(200, 169, 81, 0.08) 20rpx
  );
}
.imgfb-ph-text {
  font-size: var(--fs-subhead);
  font-weight: 800;
  color: var(--dota-gold, #C8A951);
  font-family: var(--font-mono, monospace);
  /* 雾峰雪 v2.0：亮底金字，去掉强阴影，只留极淡描边 */
  text-shadow: 0 1rpx 2rpx var(--overlay-08);
  letter-spacing: 1rpx;
}
.imgfb-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  /* 2026-07-30 修复：默认 opacity:1，淡入改为加载时的装饰性动画。
     原逻辑 opacity:0 且依赖 bindload → .imgfb-img--loaded 才置 1。
     小程序 list 复用 / 动态 src 变更时 bindload 可能偶发不回调，
     图片会永久停留在 opacity:0（不可见，仅底层首字母占位），
     这正是「对阵模块队 logo 显示失败、参赛队伍却能显示」的渲染层根因
     （参赛队伍用原生 <image> 无此 opacity 依赖）。
     现改为默认可见，CSS animation 在元素渲染即播放淡入，不依赖任何 JS 事件。 */
  opacity: 1;
  animation: imgfb-fade-in 250ms ease;
}
@keyframes imgfb-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
/* 兼容旧 class：loaded 时仍保持可见（opacity:1 已覆盖，保留无副作用） */
.imgfb-img.imgfb-img--loaded {
  opacity: 1;
}
