.imgfb {
  position: relative;
  width: 100%;
  height: 100%;
  background: var(--card-bg-inset, #0f141b);
  overflow: hidden;
}
.imgfb--round { border-radius: 50%; }
.imgfb-ph {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.imgfb-ph-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--dota-gold, #C8A951);
  font-family: var(--font-mono, monospace);
}
.imgfb-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  /* P1-D：真图到位淡入，掩盖加载闪烁，体感更快 */
  opacity: 0;
  transition: opacity 250ms ease;
}
.imgfb-img.imgfb-img--loaded {
  opacity: 1;
}
