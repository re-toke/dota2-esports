/* components/week-calendar/week-calendar.wxss */
/* 批次2 · PRD §4.1：周日历。今日 = 金色描边 + 金色日期数字（复核修订：不整格填充，
   填充态留给「选中」）；选中 = 浅金填充 + 金色描边（v4.1 克制版）；
   角标 = 日期右侧内联小胶囊（v4.1 修位：不再绝对定位遮挡日期），今天/选中格内深色反白。 */

.wk {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  padding: var(--space-1-5) var(--space-1);
  background: var(--card-grad);
  border: 1rpx solid var(--td-border-level-1-color, #E5E7EB);
  border-radius: var(--radius-lg);
  box-shadow: var(--card-inner-shadow);
}

/* 跨周箭头 */
.wk-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
}
.wk-arrow--pressed {
  background: var(--overlay-03);
}
.wk-arrow-glyph {
  font-size: 40rpx;
  line-height: 1;
  color: var(--text-2);
}

/* 7 格网格：等分 */
.wk-grid {
  flex: 1;
  display: flex;
}

.wk-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: var(--space-1) 0;
  border-radius: var(--radius-md);
  transition: background 0.15s ease;
}

.wk-cell--pressed {
  background: var(--overlay-02);
}

/* 今日：金色描边（不填充，视觉权重让位 LIVE/选中） */
.wk-cell--today {
  border: 1rpx solid rgba(200, 169, 81, 0.55);
}

/* 选中（v4.1 细节精修）：浅金微填充 + 金色描边（不再整格金色渐变重填充，视觉更克制） */
.wk-cell--selected {
  background: rgba(200, 169, 81, 0.12);
  border: 1rpx solid rgba(200, 169, 81, 0.55);
  box-shadow: none;
}
.wk-cell--selected.wk-cell--today {
  border-color: rgba(200, 169, 81, 0.55);
}

.wk-weekday {
  font-size: var(--fs-caption);
  color: var(--text-2);
  line-height: 1;
}
.wk-cell--selected .wk-weekday {
  color: var(--tier-s);
}

/* 数字角标（v4.1 修位：从绝对定位右上角改为日期右侧内联横排，不再遮挡日期数字） */
.wk-datewrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.wk-date {
  font-size: var(--fs-emphasis);
  font-weight: 700;
  font-feature-settings: 'tnum';
  color: var(--text-1);
  line-height: 1;
}
.wk-date--today {
  color: var(--tier-s);
}
.wk-cell--selected .wk-date {
  color: var(--tier-sss);
}

.wk-badge {
  flex-shrink: 0;
  min-width: 22rpx;
  padding: 0 6rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: rgba(200, 169, 81, 0.16);
  font-size: var(--fs-badge);
  font-weight: 600;
  font-feature-settings: 'tnum';
  color: var(--dota-gold-strong);
  line-height: 1.4;
  text-align: center;
}
/* 今天格内角标反色深色（金色日期上金色角标不可读） */
.wk-badge--today {
  background: rgba(31, 26, 8, 0.78);
  color: var(--dota-gold);
}
.wk-cell--selected .wk-badge {
  background: rgba(31, 26, 8, 0.78);
  color: var(--dota-gold);
}
