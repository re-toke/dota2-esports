/* components/skeleton/skeleton.wxss */
/* §8.3 自定义骨架屏（2026-07-29）
   - shimmer 动画：渐变高光从左到右扫过，循环 1.4s
   - 暗色主题：base #1c232c → highlight #2a323d
   - 匹配项目设计 token（--card-bg / --card-bg-elevated）
*/

/* ===== 基础骨架块 + shimmer 动画 ===== */
.sk-block {
  background: var(--card-bg-elevated, #1c232c);
  border-radius: 8rpx;
  position: relative;
  overflow: hidden;
}
.sk-block::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.06) 50%,
    transparent 100%
  );
  transform: translateX(-100%);
  animation: sk-shimmer 1.4s ease-in-out infinite;
}

@keyframes sk-shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* 尊重 reduced-motion 偏好（无障碍） */
@media (prefers-reduced-motion: reduce) {
  .sk-block::after { animation: none; }
}

/* ===== card：卡片列表骨架 ===== */
.sk-card {
  background: var(--card-bg, #161b22);
  border: 1rpx solid #1f262f;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.sk-card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.sk-badge {
  width: 60rpx;
  height: 36rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.sk-title {
  flex: 1;
  height: 36rpx;
  border-radius: 8rpx;
}
.sk-tier {
  width: 48rpx;
  height: 36rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.sk-card-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.sk-line {
  height: 24rpx;
  border-radius: 6rpx;
}
.sk-line-80 { width: 80%; }
.sk-line-60 { width: 60%; }
.sk-line-90 { width: 90%; }
.sk-line-70 { width: 70%; }
.sk-line-50 { width: 50%; }

/* ===== detail：详情页骨架 ===== */
.sk-detail-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: var(--card-bg, #161b22);
  border: 1rpx solid #1f262f;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}
.sk-head-icon {
  width: 110rpx;
  height: 110rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}
.sk-detail-head-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.sk-head-title {
  height: 40rpx;
  width: 60%;
  border-radius: 8rpx;
}
.sk-head-sub {
  height: 26rpx;
  width: 40%;
  border-radius: 6rpx;
}
.sk-kpi-strip {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  background: var(--card-bg-elevated, #1c232c);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.sk-kpi-cell {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.sk-kpi-label {
  height: 22rpx;
  width: 50%;
  border-radius: 6rpx;
}
.sk-kpi-value {
  height: 32rpx;
  width: 70%;
  border-radius: 8rpx;
}
.sk-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}
.sk-tab {
  flex: 1;
  height: 64rpx;
  border-radius: 12rpx;
}
.sk-detail-card {
  background: var(--card-bg, #161b22);
  border: 1rpx solid #1f262f;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.sk-card-title {
  height: 32rpx;
  width: 30%;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

/* ===== follow：关注卡片横向流骨架 ===== */
.sk-follow-row {
  display: flex;
  gap: 18rpx;
  padding: 4rpx 8rpx 12rpx;
}
.sk-follow-card {
  width: 300rpx;
  height: 168rpx;
  border-radius: 18rpx;
  background: var(--card-bg-elevated, #1c232c);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}
.sk-follow-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.06) 50%,
    transparent 100%
  );
  transform: translateX(-100%);
  animation: sk-shimmer 1.4s ease-in-out infinite;
}
.sk-follow-tier {
  width: 80rpx;
  height: 28rpx;
  border-radius: 6rpx;
}
.sk-follow-vs {
  height: 32rpx;
  width: 60%;
  border-radius: 8rpx;
  align-self: center;
}
.sk-follow-meta {
  height: 24rpx;
  width: 80%;
  border-radius: 6rpx;
}

/* ===== row：简单行骨架 ===== */
.sk-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: var(--card-bg, #161b22);
  border: 1rpx solid #1f262f;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}
.sk-row-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.sk-row-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.sk-row-title {
  height: 30rpx;
  width: 50%;
  border-radius: 8rpx;
}
.sk-row-sub {
  height: 22rpx;
  width: 35%;
  border-radius: 6rpx;
}
.sk-row-tail {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
