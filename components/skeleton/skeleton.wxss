/* components/skeleton/skeleton.wxss */
/* §8.3 自定义骨架屏（2026-07-29）
   - shimmer 动画：渐变高光从左到右扫过，循环 1.4s
   - 雾峰雪 v2.0 主题：base var(--td-bg-color-component) → highlight var(--overlay-05)
   - 匹配项目设计 token（--card-bg / --card-bg-elevated）
*/

/* ===== 基础骨架块 + shimmer 动画 ===== */
.sk-block {
  background: var(--card-bg-elevated, #F1F3F5);
  border-radius: var(--radius-sm);
  position: relative;
  overflow: hidden;
}
.sk-block::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--overlay-05) 50%,
    transparent 100%
  );
  transform: translateX(-100%);
  animation: sk-shimmer 1.4s ease-in-out infinite;
}

@keyframes sk-shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* 尊重 reduced-motion 偏好（无障碍） */
@media (prefers-reduced-motion: reduce) {
  .sk-block::after { animation: none; }
}

/* ===== card：卡片列表骨架 ===== */
.sk-card {
  background: var(--card-bg, #FFFFFF);
  border: 1rpx solid var(--td-border-level-1-color);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  margin-bottom: var(--space-2);
}
.sk-card-head {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-2-5);
}
.sk-badge {
  width: 60rpx;
  height: 36rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.sk-title {
  flex: 1;
  height: 36rpx;
  border-radius: var(--radius-sm);
}
.sk-tier {
  width: 48rpx;
  height: 36rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.sk-card-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-1-5);
}
.sk-line {
  height: 24rpx;
  border-radius: var(--radius-sm);
}
.sk-line-80 { width: 80%; }
.sk-line-60 { width: 60%; }
.sk-line-90 { width: 90%; }
.sk-line-70 { width: 70%; }
.sk-line-50 { width: 50%; }

/* ===== detail：详情页骨架 ===== */
.sk-detail-head {
  display: flex;
  align-items: center;
  gap: var(--space-2-5);
  padding: var(--space-3);
  background: var(--card-bg, #FFFFFF);
  border: 1rpx solid var(--td-border-level-1-color);
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-2);
}
.sk-head-icon {
  width: 110rpx;
  height: 110rpx;
  border-radius: var(--radius-lg);
  flex-shrink: 0;
}
.sk-detail-head-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-1-5);
}
.sk-head-title {
  height: 40rpx;
  width: 60%;
  border-radius: var(--radius-sm);
}
.sk-head-sub {
  height: 26rpx;
  width: 40%;
  border-radius: var(--radius-sm);
}
.sk-kpi-strip {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-2);
  background: var(--card-bg-elevated, #F1F3F5);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  margin-bottom: var(--space-2);
}
.sk-kpi-cell {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.sk-kpi-label {
  height: 22rpx;
  width: 50%;
  border-radius: var(--radius-sm);
}
.sk-kpi-value {
  height: 32rpx;
  width: 70%;
  border-radius: var(--radius-sm);
}
.sk-tabs {
  display: flex;
  gap: var(--space-1-5);
  margin-bottom: var(--space-2);
  padding: 0 var(--space-0-5);
}
.sk-tab {
  flex: 1;
  height: 64rpx;
  border-radius: var(--radius-md);
}
.sk-detail-card {
  background: var(--card-bg, #FFFFFF);
  border: 1rpx solid var(--td-border-level-1-color);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  margin-bottom: var(--space-2);
}
.sk-card-title {
  height: 32rpx;
  width: 30%;
  border-radius: var(--radius-sm);
  margin-bottom: var(--space-2-5);
}

/* ===== follow：关注卡片横向流骨架 ===== */
.sk-follow-row {
  display: flex;
  gap: 18rpx;
  padding: var(--space-0-5) var(--space-1) var(--space-1-5);
}
.sk-follow-card {
  width: 300rpx;
  height: 168rpx;
  border-radius: var(--radius-lg);
  background: var(--card-bg-elevated, #F1F3F5);
  padding: var(--space-2-5);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}
.sk-follow-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--overlay-05) 50%,
    transparent 100%
  );
  transform: translateX(-100%);
  animation: sk-shimmer 1.4s ease-in-out infinite;
}
.sk-follow-tier {
  width: 80rpx;
  height: 28rpx;
  border-radius: var(--radius-sm);
}
.sk-follow-vs {
  height: 32rpx;
  width: 60%;
  border-radius: var(--radius-sm);
  align-self: center;
}
.sk-follow-meta {
  height: 24rpx;
  width: 80%;
  border-radius: var(--radius-sm);
}

/* ===== row：简单行骨架 ===== */
.sk-row {
  display: flex;
  align-items: center;
  gap: var(--space-2-5);
  padding: var(--space-3);
  background: var(--card-bg, #FFFFFF);
  border: 1rpx solid var(--td-border-level-1-color);
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-1-5);
}
.sk-row-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.sk-row-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.sk-row-title {
  height: 30rpx;
  width: 50%;
  border-radius: var(--radius-sm);
}
.sk-row-sub {
  height: 22rpx;
  width: 35%;
  border-radius: var(--radius-sm);
}
.sk-row-tail {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
