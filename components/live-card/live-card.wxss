.live-card {
  margin: var(--space-2) var(--space-3);
  padding: var(--space-2-5) var(--space-3);
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: var(--radius-lg);
}

.live-card.is-live {
  border-color: var(--status-live, #EF4444);
  box-shadow: 0 0 0 2rpx rgba(239, 68, 68, 0.35);
}

.live-head {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-2);
}

.live-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--status-live, #EF4444);
  margin-right: var(--space-1-5);
  animation: live-pulse var(--dur-sway) var(--ease-in-out) infinite;
}

@keyframes live-pulse {
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.7); }
  100% { opacity: 1; transform: scale(1); }
}

.live-title {
  font-size: var(--fs-subhead);
  font-weight: 600;
  color: #1F2937;
  margin-right: var(--space-2);
}

.live-sub {
  font-size: var(--fs-caption);
  color: var(--text-2);
}

.live-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.live-item {
  flex: 1 1 30%;
  min-width: 180rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.95;
}

.live-item-hover {
  opacity: 0.75;
}

.live-name {
  font-size: var(--fs-label);
  font-weight: 600;
  color: var(--text-1);
}
