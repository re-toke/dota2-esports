/* components/empty-state/empty-state.wxss · V3 统一空态 */
.es {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 64rpx var(--space-6);
}
.es-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(200, 169, 81, 0.12);
  border: 2rpx solid rgba(200, 169, 81, 0.32);
  margin-bottom: var(--space-3-5);
}
/* v11 聚光灯 Phase 7：error 态红色调（区别于常规金色空态） */
.es--error .es-icon {
  background: rgba(232, 68, 59, 0.10);
  border-color: rgba(232, 68, 59, 0.28);
}
.es-title {
  font-size: var(--fs-emphasis);
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: var(--space-1-5);
  font-family: var(--font-display, -apple-system, sans-serif);
}
.es-desc {
  font-size: var(--fs-body);
  line-height: var(--lh-relaxed);
  color: var(--text-3);
  max-width: 520rpx;
}
.es-action {
  margin-top: var(--space-4);
}
