/* components/empty-state/empty-state.wxss · V3 统一空态 */
.es {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 64rpx 48rpx;
}
.es-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(200, 169, 81, 0.12);
  border: 2rpx solid rgba(200, 169, 81, 0.32);
  margin-bottom: 28rpx;
}
.es-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #f0f3f6;
  margin-bottom: 12rpx;
  font-family: var(--font-display, -apple-system, sans-serif);
}
.es-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7280;
  max-width: 520rpx;
}
.es-action {
  margin-top: 32rpx;
}
