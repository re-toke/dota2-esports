/* components/empty-state/empty-state.wxss · V4 插画空态（AI 生成电竞主题插画） */
.es {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 64rpx var(--space-6);
}
/* 插画容器：1024x768 (4:3) 与 240x180rpx 同比例，aspectFit 无裁切 */
.es-illustration {
  width: 240rpx;
  height: 180rpx;
  margin-bottom: var(--space-3-5);
}
.es-title {
  font-size: var(--fs-emphasis);
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: var(--space-1-5);
  font-family: var(--font-display, -apple-system, sans-serif);
}
.es-desc {
  font-size: var(--fs-body);
  line-height: var(--lh-relaxed);
  color: var(--text-3);
  max-width: 520rpx;
}
.es-action {
  margin-top: var(--space-4);
}
