.ob-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-mask-background, rgba(14, 17, 22, 0.96));
  padding: 48rpx;
}
.ob-card {
  width: 100%;
  max-width: 560rpx;
  background: var(--card-bg-elevated, #1c232c);
  border: 1rpx solid #2b333d;
  border-radius: var(--radius-lg, 16rpx);
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.ob-dots {
  display: flex;
  gap: 12rpx;
  margin-bottom: 36rpx;
}
.ob-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2b333d;
  transition: all 0.2s;
}
.ob-dot--on {
  background: var(--dota-gold, #C8A951);
  width: 32rpx;
  border-radius: 8rpx;
}
.ob-icon {
  font-size: 88rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}
.ob-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #f0f3f6;
  margin-bottom: 16rpx;
}
.ob-desc {
  font-size: 26rpx;
  color: #9aa4b2;
  line-height: 1.7;
  margin-bottom: 48rpx;
}
.ob-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
}
.ob-skip {
  flex: 0 0 auto;
  padding: 20rpx 28rpx;
  font-size: 26rpx;
  color: #8a8f99;
}
.ob-next {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #0e1116;
  background: var(--dota-gold, #C8A951);
  border-radius: var(--radius-md, 12rpx);
}
