.ob-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-mask-background, rgba(14, 17, 22, 0.96));
  padding: var(--space-6);
}
.ob-card {
  width: 100%;
  max-width: 560rpx;
  background: var(--card-bg-elevated, #222226);
  border: 1rpx solid #2e2e30;
  border-radius: var(--radius-lg, 16rpx);
  padding: var(--space-6) var(--space-5) var(--space-5);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.ob-dots {
  display: flex;
  gap: var(--space-1-5);
  margin-bottom: 36rpx;
}
.ob-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2e2e30;
  transition: all 0.2s;
}
.ob-dot--on {
  background: var(--dota-gold, #C8A951);
  width: 32rpx;
  border-radius: var(--radius-sm);
}
.ob-icon {
  font-size: 88rpx;
  line-height: 1;
  margin-bottom: var(--space-3);
}
.ob-title {
  font-size: var(--fs-display);
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: var(--space-2);
}
.ob-desc {
  font-size: var(--fs-label);
  color: var(--text-2);
  line-height: var(--lh-loose);
  margin-bottom: var(--space-6);
}
.ob-actions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  width: 100%;
}
.ob-skip {
  flex: 0 0 auto;
  padding: var(--space-2-5) var(--space-3-5);
  font-size: var(--fs-label);
  color: var(--text-2);
}
.ob-next {
  flex: 1;
  padding: var(--space-2-5) 0;
  text-align: center;
  font-size: var(--fs-subhead);
  font-weight: 600;
  color: #121015;
  background: var(--dota-gold, #C8A951);
  border-radius: var(--radius-md, 12rpx);
}
