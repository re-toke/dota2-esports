<view class="container with-tab-bar">
  <!-- 聚光灯背景图（v12）：页面级 image（fixed 相对视口，滚动不跟随） -->
  <image class="bg-page" src="/assets/bg-battlefield-dark.webp" mode="aspectFill" />
  <view class="bg-page-dim"></view>
  <!-- ===== 段一 · 身份区（批次4 · PRD §11.1/11.2/11.3 紧凑头部卡） =====
       用户卡 + 统计行合并为单卡：chooseAvatar 头像（96rpx 暗金描边环）+ 昵称 input
       （微信一键填充）+ 内嵌统计行（前两格 tnum 数字，第三格提醒开关徽章）。 -->
  <view class="user-card">
    <view class="uc-top">
      <button class="uc-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{profile.avatarUrl}}" class="uc-avatar-img" src="{{profile.avatarUrl}}" mode="aspectFill" />
        <image wx:else class="uc-avatar-img uc-avatar-default" src="/assets/icons/tab-me-off.png" mode="aspectFit" />
      </button>
      <view class="user-info">
        <input class="uc-name-input" type="nickname" value="{{profile.nickname}}"
               placeholder="点击设置昵称" placeholder-class="uc-name-ph"
               maxlength="12" bindblur="onNicknameBlur" />
        <text class="user-status">{{profile.nickname ? '资料仅保存在本机 · 换机不同步' : '点击设置头像与昵称'}}</text>
      </view>
    </view>
    <!-- 统计行（内嵌，无独立分隔线卡） -->
    <view class="uc-stats">
      <view class="stat-cell" bindtap="switchTab" data-key="teams">
        <text class="stat-value stat-value--num">{{counts.teams}}</text>
        <text class="stat-label">关注战队</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-cell" bindtap="switchTab" data-key="leagues">
        <text class="stat-value stat-value--num">{{counts.leagues}}</text>
        <text class="stat-label">关注赛事</text>
      </view>
      <view class="stat-divider"></view>
      <!-- 第三格：提醒开关徽章（§11.3 已开启=红脉冲点 / 未开启=灰静态点） -->
      <view class="stat-cell" bindtap="scrollToReminder">
        <view class="rem-badge {{subStatus && subStatus.subscribed ? 'rem-badge--on' : ''}}">
          <view class="rem-dot" />
          <text class="rem-text">{{subStatus && subStatus.subscribed ? '已开启' : '未开启'}}</text>
        </view>
        <text class="stat-label">赛事提醒</text>
      </view>
    </view>
  </view>

  <!-- ===== 段二 · 关注阵容（页面主体，保留） ===== -->
  <view class="section-label">关注阵容</view>

  <!-- 分段控件 -->
  <view class="seg">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="seg-item {{activeTab === item.key ? 'active' : ''}}"
      bindtap="switchTab"
      data-key="{{item.key}}"
    >{{item.label}}</view>
  </view>

  <!-- 空态 -->
  <empty-state wx:if="{{items.length === 0}}" type="follow" title="还没有关注任何{{activeLabel}}" desc="在战队 / 赛事列表页点击星标即可加入关注" actionText="{{exploreText}}" bind:action="goExplore" />

  <view wx:else class="list">
    <view class="follow-card anim-fade-up" wx:for="{{items}}" wx:key="id" hover-class="follow-card-hover" style="animation-delay: {{ (index % 12) * 50 }}ms">
      <view class="follow-card-main" bindtap="openItem" data-url="{{item.target}}">
        <view class="follow-avatar follow-avatar-{{item.type}}">
          <!-- ★ 2026-08-13（关注页头像区优化）：战队有队标显示图片；无队标/赛事回退首字母（取消 ★ 收藏图标） -->
          <image wx:if="{{item.type === 'teams' && item.logo}}" class="follow-avatar-img" src="{{item.logo}}" mode="aspectFill" lazy-load="{{true}}" />
          <text wx:elif="{{item.iconText}}">{{item.iconText}}</text>
        </view>
        <view class="follow-info">
          <view class="follow-name-row">
            <text class="follow-name">{{item.displayName || item.name}}</text>
            <text class="type-badge type-{{item.type}}">{{item.typeLabel}}</text>
          </view>
          <text class="follow-sub">{{item.sub}}</text>
        </view>
      </view>
      <view class="follow-action" catchtap="removeItem" data-id="{{item.id}}">
        <t-icon name="close" size="36rpx" color="#6b7280" />
      </view>
    </view>

    <view class="loadmore" wx:if="{{hasMore}}">
      <t-button theme="light" size="medium" bind:tap="appendPage" loading="{{loadingMore}}">加载更多</t-button>
    </view>
    <view wx:elif="{{items.length > pageSize}}" class="center muted">— 已显示全部 {{items.length}} 项 —</view>
  </view>

  <!-- ===== 段三 · 赛前提醒（批次4 · PRD §11.1 合并卡） =====
       sub-card（订阅状态）+ reminder-card（智能设置）合并为单张卡：
       卡头 = 订阅状态徽章 + 开关 pill；卡身 = 提前量/级别 chips（已订阅才展开）。
       subReady=false 降级态：单行引导文案（保留原 tip 语义）。 -->
  <view class="section-label" id="sec-reminder">赛前提醒</view>

  <view class="footer">
    <view class="reminder-card" wx:if="{{subReady}}">
      <view class="sub-card-head">
        <view class="rc-head-left">
          <text class="sub-card-title">{{tmplTitle || '赛前提醒'}}</text>
          <view class="sub-badge {{subStatus.subscribed ? 'sub-badge--on' : 'sub-badge--off'}}">
            {{subStatus.subscribed ? '已开启' : '未开启'}}
          </view>
        </view>
        <view class="rc-toggle {{subStatus.subscribed ? 'rc-toggle--on' : ''}}" bindtap="onToggleReminder" hover-class="tap-scale">
          <text>{{subStatus.subscribed ? '关闭' : '开启'}}</text>
        </view>
      </view>

      <block wx:if="{{subStatus.subscribed}}">
        <view class="sub-card-body">
          <text class="sub-info">今日推送：{{todayCount}} / {{dailyLimit}} 条</text>
        </view>
        <view class="reminder-block">
          <text class="reminder-label">提前量</text>
          <view class="reminder-chips">
            <view
              wx:for="{{leadOptions}}"
              wx:key="sec"
              class="rc-chip {{reminder.leadSec === item.sec ? 'rc-chip--on' : ''}}"
              data-sec="{{item.sec}}"
              bindtap="onLeadChange"
            >{{item.label}}</view>
          </view>
        </view>
        <view class="reminder-block">
          <text class="reminder-label">提醒级别</text>
          <view class="reminder-chips">
            <view
              wx:for="{{tierOptions}}"
              wx:key="grade"
              class="rc-chip {{item.selected ? 'rc-chip--on' : ''}}"
              data-grade="{{item.grade}}"
              bindtap="onTierToggle"
            >{{item.label}}</view>
          </view>
        </view>
        <text class="reminder-hint">仅对选中级别、赛前 {{reminder.leadSec / 60}} 分钟推送，降低打扰</text>
        <text class="rc-reauth" bindtap="onSubscribe">重新授权 ›</text>
      </block>
      <view wx:else class="sub-card-body">
        <text class="sub-info sub-muted">开启后，关注的战队赛前将收到微信提醒</text>
      </view>
    </view>

    <!-- 降级态：模板未配置（§11.1 复核新增） -->
    <view class="reminder-card rc-degraded" wx:else bindtap="openPrivacy" hover-class="tap-scale">
      <text class="rc-degraded-text">配置提醒模板后开启赛前推送 ›</text>
    </view>

    <!-- 推送记录（折叠，默认收起一行） -->
    <view class="send-log" wx:if="{{sendHistory.length > 0}}">
      <view class="sl-fold" bindtap="toggleSendLog" hover-class="tap-scale">
        <text class="send-log-title">推送记录 {{sendHistory.length}} 条</text>
        <t-icon name="{{sendLogExpanded ? 'chevron-up' : 'chevron-down'}}" size="28rpx" color="#9aa4b2" />
      </view>
      <block wx:if="{{sendLogExpanded}}">
        <view class="send-log-item" wx:for="{{sendHistory}}" wx:key="time">
          <view class="sl-status {{item.status === 'ok' ? 'sl-ok' : 'sl-fail'}}">
            {{item.status === 'ok' ? '成功' : '失败'}}
          </view>
          <view class="sl-detail">
            <text class="sl-league">{{item.displayName || item.leagueName || '赛事提醒'}}</text>
            <text class="sl-time">{{item.time}}</text>
          </view>
        </view>
      </block>
    </view>

    <view class="tip muted" wx:if="{{!subReady}}">关注数据仅保存在本机。需在公众平台配置订阅模板后可开启赛事临近提醒。</view>
    <view class="tip muted" wx:else>关注数据仅保存在本机。订阅消息由微信云开发推送，每日上限 {{dailyLimit}} 条。</view>
  </view>

  <!-- 分区标签：系统配置（v11 新增） -->
  <view class="section-label">系统配置</view>
  <view class="settings-card">
    <view class="settings-item" bindtap="openPrivacy" hover-class="follow-card-hover">
      <view class="settings-icon"><t-icon name="lock-on" size="40rpx" color="#6b6b73" /></view>
      <text class="settings-title">隐私与协议</text>
      <t-icon name="chevron-right" size="32rpx" color="#6b7280" />
    </view>
    <view class="settings-item" bindtap="clearCache" hover-class="follow-card-hover">
      <view class="settings-icon"><t-icon name="refresh" size="40rpx" color="#6b6b73" /></view>
      <text class="settings-title">清除本地缓存</text>
      <t-icon name="chevron-right" size="32rpx" color="#6b7280" />
    </view>
    <view class="settings-item" hover-class="follow-card-hover">
      <view class="settings-icon"><t-icon name="info-circle" size="40rpx" color="#6b6b73" /></view>
      <text class="settings-title">关于我们</text>
      <text class="settings-value">v{{appVersion}}</text>
    </view>
    <!-- 批次4 · PRD §11.4 验收5：game-icons.net CC BY 3.0 署名（与 §3.2 图标 PNG 化联动） -->
    <view class="settings-item" hover-class="follow-card-hover">
      <view class="settings-icon"><t-icon name="image" size="40rpx" color="#6b6b73" /></view>
      <text class="settings-title">图标素材</text>
      <text class="settings-value">game-icons.net · CC BY 3.0</text>
    </view>
  </view>

  <view class="bottom-spacer"></view>

  <!-- 聚光灯背景遮罩（v11）：顶部/底部渐变暗化，只作用于背景不遮挡内容 -->
  <view class="bg-mask-top"></view>
  <view class="bg-mask-bottom"></view>
</view>
