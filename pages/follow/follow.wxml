<!-- 「我的」页 · 极简版（2026-09-14）
     ★ 2026-10-24 阶段 1（UI 优化）：
       ① 设置入口上移到 Hero 右侧（齿轮，88rpx 触达），移除列表底部的设置卡；
       ② 取消关注改为「管理 → 多选 → 二次确认」，常规态不再常驻 ×（防误触）；
       ③ 同步状态独立成行内文案，失败时给「重试」文字链（整块 88rpx 触达）。 -->
<view class="container with-tab-bar {{editing ? 'editing' : ''}}">

  <!-- ===== ① 身份条（本机资料 + 云同步开关 + 设置入口） ===== -->
  <view class="hero">
    <button class="hero-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{profile.avatarUrl}}" class="hero-avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
      <image wx:else class="hero-avatar hero-avatar--default" src="/assets/icons/tab-me-off.png" mode="aspectFit" />
    </button>
    <view class="hero-info">
      <input class="hero-name" type="nickname" value="{{profile.nickname}}"
             placeholder="设置昵称" placeholder-class="hero-name-ph"
             maxlength="12" bindblur="onNicknameBlur" />
      <view class="hero-status">
        <view class="status-dot {{sync.status}}"></view>
        <text class="hero-sub">{{sync.status === 'syncing' ? '正在同步…' : (sync.status === 'failed' ? '同步失败' : (sync.enabled ? '已同步 · ' + sync.lastSyncText : '未开启云同步'))}}</text>
        <text wx:if="{{sync.status === 'failed'}}" class="hero-retry" catchtap="onSyncRetry">重试</text>
      </view>
    </view>
    <view class="tap-88" bindtap="onSyncToggle" hover-class="tap-scale">
      <view class="switch {{sync.enabled ? 'on' : ''}} {{sync.status === 'syncing' ? 'busy' : ''}}">
        <view class="switch-knob"></view>
      </view>
    </view>
    <view class="tap-88" bindtap="goSettings" hover-class="tap-scale" aria-role="button" aria-label="设置">
      <image class="gear" src="/assets/icons/gear.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 隐私未授权提示（功能必需：未授权时 type=nickname 会降级为普通文本框） -->
  <view wx:if="{{privacyNeedAuth}}" class="privacy-tip" bindtap="onOpenPrivacyContract" hover-class="tap-scale">
    <text class="privacy-tip-text">需先同意隐私协议，才能使用微信昵称一键填充</text>
    <text class="privacy-tip-link">去同意 ›</text>
  </view>

  <!-- ===== ② 赛前提醒（单行；策略在「设置」页） ===== -->
  <view class="row-card" bindtap="onToggleReminder" hover-class="row-card-hover">
    <view class="row-main">
      <text class="row-title">赛前提醒</text>
      <text class="row-sub">{{!subReady ? '赛事提醒暂未开放' : (subStatus && subStatus.subscribed ? '已开启 · 赛前 ' + reminder.leadSec / 60 + ' 分钟' : '开启后，关注的战队赛前将收到微信提醒')}}</text>
    </view>
    <view class="switch {{subStatus && subStatus.subscribed ? 'on' : ''}}">
      <view class="switch-knob"></view>
    </view>
  </view>

  <!-- ===== ③ 关注阵容（页面主体） ===== -->
  <view class="section-head">
    <view class="section-l">
      <text class="section-title">我的关注</text>
      <text class="section-count">{{counts[activeTab]}}</text>
    </view>
    <text wx:if="{{items.length > 0}}" class="section-action" bindtap="onToggleEdit">{{editing ? '完成' : '管理'}}</text>
  </view>

  <view class="seg-row">
    <view class="seg">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="seg-item {{activeTab === item.key ? 'active' : ''}}"
        bindtap="switchTab"
        data-key="{{item.key}}"
      >{{item.label}} {{item.count}}</view>
    </view>
  </view>

  <empty-state wx:if="{{items.length === 0}}" type="{{activeTab === 'teams' ? 'team' : 'follow'}}" title="还没有关注任何{{activeLabel}}" desc="在战队 / 赛事列表页点击星标即可加入关注" actionText="{{exploreText}}" bind:action="goExplore" />
  <text wx:if="{{items.length === 0}}" class="empty-extra" bindtap="goOngoing">看看正在进行的赛事 ›</text>

  <view wx:else class="list anim-fade">
    <view
      class="follow-row {{editing ? 'follow-row--editing' : ''}}"
      wx:for="{{items}}"
      wx:key="id"
      hover-class="follow-row-hover"
      bindtap="onRowTap"
      data-idx="{{index}}"
      data-url="{{item.target}}"
    >
      <view wx:if="{{editing}}" class="select-dot {{item.selected ? 'on' : ''}}"></view>
      <view class="follow-main">
        <view class="follow-avatar">
          <image wx:if="{{item.type === 'teams' && item.logo}}" class="follow-avatar-img" src="{{item.logo}}" mode="aspectFill" lazy-load="{{true}}" binderror="onFollowLogoError" data-idx="{{index}}" />
          <text wx:elif="{{item.iconText}}">{{item.iconText}}</text>
        </view>
        <text class="follow-name">{{item.displayName || item.name}}</text>
      </view>
      <view wx:if="{{!editing}}" class="chev"></view>
    </view>

    <view class="loadmore" wx:if="{{hasMore}}">
      <t-button theme="light" size="medium" bind:tap="appendPage" loading="{{loadingMore}}">加载更多</t-button>
    </view>
    <view wx:elif="{{items.length > pageSize}}" class="center muted">— 已显示全部 {{items.length}} 项 —</view>
  </view>

  <view class="bottom-spacer"></view>

  <!-- ===== ④ 编辑态底部操作条（固定于 tabBar 之上） ===== -->
  <view wx:if="{{editing}}" class="edit-bar">
    <text class="edit-all" bindtap="onToggleSelectAll">{{allSelected ? '取消全选' : '全选'}}</text>
    <text class="edit-remove {{selectedCount ? '' : 'disabled'}}" bindtap="onBatchRemove">取消关注{{selectedCount ? ' (' + selectedCount + ')' : ''}}</text>
  </view>
</view>
