<view class="container">
  <view class="header">
    <view class="title">我的关注</view>
    <view class="counts">
      <text class="c-chip">战队 {{counts.teams}}</text>
      <text class="c-chip">选手 {{counts.players}}</text>
      <text class="c-chip">赛事 {{counts.leagues}}</text>
    </view>
  </view>

  <view class="seg">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="seg-item {{activeTab === item.key ? 'active' : ''}}"
      bindtap="switchTab"
      data-key="{{item.key}}"
    >{{item.label}}</view>
  </view>

  <t-empty wx:if="{{items.length === 0}}" icon="star" description="还没有关注任何{{activeLabel}}" />

  <view wx:else class="list">
    <view class="card" wx:for="{{items}}" wx:key="id">
      <view class="card-main" bindtap="openItem" data-url="{{item.target}}">
        <view class="name">{{item.name}}</view>
        <view class="sub muted">{{item.sub}}</view>
      </view>
      <view class="card-action" catchtap="removeItem" data-id="{{item.id}}">
        <t-button theme="danger" size="small" t-class="rm-btn">取消关注</t-button>
      </view>
    </view>

    <view class="loadmore" wx:if="{{hasMore}}">
      <t-button theme="light" size="medium" bind:tap="appendPage" loading="{{loadingMore}}">加载更多</t-button>
    </view>
    <view wx:elif="{{items.length > pageSize}}" class="center muted">— 已显示全部 {{items.length}} 项 —</view>
  </view>

  <view class="footer">
    <view class="tip muted">关注数据仅保存在本机。在公众平台配置订阅模板后，可开启赛事临近提醒。</view>
    <t-button theme="primary" size="medium" block bindtap="onSubscribe" t-class="sub-btn">开启赛事提醒</t-button>
  </view>
</view>
