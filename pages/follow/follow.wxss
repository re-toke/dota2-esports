.container { padding: var(--space-3); }

/* ===== 用户卡片（v11 聚光灯：个人英雄面板） ===== */
.user-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-2-5);
  background: linear-gradient(135deg, #1c1c20 0%, #1a1a20 50%, #1a1a1c 100%);
  border-radius: var(--radius-lg, 16rpx);
  padding: var(--space-3) var(--space-2-5);
  margin-bottom: var(--space-2);
  overflow: hidden;
}
/* 顶部金线：暗示"传说级"身份 */
.user-card::before {
  content: '';
  position: absolute;
  top: 0; left: 16rpx; right: 16rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--dota-gold, #C8A951), transparent);
  z-index: 1;
}
/* 底部三色阵营签名条：天辉绿→金→夜魇红 */
.user-card::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, var(--radiant, #5fd35f) 0%, var(--dota-gold, #C8A951) 50%, var(--dire, #e8443b) 100%);
  opacity: 0.6;
  z-index: 1;
}
.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(200, 169, 81, 0.12);
  border: 3rpx solid rgba(200, 169, 81, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.user-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.user-name {
  font-size: var(--fs-heading);
  font-weight: 600;
  color: #f0f3f6;
  font-family: var(--font-display, -apple-system, sans-serif);
}
.user-status {
  font-size: var(--fs-body);
  color: #6b7280;
}

/* ===== 数据统计行（v11 聚光灯：战斗属性 · 三色数值） ===== */
.stat-row {
  display: flex;
  align-items: center;
  background: var(--card-bg, #1a1a1e);
  border-radius: var(--radius-lg, 16rpx);
  padding: var(--space-2-5) 0;
  margin-bottom: var(--space-2);
}
.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-0-5);
  transition: background 120ms ease;
}
.stat-cell:active {
  background: var(--card-bg-inset, #131316);
}
.stat-value {
  font-size: var(--fs-display);
  font-weight: 700;
  color: #f0f3f6;
  font-family: var(--font-display, -apple-system, sans-serif);
}
/* 三色语义：关注战队=天辉绿 / 关注赛事=金色 / 赛事提醒=夜魇红 */
.stat-cell:nth-child(1) .stat-value { color: var(--radiant, #5fd35f); }
.stat-cell:nth-child(3) .stat-value { color: var(--dota-gold, #C8A951); }
.stat-cell:nth-child(5) .stat-value { color: var(--dire, #e8443b); }
.stat-label {
  font-size: var(--fs-caption);
  color: #6b7280;
}
.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #2e2e30;
  flex-shrink: 0;
}

/* ===== 分区标签 ===== */
.section-label {
  font-size: var(--fs-label);
  font-weight: 600;
  color: #9ca3af;
  letter-spacing: 1rpx;
  margin: var(--space-2-5) 0 var(--space-1);
  padding-left: var(--space-0-5);
}

/* ===== 分段控件 ===== */
.seg {
  display: flex;
  background: var(--card-bg-inset, #131316);
  border-radius: var(--radius-md, 12rpx);
  padding: var(--space-0-5);
  margin: var(--space-2) 0;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: var(--fs-label);
  color: #8a8f99;
  border-radius: var(--radius-sm);
  transition: background 120ms ease, color 120ms ease;
}
.seg-item.active {
  background: var(--card-bg-elevated, #222226);
  color: #f0f3f6;
  font-weight: 600;
}

/* ===== 关注卡片（v11 聚光灯：Tier 浸染 + 冷炭灰底） ===== */
.list { margin-bottom: var(--space-3); }
.follow-card {
  position: relative;
  display: flex;
  align-items: center;
  background: var(--card-bg, #1a1a1e);
  border-radius: var(--radius-lg, 16rpx);
  padding: 18rpx var(--space-2-5);
  margin-bottom: var(--space-1-5);
  overflow: hidden;
  transition: background 120ms ease;
}
.follow-card-hover {
  background: var(--card-bg-elevated, #222226);
}
.follow-card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

/* 头像/Logo 占位符：圆角方块，按类型染色 */
.follow-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md, 12rpx);
  background: var(--card-bg-inset, #131316);
  border: 1rpx solid #262628;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-subhead);
  font-weight: 700;
  color: #8a8f99;
  font-family: var(--font-mono, monospace);
  flex-shrink: 0;
}
.follow-avatar-teams {
  background: rgba(95, 211, 95, 0.12);
  color: #5fd35f;
  border-color: rgba(95, 211, 95, 0.3);
}
.follow-avatar-leagues {
  background: rgba(255, 207, 92, 0.12);
  color: #ffcf5c;
  border-color: rgba(255, 207, 92, 0.3);
}
.follow-avatar-icon {
  font-size: var(--fs-heading);
}

.follow-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-0-5);
}
.follow-name-row {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}
.follow-name {
  font-size: var(--fs-emphasis);
  font-weight: 600;
  color: #f0f3f6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: var(--font-display, -apple-system, sans-serif);
}
.type-badge {
  font-size: var(--fs-badge);
  padding: 2rpx var(--space-1);
  border-radius: var(--radius-pill, 999rpx);
  font-weight: 600;
  flex-shrink: 0;
  font-family: var(--font-mono, monospace);
  letter-spacing: 0.5rpx;
}
.type-teams {
  background: rgba(95, 211, 95, 0.14);
  color: #5fd35f;
}
.type-leagues {
  background: rgba(255, 207, 92, 0.14);
  color: #ffcf5c;
}
.follow-sub {
  font-size: var(--fs-caption);
  color: #6b7280;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 取消关注按钮 */
.follow-action {
  padding: var(--space-2) var(--space-1) var(--space-2) var(--space-2);
  flex-shrink: 0;
}

/* ===== 底部 ===== */
.footer { margin-top: var(--space-2); }
.tip {
  font-size: var(--fs-body);
  line-height: var(--lh-relaxed);
  margin-bottom: var(--space-2-5);
  color: #6b7280;
}
.muted { color: #6b7280; }
.loadmore { display: flex; justify-content: center; margin: var(--space-3) 0 var(--space-1); }
.center.muted {
  text-align: center;
  color: #6b7280;
  font-size: var(--fs-body);
  padding: var(--space-3) 0;
}

/* ===== 2.2 订阅状态卡片 ===== */
.sub-card {
  background: var(--card-bg, #1a1a1e);
  border-radius: var(--radius-lg, 16rpx);
  padding: var(--space-3);
  margin-bottom: var(--space-2-5);
  border: 1rpx solid #262628;
}
.sub-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-1-5);
}
.sub-card-title {
  font-size: var(--fs-emphasis);
  font-weight: 600;
  color: #f0f3f6;
}
.sub-badge {
  font-size: var(--fs-micro);
  padding: var(--space-0-5) 14rpx;
  border-radius: var(--radius-pill, 999rpx);
  font-weight: 600;
}
.sub-badge--on {
  background: rgba(95, 211, 95, 0.14);
  color: #5fd35f;
  /* v11 聚光灯：信号激活脉冲（signal-dot 定义在 app.wxss；v18 统一呼吸节奏 --dur-breath） */
  animation: signal-dot var(--dur-breath) var(--ease-in-out) infinite;
}
.sub-badge--off {
  background: rgba(107, 114, 128, 0.14);
  color: #9ca3af;
}
.sub-card-body {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: var(--space-2);
}
.sub-info {
  font-size: var(--fs-body);
  color: #9ca3af;
}
.sub-muted {
  color: #6b7280;
  font-size: var(--fs-body);
}

/* ===== 发送记录 ===== */
.send-log { margin-top: var(--space-2); }
.send-log-title {
  font-size: var(--fs-label);
  font-weight: 600;
  color: #f0f3f6;
  margin-bottom: var(--space-1-5);
}
.send-log-item {
  display: flex;
  align-items: center;
  gap: var(--space-1-5);
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}
.sl-status {
  font-size: var(--fs-micro);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-pill, 999rpx);
  font-weight: 600;
  flex-shrink: 0;
}
.sl-ok {
  background: rgba(95, 211, 95, 0.14);
  color: #5fd35f;
}
.sl-fail {
  background: rgba(248, 113, 113, 0.14);
  color: #f87171;
}
.sl-detail {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: space-between;
}
.sl-league {
  font-size: var(--fs-body);
  color: #d1d5db;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}
.sl-time {
  font-size: var(--fs-caption);
  color: #6b7280;
  flex-shrink: 0;
}

/* 底部 spacer：配合 with-tab-bar 留出自定义 tabBar 区域 */
.bottom-spacer { height: 24rpx; }

/* ===== #20 智能提醒设置 ===== */
.reminder-card {
  background: var(--card-bg, #1a1a1e);
  border-radius: var(--radius-lg, 16rpx);
  padding: var(--space-3);
  margin-bottom: var(--space-2-5);
  border: 1rpx solid #262628;
}
.reminder-block { margin: var(--space-2) 0; }
.reminder-label {
  font-size: var(--fs-body);
  color: #9ca3af;
  margin-bottom: var(--space-1-5);
  display: block;
}
.reminder-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.rc-chip {
  font-size: var(--fs-body);
  padding: 10rpx 22rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: rgba(255,255,255,0.05);
  color: #9ca3af;
  border: 1rpx solid transparent;
}
.rc-chip--on {
  background: rgba(200,169,81,0.16);
  border-color: rgba(200,169,81,0.5);
  color: #e8eef6;
  font-weight: 600;
}
.reminder-hint {
  font-size: var(--fs-caption);
  color: #6b7280;
  margin-top: var(--space-1);
  display: block;
}

/* ===== v11 新增：系统配置区（个人英雄面板底部） ===== */
.settings-card {
  background: var(--card-bg, #1a1a1e);
  border-radius: var(--radius-lg, 14rpx);
  overflow: hidden;
  margin-bottom: var(--space-2);
}
.settings-item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 88rpx;
  padding: 0 var(--space-3);
  background: var(--card-bg, #1a1a1e);
}
.settings-item + .settings-item {
  border-top: 1rpx solid rgba(255,255,255,0.04);
}
.settings-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  flex-shrink: 0;
}
.settings-title {
  flex: 1;
  font-size: var(--fs-subhead);
  color: #f0f3f6;
}
.settings-value {
  font-size: var(--fs-caption);
  color: #6b7280;
}
