.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}
.header .title { font-size: 36rpx; font-weight: 600; color: #f0f3f6; }
.counts { display: flex; gap: 10rpx; }
.c-chip {
  font-size: 22rpx;
  color: #c9d2dd;
  background: #161b22;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.list { margin-bottom: 24rpx; }
.card {
  display: flex;
  align-items: center;
  background: #161b22;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
}
.card-main { flex: 1; min-width: 0; }
.card-main .name { font-size: 30rpx; color: #f0f3f6; }
.card-main .sub { font-size: 24rpx; margin-top: 4rpx; }
.card-action { margin-left: 16rpx; }

.footer { margin-top: 8rpx; }
.tip { font-size: 24rpx; line-height: 1.6; margin-bottom: 20rpx; }
.loadmore { display: flex; justify-content: center; margin: 24rpx 0 8rpx; }
