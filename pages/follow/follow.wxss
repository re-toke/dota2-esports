/* 「我的」页 · 极简版（2026-09-14）
   极简原则：平铺留白、单层卡片、无装饰渐变/彩条/图标环、弱化色彩噪音。
   全部色值/间距/圆角/字号引用 app.wxss token，零新增硬编码色。 */

.container { padding: var(--space-3); }

/* ===== ① 身份条（直接坐在页面底色上，不用卡片 —— 极简签名） ===== */
.hero {
  display: flex;
  align-items: center;
  gap: var(--space-2-5);
  padding: var(--space-2) var(--space-1) var(--space-3);
}
/* chooseAvatar 承载按钮：去原生样式 */
.hero-avatar-btn {
  position: relative;
  padding: 0;
  margin: 0;
  width: 96rpx;
  height: 96rpx;
  background: transparent;
  border: none;
  border-radius: 50%;
  line-height: 1;
  flex-shrink: 0;
}
.hero-avatar-btn::after { border: none; }
.hero-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: block;
  background: var(--card-bg-inset);
}
.hero-avatar--default { padding: 20rpx; box-sizing: border-box; }
.hero-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.hero-name {
  height: 48rpx;
  line-height: 48rpx;
  font-size: var(--fs-heading);
  font-weight: 600;
  color: var(--text-1);
}
.hero-name-ph {
  color: var(--text-4);
  font-weight: 400;
}
.hero-sub {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

/* ===== 隐私未授权提示（可点击去同意） ===== */
.privacy-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-2-5);
  margin-bottom: var(--space-2);
  border-radius: var(--radius-md);
  background: var(--dota-gold-soft);
}
.privacy-tip-text {
  font-size: var(--fs-caption);
  color: var(--tier-s-text);
}
.privacy-tip-link {
  flex-shrink: 0;
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--tier-s-text);
}

/* ===== 通用单行卡（提醒 / 设置入口） ===== */
.row-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  min-height: 112rpx;
  padding: var(--space-2-5) var(--space-3);
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-2);
  transition: background var(--dur-fast) var(--ease-out);
}
.row-card-hover { background: var(--td-bg-color-component); }
.row-card--nav { min-height: 96rpx; }
.row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.row-title {
  font-size: var(--fs-subhead);
  color: var(--text-1);
}
.row-sub {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

/* ===== 开关（纯 CSS，无第三方依赖） ===== */
.switch {
  position: relative;
  flex-shrink: 0;
  width: 76rpx;
  height: 44rpx;
  border-radius: var(--radius-pill);
  background: var(--td-bg-color-component-active);
  transition: background var(--dur-fast) var(--ease-out);
}
.switch.on { background: var(--dota-gold); }
.switch.busy { opacity: 0.5; }
.switch-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--td-bg-color-container);
  box-shadow: 0 1rpx 4rpx var(--overlay-12);
  transition: transform var(--dur-fast) var(--ease-out);
}
.switch.on .switch-knob { transform: translateX(32rpx); }

/* ===== ③ 分段（极简下划线 tab，计数并入标签） ===== */
.seg {
  display: flex;
  gap: var(--space-5);
  margin: var(--space-1) var(--space-1) 0;
  border-bottom: 1rpx solid var(--td-border-level-1-color);
}
.seg-item {
  position: relative;
  padding: 0 0 var(--space-1-5);
  font-size: var(--fs-label);
  color: var(--text-3);
}
.seg-item.active {
  color: var(--text-1);
  font-weight: 600;
}
.seg-item.active::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: var(--dota-gold);
}

/* ===== 关注列表（单卡 + 行分隔，替代逐项卡片） ===== */
.list {
  margin: var(--space-2-5) 0 var(--space-2);
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.follow-row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: var(--space-2) var(--space-3);
  transition: background var(--dur-fast) var(--ease-out);
}
.follow-row + .follow-row { border-top: 1rpx solid var(--td-border-level-1-color); }
.follow-row-hover { background: var(--td-bg-color-component); }
.follow-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: var(--space-2);
}
.follow-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  background: var(--card-bg-inset);
  color: var(--text-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-subhead);
  font-weight: 600;
  flex-shrink: 0;
  overflow: hidden;
}
.follow-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: inherit;
  background: var(--card-bg-inset);
}
.follow-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-subhead);
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.follow-remove {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: var(--space-1);
}
/* CSS 绘制 ×（避免引入图标组件 / 硬编码色） */
.remove-x {
  position: relative;
  width: 26rpx;
  height: 26rpx;
}
.remove-x::before,
.remove-x::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 26rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: var(--text-4);
}
.remove-x::before { transform: translateY(-50%) rotate(45deg); }
.remove-x::after { transform: translateY(-50%) rotate(-45deg); }

/* ===== 加载更多 / 已显示全部 ===== */
.loadmore {
  display: flex;
  justify-content: center;
  padding: var(--space-2-5) 0;
}
.center.muted {
  text-align: center;
  color: var(--text-4);
  font-size: var(--fs-caption);
  padding: var(--space-3) 0;
}

/* ===== CSS 箭头（设置入口） ===== */
.chev {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin-left: var(--space-2);
  border-right: 2rpx solid var(--text-4);
  border-bottom: 2rpx solid var(--text-4);
  transform: rotate(-45deg);
}

/* 底部 spacer：配合 with-tab-bar 留出自定义 tabBar 区域 */
.bottom-spacer { height: 24rpx; }
