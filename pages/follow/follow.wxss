.container { padding: 24rpx; }

/* ===== 头部 ===== */
.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.head-info { flex: 1; min-width: 0; }
.head-info .title {
  font-size: 40rpx;
  font-weight: 700;
  color: #f0f3f6;
  font-family: var(--font-display, -apple-system, sans-serif);
}

/* ===== KPI Strip 局部：点击高亮 ===== */
.kpi-cell { transition: background 120ms ease; }
.kpi-cell:active { background: var(--card-bg-inset, #0f141b); }
.kpi-value.accent { color: var(--kpi-primary, #5fd35f); }

/* ===== 分段控件 ===== */
.seg {
  display: flex;
  background: var(--card-bg-inset, #0f141b);
  border-radius: var(--radius-md, 12rpx);
  padding: 4rpx;
  margin: 16rpx 0;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #8a8f99;
  border-radius: 8rpx;
  transition: background 120ms ease, color 120ms ease;
}
.seg-item.active {
  background: var(--card-bg-elevated, #1c232c);
  color: #f0f3f6;
  font-weight: 600;
}

/* ===== 关注卡片（B 风格 · 卡片流） ===== */
.list { margin-bottom: 24rpx; }
.follow-card {
  display: flex;
  align-items: center;
  background: var(--card-bg, #161b22);
  border-radius: var(--radius-lg, 16rpx);
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  transition: background 120ms ease;
}
.follow-card-hover {
  background: var(--card-bg-elevated, #1c232c);
}
.follow-card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 头像/Logo 占位符：圆角方块，按类型染色 */
.follow-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md, 12rpx);
  background: var(--card-bg-inset, #0f141b);
  border: 1rpx solid #232a33;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #8a8f99;
  font-family: var(--font-mono, monospace);
  flex-shrink: 0;
}
.follow-avatar-teams {
  background: rgba(95, 211, 95, 0.12);
  color: #5fd35f;
  border-color: rgba(95, 211, 95, 0.3);
}
.follow-avatar-leagues {
  background: rgba(255, 207, 92, 0.12);
  color: #ffcf5c;
  border-color: rgba(255, 207, 92, 0.3);
}
.follow-avatar-icon {
  font-size: 32rpx;
}

.follow-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.follow-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.follow-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #f0f3f6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: var(--font-display, -apple-system, sans-serif);
}
.type-badge {
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: var(--radius-pill, 999rpx);
  font-weight: 600;
  flex-shrink: 0;
  font-family: var(--font-mono, monospace);
  letter-spacing: 0.5rpx;
}
.type-teams {
  background: rgba(95, 211, 95, 0.14);
  color: #5fd35f;
}
.type-leagues {
  background: rgba(255, 207, 92, 0.14);
  color: #ffcf5c;
}
.follow-sub {
  font-size: 22rpx;
  color: #6b7280;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 取消关注按钮 */
.follow-action {
  padding: 16rpx 8rpx 16rpx 16rpx;
  flex-shrink: 0;
}

/* ===== 底部 ===== */
.footer { margin-top: 16rpx; }
.tip {
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 20rpx;
  color: #6b7280;
}
.muted { color: #6b7280; }
.loadmore { display: flex; justify-content: center; margin: 24rpx 0 8rpx; }
.center.muted {
  text-align: center;
  color: #6b7280;
  font-size: 24rpx;
  padding: 24rpx 0;
}

/* ===== 2.2 订阅状态卡片 ===== */
.sub-card {
  background: var(--card-bg, #161b22);
  border-radius: var(--radius-lg, 16rpx);
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #232a33;
}
.sub-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.sub-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #f0f3f6;
}
.sub-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill, 999rpx);
  font-weight: 600;
}
.sub-badge--on {
  background: rgba(95, 211, 95, 0.14);
  color: #5fd35f;
}
.sub-badge--off {
  background: rgba(107, 114, 128, 0.14);
  color: #9ca3af;
}
.sub-card-body {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 16rpx;
}
.sub-info {
  font-size: 24rpx;
  color: #9ca3af;
}
.sub-muted {
  color: #6b7280;
  font-size: 24rpx;
}

/* ===== 发送记录 ===== */
.send-log { margin-top: 16rpx; }
.send-log-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #f0f3f6;
  margin-bottom: 12rpx;
}
.send-log-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}
.sl-status {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-pill, 999rpx);
  font-weight: 600;
  flex-shrink: 0;
}
.sl-ok {
  background: rgba(95, 211, 95, 0.14);
  color: #5fd35f;
}
.sl-fail {
  background: rgba(248, 113, 113, 0.14);
  color: #f87171;
}
.sl-detail {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: space-between;
}
.sl-league {
  font-size: 24rpx;
  color: #d1d5db;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}
.sl-time {
  font-size: 22rpx;
  color: #6b7280;
  flex-shrink: 0;
}

/* 底部 spacer：配合 with-tab-bar 留出自定义 tabBar 区域 */
.bottom-spacer { height: 24rpx; }

/* ===== #20 智能提醒设置 ===== */
.reminder-card {
  background: var(--card-bg, #161b22);
  border-radius: var(--radius-lg, 16rpx);
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #232a33;
}
.reminder-block { margin: 16rpx 0; }
.reminder-label {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 12rpx;
  display: block;
}
.reminder-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.rc-chip {
  font-size: 24rpx;
  padding: 10rpx 22rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: rgba(255,255,255,0.05);
  color: #9ca3af;
  border: 1rpx solid transparent;
}
.rc-chip--on {
  background: rgba(200,169,81,0.16);
  border-color: rgba(200,169,81,0.5);
  color: #e8eef6;
  font-weight: 600;
}
.reminder-hint {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 8rpx;
  display: block;
}
