.container { padding: 24rpx; min-height: 100vh; }

.search-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  margin-bottom: 20rpx;
}

/* 初始态引导 */
.search-intro {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 140rpx;
}
.intro-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #e8eef6;
}
.intro-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
  text-align: center;
  padding: 0 60rpx;
}

/* 加载态 */
.search-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}
.loading-text { margin-top: 20rpx; font-size: 24rpx; color: #6b7280; }
.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(200,169,81,0.25);
  border-top-color: #C8A951;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.result-summary {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

/* 分组 */
.result-group {
  margin-bottom: 24rpx;
  background: var(--card-bg, #161b22);
  border: 1rpx solid var(--border, rgba(255,255,255,0.08));
  border-radius: 18rpx;
  overflow: hidden;
}
.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}
.group-title { font-size: 28rpx; font-weight: 700; color: #c9d1d9; }
.group-count {
  font-size: 22rpx;
  color: #C8A951;
  background: rgba(200,169,81,0.14);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}
.result-item:last-child { border-bottom: none; }
.result-name {
  margin-left: 18rpx;
  font-size: 28rpx;
  color: #e8eef6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-thumb {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  margin-left: 0;
}
.item-thumb--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2a2f3a;
  color: #9aa4b2;
  font-size: 20rpx;
}

/* ===== B-3 命令面板 · 快捷入口 ===== */
.search-quick {
  margin-top: 40rpx;
  padding: 0 8rpx;
}
.qk-block { margin-bottom: 32rpx; }
.qk-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.qk-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #8a8f99;
}
.qk-clear {
  font-size: 24rpx;
  color: #ff7b7b;
}
.qk-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.qk-tag {
  padding: 12rpx 26rpx;
  background: #161b22;
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #c3ccd9;
}
.qk-tag:active {
  background: rgba(200,169,81,0.12);
  border-color: rgba(200,169,81,0.4);
  color: #e8eef6;
}
