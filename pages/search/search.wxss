.container { padding: var(--space-3); min-height: 100vh; }

.search-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  margin-bottom: var(--space-2-5);
}

/* 初始态引导 */
.search-intro {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 140rpx;
}
.intro-title {
  margin-top: var(--space-3);
  font-size: var(--fs-display);
  font-weight: 700;
  color: var(--text-1);
}
.intro-sub {
  margin-top: var(--space-1-5);
  font-size: var(--fs-body);
  color: var(--text-3);
  text-align: center;
  padding: 0 60rpx;
}

/* 加载态 */
.search-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}
.loading-text { margin-top: var(--space-2-5); font-size: var(--fs-body); color: var(--text-3); }
.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(200,169,81,0.25);
  border-top-color: #C8A951;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.result-summary {
  font-size: var(--fs-body);
  color: var(--text-3);
  margin-bottom: var(--space-1-5);
}

/* 分组 */
.result-group {
  margin-bottom: var(--space-3);
  background: var(--card-bg, #FFFFFF);
  border: 1rpx solid var(--border, rgba(255,255,255,0.08));
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx var(--space-3);
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}
.group-title { font-size: var(--fs-subhead); font-weight: 700; color: var(--text-3); }
.group-count {
  font-size: var(--fs-caption);
  color: #C8A951;
  background: rgba(200,169,81,0.14);
  border-radius: var(--radius-pill);
  padding: 2rpx 14rpx;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 22rpx var(--space-3);
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}
.result-item:last-child { border-bottom: none; }
.result-name {
  margin-left: 18rpx;
  font-size: var(--fs-subhead);
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-thumb {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-sm);
  margin-left: 0;
}
.item-thumb--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F1F3F5;
  color: var(--text-2);
  font-size: var(--fs-micro);
}

/* ===== B-3 命令面板 · 快捷入口 ===== */
.search-quick {
  margin-top: var(--space-5);
  padding: 0 var(--space-1);
}
.qk-block { margin-bottom: var(--space-4); }
.qk-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-2);
}
.qk-title {
  font-size: var(--fs-label);
  font-weight: 700;
  color: var(--text-2);
}
.qk-clear {
  font-size: var(--fs-body);
  color: var(--dire);
}
.qk-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}
.qk-tag {
  padding: var(--space-1-5) 26rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: var(--radius-pill);
  font-size: var(--fs-label);
  color: var(--text-2);
}
.qk-tag:active {
  background: rgba(200,169,81,0.12);
  border-color: rgba(200,169,81,0.4);
  color: var(--text-1);
}
