<view class="container">
  <view class="search-wrap">
    <t-search value="{{keyword}}" placeholder="搜索战队名称" bind:change="onSearch" bind:clear="onClear" />
  </view>

  <!-- 本地搜索历史：仅在热门(未输入)模式且存在历史时展示 -->
  <view class="hist" wx:if="{{mode === 'hot' && history.length > 0}}">
    <view class="hist-head">
      <text class="hist-title">最近搜索</text>
      <text class="hist-clear" bindtap="onClearHistory">清空</text>
    </view>
    <view class="hist-chips">
      <view
        class="chip"
        wx:for="{{history}}"
        wx:key="*this"
        data-kw="{{item}}"
        bindtap="onTapHistory"
      >{{item}}</view>
    </view>
  </view>

  <!-- 区块标题 + 数据源说明 -->
  <view class="section-header" wx:if="{{mode === 'hot'}}">
    <text class="section-title">热门战队</text>
    <text class="section-action" wx:if="{{hotEnriching}}">数据载入中…</text>
  </view>
  <view class="section-header" wx:elif="{{mode === 'result' && results.length > 0}}">
    <text class="section-title">搜索结果 · {{results.length}}</text>
    <text class="section-action" wx:if="{{resultEnriching}}">补全中…</text>
  </view>

  <!-- 搜索加载骨架屏 -->
  <block wx:if="{{loading}}">
    <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this" style="margin-bottom:16rpx;">
      <t-skeleton theme="paragraph" loading="{{true}}" />
    </view>
  </block>

  <view wx:elif="{{error}}" class="error-block">
    <t-empty icon="info-circle" description="{{error}}" />
    <view class="retry-wrap">
      <t-button theme="primary" size="medium" bindtap="onRetry">重试</t-button>
    </view>
  </view>

  <view wx:elif="{{mode === 'result' && results.length === 0 && !loading}}" class="hint-card-enhanced">
    <view class="hint-title">未找到相关战队</view>
    <view class="hint-desc">试试更通用的关键词，例如「LGD」「Spirit」「OG」</view>
  </view>

  <block wx:else>
    <view class="team-list">
      <view
        class="team-card"
        wx:for="{{mode === 'hot' ? hot : results}}"
        wx:key="id"
        bindtap="openTeam"
        data-id="{{item.id}}"
        hover-class="team-card-hover"
      >
        <!-- 头部：logo + 信息 + 关注 -->
        <view class="team-card-head">
          <view class="team-logo">
            <image
              wx:if="{{item.logo}}"
              class="team-logo-img"
              src="{{item.logo}}"
              mode="aspectFill"
              lazy-load="{{true}}"
            />
            <view wx:else class="team-logo-ph">{{item.tag}}</view>
          </view>

          <view class="team-info">
            <view class="team-info-row">
              <text class="team-info-name">{{item.name}}</text>
              <view wx:if="{{item.country}}" class="country-badge">{{item.country}}</view>
            </view>
            <view class="team-info-meta">
              <text wx:if="{{item.tag}}" class="team-tag">#{{item.tag}}</text>
              <text wx:if="{{item.lastMatchLabel}}" class="team-last">最近 {{item.lastMatchLabel}}</text>
            </view>
          </view>

          <view
            class="team-star"
            catchtap="toggleFollow"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
          >
            <t-icon
              name="star"
              size="44rpx"
              color="{{item.followed ? '#ffcf5c' : '#5b626d'}}"
            />
          </view>
        </view>

        <!-- 数据行：仅在补全完成后展示 -->
        <view wx:if="{{item.hasStats}}" class="team-stats">
          <view class="stat-mini">
            <view class="stat-mini-label">RATING</view>
            <view class="stat-mini-value">{{item.rating}}</view>
          </view>
          <view class="stat-mini-divider"></view>
          <view class="stat-mini">
            <view class="stat-mini-label">胜负</view>
            <view class="stat-mini-value">{{item.wins}}-{{item.losses}}</view>
          </view>
          <view class="stat-mini-divider"></view>
          <view class="stat-mini">
            <view class="stat-mini-label">胜率</view>
            <view class="stat-mini-value {{item.winRateClass}}">{{item.winRate}}%</view>
          </view>
        </view>

        <!-- 数据来源徽标 -->
        <view wx:if="{{item.sourceLabel}}" class="team-source-row">
          <view class="src-badge src-{{item.sourceKey}}">{{item.sourceLabel}}</view>
          <text wx:if="{{item.lastMatchLabel}}" class="team-fresh">{{item.lastMatchLabel}}</text>
        </view>
      </view>
    </view>

    <view class="loadmore" wx:if="{{mode === 'result' && hasMore}}">
      <t-button theme="light" size="medium" bind:tap="appendPage" loading="{{loadingMore}}">加载更多战队</t-button>
    </view>
    <view wx:elif="{{mode === 'result' && results.length > pageSize}}" class="center muted">— 已显示全部 {{results.length}} 支 —</view>
  </block>
</view>
