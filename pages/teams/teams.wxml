<view class="container">
  <view class="search-wrap">
    <t-search value="{{keyword}}" placeholder="{{searchType === 'players' ? '搜索选手名称' : '搜索战队名称'}}" bind:change="onSearch" bind:clear="onClear" />
  </view>

  <!-- 搜索类型切换 -->
  <view class="search-type-bar">
    <view class="type-chip {{searchType === 'teams' ? 'active' : ''}}" data-type="teams" bindtap="onSearchType">战队</view>
    <view class="type-chip {{searchType === 'players' ? 'active' : ''}}" data-type="players" bindtap="onSearchType">选手</view>
  </view>

  <!-- 本地搜索历史：仅在热门(未输入)模式且存在历史时展示 -->
  <view class="hist" wx:if="{{mode === 'hot' && history.length > 0}}">
    <view class="hist-head">
      <text class="hist-title">最近搜索</text>
      <text class="hist-clear" bindtap="onClearHistory">清空</text>
    </view>
    <view class="hist-chips">
      <view
        class="chip"
        wx:for="{{history}}"
        wx:key="*this"
        data-kw="{{item}}"
        bindtap="onTapHistory"
      >{{item}}</view>
    </view>
  </view>

  <!-- 热门搜索推荐词（点击直接搜索） -->
  <view class="hot-words" wx:if="{{mode === 'hot'}}">
    <text class="hot-words-label">热门搜索</text>
    <view class="hot-words-chips">
      <view class="chip" wx:for="{{hotWords}}" wx:key="*this" data-kw="{{item}}" bindtap="onTapHotWord">{{item}}</view>
    </view>
  </view>

  <!-- 区块标题 + 数据源说明 -->
  <view class="section-header" wx:if="{{mode === 'hot'}}">
    <text class="section-title">热门战队</text>
    <text class="section-action" wx:if="{{hotEnriching}}">数据载入中…</text>
  </view>
  <view class="section-header" wx:elif="{{mode === 'result' && results.length > 0}}">
    <text class="section-title">搜索结果 · {{results.length}}</text>
    <text class="section-action" wx:if="{{resultEnriching}}">补全中…</text>
  </view>

  <!-- 搜索加载骨架屏 -->
  <block wx:if="{{loading}}">
    <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this" style="margin-bottom:16rpx;">
      <t-skeleton theme="paragraph" loading="{{true}}" />
    </view>
  </block>

  <empty-state wx:elif="{{error}}" type="error" title="加载失败" desc="{{error}}" actionText="重试" bind:action="onRetry" />

  <view wx:elif="{{mode === 'result' && results.length === 0 && !loading}}">
    <empty-state type="search" title="未找到相关战队" desc="试试更通用的关键词，例如「LGD」「Spirit」「OG」" actionText="重新搜索" bind:action="onClear" />
    <view wx:if="{{suggestion}}" class="sug" bindtap="onTapSuggestion" data-kw="{{suggestion}}">
      你是不是想搜：<text class="sug-kw">{{suggestion}}</text>
    </view>
  </view>

  <block wx:else>
    <view class="team-list">
      <view
        class="team-card anim-fade-up"
        wx:for="{{mode === 'hot' ? hot : results}}"
        wx:key="id"
        bindtap="openTeam"
        data-id="{{item.id}}"
        hover-class="team-card-hover"
        style="animation-delay: {{ (index % 12) * 50 }}ms"
      >
        <!-- 头部：logo + 信息 + 关注 -->
        <view class="team-card-head">
          <view class="team-logo">
            <image
              wx:if="{{item.logo}}"
              class="team-logo-img"
              src="{{item.logo}}"
              mode="aspectFill"
              lazy-load="{{true}}"
            />
            <view wx:else class="team-logo-ph">{{item.tag}}</view>
          </view>

          <view class="team-info">
            <view class="team-info-row">
              <text class="team-info-name">{{item.name}}</text>
              <view wx:if="{{item.country}}" class="country-badge">{{item.country}}</view>
            </view>
            <view class="team-info-meta">
              <text wx:if="{{item.tag}}" class="team-tag">#{{item.tag}}</text>
              <text wx:if="{{item.lastMatchLabel}}" class="team-last">最近 {{item.lastMatchLabel}}</text>
            </view>
          </view>

          <view
            class="team-star"
            catchtap="toggleFollow"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
          >
            <t-icon
              name="star"
              size="44rpx"
              color="{{item.followed ? '#ffcf5c' : '#5b626d'}}"
            />
          </view>
        </view>

        <!-- 数据行：仅在补全完成后展示 -->
        <view wx:if="{{item.hasStats}}" class="team-stats">
          <view class="stat-mini">
            <view class="stat-mini-label">RATING</view>
            <view class="stat-mini-value">{{item.rating}}</view>
          </view>
          <view class="stat-mini-divider"></view>
          <view class="stat-mini">
            <view class="stat-mini-label">胜负</view>
            <view class="stat-mini-value">{{item.wins}}-{{item.losses}}</view>
          </view>
          <view class="stat-mini-divider"></view>
          <view class="stat-mini">
            <view class="stat-mini-label">胜率</view>
            <view class="stat-mini-value {{item.winRateClass}}">{{item.winRate}}%</view>
          </view>
        </view>

        <!-- 数据来源徽标 -->
        <view wx:if="{{item.sourceLabel}}" class="team-source-row">
          <view class="src-badge src-{{item.sourceKey}}">{{item.sourceLabel}}</view>
          <text wx:if="{{item.lastMatchLabel}}" class="team-fresh">{{item.lastMatchLabel}}</text>
        </view>
      </view>
    </view>

    <view class="loadmore" wx:if="{{mode === 'result' && hasMore}}">
      <t-button theme="light" size="medium" bind:tap="appendPage" loading="{{loadingMore}}">加载更多战队</t-button>
    </view>
    <view wx:elif="{{mode === 'result' && results.length > pageSize}}" class="center muted">— 已显示全部 {{results.length}} 支 —</view>

    <!-- 选手搜索结果 -->
    <block wx:if="{{searchType === 'players' && playerResults.length > 0}}">
      <view class="player-list">
        <view class="player-card anim-fade-up" wx:for="{{playerResults}}" wx:key="id" bindtap="openPlayer" data-id="{{item.id}}" hover-class="card-hover" style="animation-delay: {{ (index % 12) * 50 }}ms">
          <view class="player-info">
            <text class="player-name">{{item.name}}</text>
            <text class="player-id muted">ID: {{item.id}}</text>
          </view>
          <view class="player-meta">
            <t-icon name="{{item.followed ? 'star' : 'star'}}" size="36rpx" color="{{item.followed ? '#ffcf5c' : '#5b626d'}}" catchtap="toggleFollowPlayer" data-id="{{item.id}}" data-name="{{item.name}}" />
          </view>
        </view>
      </view>
      <view class="loadmore" wx:if="{{hasMore}}">
        <t-button theme="light" size="medium" bind:tap="appendPage" loading="{{loadingMore}}">加载更多选手</t-button>
      </view>
    </block>
    <block wx:elif="{{searchType === 'players' && playerResults.length === 0 && !loading && searched}}">
      <empty-state type="search" title="未找到选手" desc="换个名字再试试，或看看热门选手" actionText="重新搜索" bind:action="onClear" />
      <view wx:if="{{suggestion}}" class="sug sug--center" bindtap="onTapSuggestion" data-kw="{{suggestion}}">
        你是不是想搜：<text class="sug-kw">{{suggestion}}</text>
      </view>
    </block>
  </block>
</view>
