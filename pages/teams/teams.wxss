.container { padding: var(--space-3); }

.hist { margin: var(--space-1) var(--space-0-5) var(--space-0-5); }
.hist-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: var(--space-1) 0 var(--space-1-5);
}
.hist-title { font-size: var(--fs-label); color: var(--text-2); }
.hist-clear { font-size: var(--fs-body); color: #5b9bff; }
.hist-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
.chip {
  padding: 10rpx var(--space-3);
  background: #1c2230;
  color: #c7ccd6;
  border-radius: 28rpx;
  font-size: var(--fs-label);
}

/* 旧的 .section-title 已由全局 .section-header 组件覆盖，
   这里保留以防有页面未迁移到新组件 */
.section-title {
  font-size: var(--fs-subhead);
  color: var(--text-2);
  margin: var(--space-2) var(--space-0-5) var(--space-1-5);
}

.team-list { margin-top: var(--space-1); }

/* ===== B 风格：队伍卡片 ===== */
.team-card {
  background: var(--card-bg, #1a1a1e);
  border-radius: var(--radius-lg, 16rpx);
  padding: var(--space-2-5) var(--space-3);
  margin-bottom: var(--space-2);
  transition: background 120ms ease, transform 120ms ease;
}
.team-card-hover {
  background: var(--card-bg-elevated, #222226);
  transform: scale(0.99);
}

.team-card-head {
  display: flex;
  align-items: center;
  gap: var(--space-2-5);
}

/* Logo 区：固定 80rpx 圆角方块 */
.team-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md, 12rpx);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--card-bg-inset, #131316);
  border: 1rpx solid #262628;
}
.team-logo-img {
  width: 100%;
  height: 100%;
  display: block;
}
.team-logo-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-label);
  font-weight: 700;
  color: var(--text-2);
  letter-spacing: 1rpx;
  font-family: var(--font-mono, monospace);
}

/* 信息区：弹性增长 */
.team-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-0-5);
}
.team-info-row {
  display: flex;
  align-items: center;
  gap: var(--space-1-5);
}
.team-info-name {
  font-size: var(--fs-emphasis);
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: var(--font-display, -apple-system, sans-serif);
}
.country-badge {
  font-size: var(--fs-micro);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: rgba(95, 211, 95, 0.12);
  color: var(--radiant);
  border: 1rpx solid rgba(95, 211, 95, 0.3);
  font-family: var(--font-mono, monospace);
  letter-spacing: 1rpx;
  flex-shrink: 0;
}
.team-info-meta {
  display: flex;
  align-items: center;
  gap: var(--space-1-5);
  flex-wrap: wrap;
}
.team-tag {
  font-size: var(--fs-caption);
  color: var(--text-2);
  font-family: var(--font-mono, monospace);
}
.team-last {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

/* 关注星按钮 */
.team-star {
  padding: var(--space-1) 0 var(--space-1) var(--space-2);
  flex-shrink: 0;
}

/* 底部统计行：3 列 stat-mini */
.team-stats {
  display: flex;
  align-items: center;
  margin-top: var(--space-2);
  padding-top: var(--space-2);
  border-top: 1rpx solid #262628;
}
.stat-mini {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-0-5);
}
.stat-mini-label {
  font-size: var(--fs-micro);
  color: var(--text-3);
  letter-spacing: 1rpx;
  font-family: var(--font-mono, monospace);
}
.stat-mini-value {
  font-size: var(--fs-subhead);
  font-weight: 700;
  color: var(--text-1);
  font-family: var(--font-numeric, "SF Pro Display", sans-serif);
  font-variant-numeric: tabular-nums;
}
.stat-mini-divider {
  width: 1rpx;
  height: 36rpx;
  background: #262628;
  flex-shrink: 0;
}

/* 数据来源徽标行 */
.team-source-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-1-5);
}
.team-fresh {
  font-size: var(--fs-micro);
  color: var(--text-3);
  font-family: var(--font-mono, monospace);
}

/* ===== 通用 ===== */
.loadmore { display: flex; justify-content: center; margin: var(--space-3) 0 var(--space-1); }
.center.muted {
  text-align: center;
  color: var(--text-3);
  font-size: var(--fs-body);
  padding: var(--space-3) 0;
}

/* ===== 选手搜索结果卡片 ===== */
.player-list {
  margin-top: var(--space-1);
}
.player-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2-5) var(--space-3);
  background: #1a1a1e;
  border-radius: var(--radius-md);
  margin-bottom: var(--space-1-5);
  border: 1rpx solid #1f262f;
  transition: transform 0.12s ease, background 0.12s ease;
}
.card-hover { background: #1c2330; transform: scale(0.99); }
.player-info {
  display: flex;
  flex-direction: column;
  gap: var(--space-0-5);
}
.player-name {
  font-size: var(--fs-subhead);
  color: #e6edf3;
  font-weight: 500;
}
.player-id {
  font-size: var(--fs-caption);
}
.player-meta {
  display: flex;
  align-items: center;
}

/* ===== 热门搜索推荐词 ===== */
.hot-words {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-1-5);
  margin: var(--space-0-5) var(--space-0-5) var(--space-1-5);
}
.hot-words-label {
  font-size: var(--fs-body);
  color: var(--text-2);
}
.hot-words-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1-5);
}

/* ===== 搜索纠错建议 ===== */
.sug {
  margin-top: var(--space-2);
  font-size: var(--fs-label);
  color: var(--text-2);
}
.sug--center { text-align: center; }
.sug-kw {
  color: var(--dota-gold, #C8A951);
  font-weight: 600;
  margin-left: var(--space-0-5);
}

/* 底部 spacer：批次0（2026-08-30）teams 已退出 tabBar，配合 .with-safe-bottom 常规留白 */
.bottom-spacer { height: 24rpx; }

/* ===== 实时联想下拉 ===== */
.sug-list {
  background: #11161d;
  border: 1rpx solid #262628;
  border-radius: var(--radius-lg);
  margin: 10rpx 0 var(--space-0-5);
  overflow: hidden;
}
.sug-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2-5) var(--space-3);
  border-bottom: 1rpx solid #222226;
}
.sug-item:last-child { border-bottom: none; }
.sug-item:active { background: #1a1a1e; }
.sug-name { font-size: var(--fs-subhead); color: #e8e8e8; }
.sug-tag {
  font-size: var(--fs-caption);
  color: var(--text-2);
  background: #1a2029;
  border: 1rpx solid #2a323d;
  border-radius: var(--radius-sm);
  padding: 2rpx var(--space-1-5);
}
