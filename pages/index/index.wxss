.container { padding: var(--space-3); }

/* ===== v4.1：品牌行内联搜索胶囊（合并 brand-header 为一行，搜索框右置） =====
   覆盖 app.wxss 的 .search-bar 通用样式：去底部 margin、收窄高度为胶囊、右对齐 flex:1 */
.search-bar--inline {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  margin-bottom: 0;
  margin-left: auto;
  padding: 0 24rpx;
  border-radius: 32rpx;
  border-color: var(--td-border-level-2-color, #D1D5DB);
}
.search-bar--inline .search-placeholder {
  font-size: var(--fs-caption);
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.search-bar--pressed {
  opacity: 0.82;
  transform: scale(0.98);
}

/* ===== v4.1：快捷入口分区（从页面底部上移，常驻入口带） ===== */
.quick-section {
  margin: var(--space-3) 0 var(--space-0-5);
}
.quick-section-label {
  display: block;
  font-size: var(--fs-caption);
  color: var(--text-2);
  margin: 0 var(--space-1) var(--space-1-5);
  letter-spacing: 1rpx;
}

/* ===== 关注卡片流（2.1，从 leagues 迁入） ===== */
.follow-flow {
  margin: var(--space-3) 0 var(--space-0-5);
}
.ff-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-0-5) var(--space-1) 14rpx;
}
.ff-title {
  font-size: var(--fs-emphasis);
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: 0.5rpx;
}
.ff-more {
  font-size: var(--fs-display);
  color: var(--text-3);
  line-height: 1;
}
.ff-scroll {
  width: 100%;
  white-space: nowrap;
}
.ff-track {
  display: inline-flex;
  gap: 18rpx;
  padding: var(--space-0-5) var(--space-1) var(--space-1-5);
}
.ff-card {
  position: relative;
  overflow: hidden;
  display: inline-flex;
  flex-direction: column;
  width: 300rpx;
  padding: var(--space-2-5) 22rpx var(--space-2-5) 30rpx;
  background: var(--card-grad);
  border: 1rpx solid var(--td-border-level-1-color, #E5E7EB);
  border-radius: var(--radius-lg);
  box-shadow: var(--card-inner-shadow);
}
/* 左侧 Tier 色浸染（v11 聚光灯：色带 + 向右浸染衰减，铺满卡宽自然过渡） */
.ff-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 100%;
  z-index: 0;
  background: var(--td-border-level-1-color, #E5E7EB);
}
.ff-card.tier-sss::before { background: var(--card-glow-sss); }
.ff-card.tier-s::before { background: var(--card-glow-s); }
.ff-card.tier-a::before { background: var(--card-glow-a); }
.ff-card.tier-b::before { background: var(--card-glow-b); }
.ff-card .ff-card-top,
.ff-card .ff-name,
.ff-card .ff-sub,
.ff-card .ff-meta { position: relative; z-index: 1; }
.ff-card-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.ff-tier {
  font-size: var(--fs-micro);
  font-weight: 700;
  color: var(--text-1);
  background: var(--dota-gold, #C8A951);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.ff-league {
  font-size: var(--fs-body);
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ff-vs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  margin-bottom: 14rpx;
}
.ff-team {
  font-size: var(--fs-emphasis);
  font-weight: 800;
  color: var(--text-1);
  max-width: 110rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ff-team.win { color: var(--h2h-a, #2DD4A7); }
.ff-vs-sym {
  font-size: var(--fs-caption);
  color: var(--text-3);
  font-weight: 700;
}
.ff-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}
.ff-cd {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--dota-gold);
  font-family: var(--font-numeric, sans-serif);
  letter-spacing: 0.5rpx;
}
.ff-ended {
  font-size: var(--fs-caption);
  font-weight: 700;
}
.ff-ended.win { color: var(--h2h-a, #2DD4A7); }
.ff-ended.lose { color: var(--h2h-b, #F25C54); }
.ff-date {
  font-size: var(--fs-micro);
  color: var(--text-3);
  flex-shrink: 0;
}
.ff-skeleton-row {
  display: flex;
  gap: 18rpx;
  padding: var(--space-0-5) var(--space-1) var(--space-1-5);
}
.ff-skeleton-card {
  width: 300rpx;
  height: 168rpx;
  border-radius: var(--radius-lg);
  background: var(--card-bg-elevated, #F1F3F5);
  flex-shrink: 0;
}
/* 未关注态引导卡（B+D：增强金色渐变质感） */
.follow-guide {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: var(--space-3) 0 var(--space-0-5);
  padding: 22rpx var(--space-3);
  background: linear-gradient(135deg, rgba(200,169,81,0.10), rgba(200,169,81,0.04));
  border: 1rpx solid rgba(200,169,81,0.22);
  border-radius: var(--radius-lg);
}
.fg-icon { font-size: var(--fs-mega); }
.fg-text { flex: 1; display: flex; flex-direction: column; gap: var(--space-0-5); }
.fg-title { font-size: var(--fs-subhead); font-weight: 700; color: var(--text-1); }
.fg-sub { font-size: var(--fs-caption); color: var(--text-2); }
.fg-btn {
  padding: var(--space-1-5) var(--space-3-5);
  background: linear-gradient(135deg, var(--dota-gold), var(--dota-gold));
  color: var(--tier-s-text);
  font-size: var(--fs-label);
  font-weight: 700;
  border-radius: var(--radius-pill);
}

/* ===== 批次2 · PRD §4：周日历 + 全量比赛流区段 ===== */
/* 「为你推荐」赛事卡已移除（赛事页焦点卡承接），rec-* 样式同步删除 */
.match-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin: var(--space-3) 0 var(--space-1);
}
.match-skeleton {
  padding: var(--space-0-5) 0;
}

/* ===== 快捷入口（v4.1：上移至搜索框下方，margin 由 .quick-section 控制） ===== */
.quick-nav {
  display: flex;
  gap: 18rpx;
  margin: 0 0 var(--space-1);
}
.quick-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: var(--space-3-5) 0;
  background: var(--card-grad);
  border: 1rpx solid var(--td-border-level-1-color);
  border-radius: var(--radius-lg);
  box-shadow: var(--card-inner-shadow);
}
.quick-cell .qc-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
}
/* 单色图标底色按语义微调（暗金/天辉绿/秘银蓝，与图标 PNG 同色系） */
.quick-cell .qc-icon--gold { background: rgba(200,169,81,0.14); }
.quick-cell .qc-icon--green { background: rgba(63,185,80,0.12); }
.quick-cell .qc-icon--blue { background: rgba(88,166,255,0.12); }
.quick-cell .qc-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}
.quick-cell .qc-name { font-size: var(--fs-label); color: var(--text-1); font-weight: 600; }
