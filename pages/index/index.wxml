<view class="container with-tab-bar">
  <!-- 聚光灯背景图（v12）：页面级 image（fixed 相对视口，滚动不跟随） -->
  <image class="bg-page" src="/assets/bg-battlefield-dark.webp" mode="aspectFill" />
  <view class="bg-page-dim"></view>

  <!-- 品牌标识栏（批次2 · PRD §4：删除右侧圆形搜索按钮，常驻搜索框为唯一搜索入口） -->
  <view class="brand-header">
    <image class="brand-logo brand-logo--sm" src="/assets/brand-logo.png" mode="aspectFill" />
    <view class="brand-text">
      <text class="brand-title">DOTA2赛事</text>
      <text class="brand-sub">赛事 · 战队 · 对战</text>
    </view>
  </view>

  <!-- 持久搜索框（5.2 常驻入口，批次2 起为首页唯一搜索入口） -->
  <view class="search-bar" bindtap="openSearch">
    <t-icon name="search" size="32rpx" color="#6b7280" />
    <text class="search-placeholder">搜索赛事 / 战队 / 选手 / 物品</text>
  </view>

  <!-- ===== 批次2 · PRD §4：周日历时间轴 + 全量比赛流（首页数据中枢主体） ===== -->
  <view class="match-section">
    <week-calendar
      days="{{weekDays}}"
      selected="{{selectedDateKey}}"
      bind:select="onDaySelect"
      bind:weekshift="onWeekShift"
    />

    <!-- 首屏骨架（无缓存数据时的加载态） -->
    <view wx:if="{{matchLoading && !matchCards.length}}" class="match-skeleton">
      <skeleton type="card" count="3" />
    </view>

    <match-flow
      wx:else
      cards="{{matchCards}}"
      activeFilter="{{matchFilter}}"
      counts="{{matchCounts}}"
      degraded="{{matchDegraded}}"
      loading="{{matchLoading}}"
      bind:filter="onMatchFilter"
      bind:cardtap="onMatchCardTap"
    />
  </view>

  <!-- 首页「我的关注」横向卡片流（spec C.2.1，从 leagues 迁入）：已关注战队的下一场赛事 + 实时倒计时 -->
  <view wx:if="{{hasFollow}}" class="follow-flow">
    <view class="ff-head" bindtap="openFollowCenter">
      <text class="ff-title">我的关注</text>
      <text class="ff-more">›</text>
    </view>

    <view wx:if="{{followLoading}}">
      <skeleton type="follow" />
    </view>

    <scroll-view wx:elif="{{hasFollowMatches}}" scroll-x class="ff-scroll" enhanced show-scrollbar="{{false}}">
      <view class="ff-track">
        <view class="ff-card {{item.tierClass}}" wx:for="{{followCards}}" wx:key="teamId"
              data-leagueid="{{item.leagueid}}" data-leaguename="{{item.displayName || item.leagueName}}" data-oppid="{{item.oppId}}"
              bindtap="openFollowCard" hover-class="tap-scale">
          <view class="ff-card-top">
            <text wx:if="{{item.tierLabel}}" class="ff-tier">{{item.tierLabel}}</text>
            <text class="ff-league">{{item.displayName || item.leagueName || '其他赛事'}}</text>
          </view>
          <view class="ff-vs">
            <text class="ff-team {{item.status==='ended' && item.won ? 'win' : ''}}">{{item.teamTag}}</text>
            <text class="ff-vs-sym">VS</text>
            <text class="ff-team">{{item.oppTag}}</text>
          </view>
          <view class="ff-meta">
            <text wx:if="{{item.status==='upcoming'}}" class="ff-cd">{{item.countdownText}}</text>
            <text wx:else class="ff-ended {{item.won ? 'win' : 'lose'}}">{{item.score}} {{item.won ? '胜' : '负'}}</text>
            <text class="ff-date">{{item.dateText}}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view wx:else class="ff-empty">
      <text class="ff-empty-text">暂无近期赛事</text>
      <text class="ff-empty-sub">关注的战队近期没有赛程，继续关注更多战队吧</text>
    </view>
  </view>

  <!-- 未关注态引导卡（spec C.AC-C1） -->
  <view wx:elif="{{!hasFollow}}" class="follow-guide" bindtap="goFollowTeams">
    <view class="fg-icon">🤍</view>
    <view class="fg-text">
      <text class="fg-title">关注战队得赛前提醒</text>
      <text class="fg-sub">关注你支持的战队，赛前不错过</text>
    </view>
    <view class="fg-btn">去关注</view>
  </view>

  <!-- ===== 批次2 · PRD §3.2 快捷区三格（战队/英雄库/物品库，game-icons 剪影 PNG） =====
       「为你推荐」赛事卡已按 PRD §4 移除（赛事页焦点卡 focus-card 承接，避免双入口）。 -->
  <view class="quick-nav">
    <view class="quick-cell" data-path="/pages/teams/teams" bindtap="goTab" hover-class="tap-scale">
      <view class="qc-icon qc-icon--gold">
        <image class="qc-img" src="/assets/icons/gi-shield.png" mode="aspectFit" />
      </view>
      <text class="qc-name">战队</text>
    </view>
    <view class="quick-cell" data-path="/subpackages/data/hero/hero" bindtap="goTab" hover-class="tap-scale">
      <view class="qc-icon qc-icon--green">
        <image class="qc-img" src="/assets/icons/gi-swords.png" mode="aspectFit" />
      </view>
      <text class="qc-name">英雄库</text>
    </view>
    <view class="quick-cell" data-path="/subpackages/data/item/item" bindtap="goTab" hover-class="tap-scale">
      <view class="qc-icon qc-icon--blue">
        <image class="qc-img" src="/assets/icons/gi-book.png" mode="aspectFit" />
      </view>
      <text class="qc-name">物品库</text>
    </view>
  </view>

  <!-- 聚光灯背景遮罩（v11）：顶部/底部渐变暗化，只作用于背景不遮挡内容 -->
  <view class="bg-mask-top"></view>
  <view class="bg-mask-bottom"></view>
</view>
