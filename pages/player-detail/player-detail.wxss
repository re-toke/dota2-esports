.container { padding: 24rpx; }

/* ===== 头部（C 风格 · avatar + 名称 + 段位） ===== */
.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.head-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--card-bg-inset, #0e1116);
  border: 1rpx solid #232a33;
}
.head-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.head-avatar-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #8a8f99;
}
.head-info { flex: 1; min-width: 0; }
.head-info .title {
  font-size: 36rpx;
  font-weight: 700;
  color: #f0f3f6;
  line-height: 1.3;
  font-family: var(--font-display, -apple-system, sans-serif);
}
.head-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}
.head-meta .sub { font-size: 24rpx; color: #8a8f99; }
.country-badge {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: rgba(95, 211, 95, 0.12);
  color: #5fd35f;
  border: 1rpx solid rgba(95, 211, 95, 0.3);
  font-family: var(--font-mono, monospace);
  letter-spacing: 1rpx;
}
.rank-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: rgba(96, 84, 241, 0.14);
  color: #8b80ff;
  border: 1rpx solid rgba(96, 84, 241, 0.3);
  font-family: var(--font-mono, monospace);
}
.leaderboard-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: rgba(255, 207, 92, 0.14);
  color: #ffcf5c;
  border: 1rpx solid rgba(255, 207, 92, 0.3);
  font-family: var(--font-mono, monospace);
  font-weight: 600;
}
.star-btn { padding: 4rpx 0 4rpx 16rpx; flex-shrink: 0; }

/* ===== KPI Strip 局部样式 ===== */
.kpi-win { color: var(--status-ongoing, #5fd35f); }
.kpi-lose { color: #e8443b; }

/* ===== 数据溯源合并区（C 风格） ===== */
.source-section {
  background: var(--card-bg-elevated, #1c232c);
  border-radius: var(--radius-lg, 16rpx);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.source-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.source-section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8a8f99;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.source-section-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* ===== 常用英雄卡片 ===== */
.hero-card {
  background: var(--card-bg, #161b22);
  border-radius: var(--radius-lg, 16rpx);
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}
.hero-card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.hero-icon-ph {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md, 12rpx);
  background: var(--card-bg-inset, #0f141b);
  border: 1rpx solid #232a33;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #8a8f99;
  flex-shrink: 0;
}
.hero-icon-ph.sm {
  width: 60rpx;
  height: 60rpx;
  font-size: 24rpx;
}
.hero-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.hero-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #f0f3f6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-games {
  font-size: 22rpx;
  color: #8a8f99;
  font-family: var(--font-mono, monospace);
}
.hero-win-bar {
  width: 120rpx;
  height: 8rpx;
  background: #232a33;
  border-radius: 4rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.hero-win-fill {
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, #e8443b, #5fd35f);
  border-radius: 4rpx;
  transform-origin: left center;
  transition: transform 0.4s ease;
}

/* ===== 近期战绩卡 ===== */
.match-card {
  background: var(--card-bg, #161b22);
  border-radius: var(--radius-lg, 16rpx);
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid transparent;
}
.match-card.win { border-left-color: var(--status-ongoing, #5fd35f); }
.match-card.lose { border-left-color: #e8443b; }
.match-card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.match-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.match-info-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.match-hero {
  font-size: 28rpx;
  font-weight: 600;
  color: #f0f3f6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}
.match-kda {
  font-size: 24rpx;
  color: #c9d2dd;
  font-family: var(--font-mono, monospace);
  font-variant-numeric: tabular-nums;
}
.match-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}
.match-meta {
  font-size: 22rpx;
  color: #6b7280;
  font-family: var(--font-mono, monospace);
}
.match-result {
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill, 999rpx);
}
.match-result.win {
  color: var(--status-ongoing, #5fd35f);
  background: rgba(95, 211, 95, 0.12);
}
.match-result.lose {
  color: #e8443b;
  background: rgba(232, 68, 59, 0.12);
}

/* ===== 通用 ===== */
.loadmore { display: flex; justify-content: center; margin: 24rpx 0 8rpx; }
.error-block { display: flex; flex-direction: column; align-items: center; }
.retry-wrap { margin-top: 16rpx; }
.center.muted {
  text-align: center;
  color: #6b7280;
  font-size: 24rpx;
  padding: 24rpx 0;
}
