.container { padding: 24rpx; }

.entry-grid { display: flex; flex-direction: column; gap: 20rpx; margin-top: 16rpx; }

.entry-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 28rpx;
  background: var(--card-bg, #161b22);
  border: 1rpx solid #1f262f;
  border-radius: var(--radius-lg, 16rpx);
  transition: transform 0.12s ease, background 0.12s ease;
}
.entry-card--hover { background: var(--card-bg-elevated, #1c232c); transform: scale(0.99); }

.entry-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(200, 169, 81, 0.12);
  border: 1rpx solid rgba(200, 169, 81, 0.3);
  flex-shrink: 0;
}

.entry-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.entry-title { font-size: 32rpx; font-weight: 700; color: #f0f3f6; }
.entry-desc {
  font-size: 24rpx;
  color: #8a8f99;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.data-foot {
  text-align: center;
  font-size: 22rpx;
  color: #6b7280;
  padding: 28rpx 0 8rpx;
}
