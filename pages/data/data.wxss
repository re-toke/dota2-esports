.container { padding: var(--space-3); }

.entry-grid { display: flex; flex-direction: column; gap: var(--space-2-5); margin-top: var(--space-2); }

.entry-card {
  display: flex;
  align-items: center;
  gap: var(--space-2-5);
  padding: var(--space-4) var(--space-3-5);
  background: var(--card-bg, #FFFFFF);
  border: 1rpx solid var(--td-border-level-1-color);
  border-radius: var(--radius-lg, 16rpx);
  transition: transform 0.12s ease, background 0.12s ease;
}
.entry-card--hover { background: var(--card-bg-elevated, #F1F3F5); transform: scale(0.99); }

.entry-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(200, 169, 81, 0.12);
  border: 1rpx solid rgba(200, 169, 81, 0.3);
  flex-shrink: 0;
}

.entry-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.entry-title { font-size: var(--fs-heading); font-weight: 700; color: var(--text-1); }
.entry-desc {
  font-size: var(--fs-body);
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  var(--td-bg-color-container)-space: nowrap;
}

.data-foot {
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--text-3);
  padding: var(--space-3-5) 0 var(--space-1);
}
