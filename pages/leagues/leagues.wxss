.container { padding: 24rpx; }

.skeleton-wrap { margin-bottom: 24rpx; }

/* 直播中区域 */
.live-title {
  display: flex; align-items: center; gap: 10rpx;
  font-size: 28rpx; font-weight: 600; color: #1ec896;
  margin: 0 0 16rpx 4rpx;
}
.live-dot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  background: #1ec896;
  animation: livePulse 1.5s ease-in-out infinite;
}
@keyframes livePulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.7); }
}
.live-card {
  background: #161b22;
  border: 1rpx solid rgba(30,200,150,.25);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}
.live-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 6rpx 0;
}
.live-team { font-size: 28rpx; color: #e6edf3; }
.live-score { font-size: 32rpx; font-weight: 700; }
.live-meta { display: flex; gap: 6rpx; margin-top: 6rpx; font-size: 22rpx; }
.live-src {
  margin-left: auto;
  font-size: 20rpx; color: #5b626d;
  background: #111820; border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

.league-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
  background: #161b22;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 24rpx 32rpx;
  margin-bottom: 16rpx;
}
/* 左侧等级彩条 */
.league-item::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6rpx;
}
.tier-sss::before { background: #ffcf5c; }
.tier-s::before { background: #5fd35f; }
.tier-a::before { background: #f0aa28; }
.tier-b::before { background: #9bb0c9; }
.tier-c::before { background: #7a8696; }

.league-main { flex: 1; min-width: 0; }

.league-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #f0f3f6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.league-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.league-meta .src { font-size: 22rpx; }

/* 状态徽标 */
.status-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid;
  line-height: 1.6;
}

/* 第二行 */
.league-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
}
.date-range { color: #9bb0c9; }

.star-btn { padding: 8rpx 0 8rpx 16rpx; }

.more-btn { width: 100%; }
.loadmore { display: flex; justify-content: center; margin: 24rpx 0 8rpx; }
.error-block { display: flex; flex-direction: column; align-items: center; }
.retry-wrap { margin-top: 16rpx; }

/* 即将到来懒加载进度 */
.progress-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}
.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #232a33;
  border-top-color: #5fd35f;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 24rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.progress-text { font-size: 28rpx; color: #e6edf3; margin-bottom: 12rpx; }
.progress-tip { font-size: 22rpx; color: #6b7280; text-align: center; }

/* 即将到来为空且 STRATZ 未启用时的引导卡片 */
.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx 60rpx;
}
.hint-card {
  width: 100%;
  margin-top: 24rpx;
  padding: 32rpx 28rpx;
  background: #1b222c;
  border: 1rpx solid #2d3744;
  border-left: 6rpx solid #ffcf5c;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.hint-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffcf5c;
  margin-bottom: 16rpx;
}
.hint-desc {
  font-size: 26rpx;
  color: #9aa4b2;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.hint-step {
  font-size: 24rpx;
  color: #7d8794;
  line-height: 1.7;
  margin-top: 10rpx;
}
.hint-code {
  font-family: monospace;
  color: #5fd3a8;
  background: #0f141b;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}
