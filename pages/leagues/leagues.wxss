.container { padding: 24rpx; }

.skeleton-wrap { margin-bottom: 24rpx; }

.league-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
  background: #161b22;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 24rpx 32rpx;
  margin-bottom: 16rpx;
}
/* 左侧等级彩条 */
.league-item::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6rpx;
}
.tier-sss::before { background: #ffcf5c; }
.tier-s::before { background: #5fd35f; }
.tier-a::before { background: #f0aa28; }
.tier-b::before { background: #9bb0c9; }
.tier-c::before { background: #7a8696; }

.league-main { flex: 1; min-width: 0; }

.league-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
}
.league-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #f0f3f6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.league-badges {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.league-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.league-meta .src { font-size: 22rpx; }

/* 状态徽标 */
.status-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid;
  line-height: 1.6;
}

/* 第二行 */
.league-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
}
.date-range { color: #9bb0c9; }

/* 即将到来：倒计时高亮 */
.league-countdown {
  margin-top: 8rpx;
  display: inline-flex;
  align-items: center;
  background: rgba(95, 211, 95, 0.10);
  border: 1rpx solid rgba(95, 211, 95, 0.3);
  border-radius: var(--radius-pill, 999rpx);
  padding: 4rpx 16rpx;
}
.countdown-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #5fd35f;
  letter-spacing: 0.5rpx;
}

/* 来源徽标行 */
.league-source-row {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 底部新鲜度 */
.fresh-bottom {
  text-align: center;
  padding: 16rpx 0 8rpx;
}

.star-btn { padding: 8rpx 0 8rpx 16rpx; }

.more-btn { width: 100%; }
.loadmore { display: flex; justify-content: center; margin: 24rpx 0 8rpx; }

/* 即将到来懒加载进度 */
.progress-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}
.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #232a33;
  border-top-color: #5fd35f;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 24rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.progress-text { font-size: 28rpx; color: #e6edf3; margin-bottom: 12rpx; }
.progress-tip { font-size: 22rpx; color: #6b7280; text-align: center; }

/* 即将到来为空且 STRATZ 未启用时的引导卡片 */
.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx 60rpx;
}
.hint-card {
  width: 100%;
  margin-top: 24rpx;
  padding: 32rpx 28rpx;
  background: #1b222c;
  border: 1rpx solid #2d3744;
  border-left: 6rpx solid #ffcf5c;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.hint-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffcf5c;
  margin-bottom: 16rpx;
}
.hint-desc {
  font-size: 26rpx;
  color: #9aa4b2;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.hint-step {
  font-size: 24rpx;
  color: #7d8794;
  line-height: 1.7;
  margin-top: 10rpx;
}
.hint-code {
  font-family: monospace;
  color: #5fd3a8;
  background: #0f141b;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

/* ===== 等级筛选条（第二行）· 品牌色渐变芯片 ===== */
.grade-bar {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}
/* 芯片基础：暗底 + 细边框 + 品牌色描边 */
.gc {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  font-size: 0;
  background: #161b22;
  border: 1.5rpx solid #2d3748;
  cursor: pointer;
  overflow: hidden;
  transition:
    transform 0.20s cubic-bezier(.25,.46,.45,.94),
    border-color 0.22s ease,
    box-shadow   0.22s ease,
    background   0.25s ease;
}
/* hover 微缩放反馈 */
.gc:active {
  transform: scale(0.95);
}
/* 标签文字 */
.gc__label {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #8b949e;
  transition: color 0.22s ease, text-shadow 0.22s ease;
  line-height: 1;
}

/* ── 各等级默认态（未选中）：淡品牌色边框 + 淡文字 ── */
.gc--all   { border-color: #3d4a5c; }
.gc--sss   { border-color: rgba(255,207,92,.40); }
.gc--s     { border-color: rgba(95,211,95,.40); }
.gc--a     { border-color: rgba(240,170,40,.40); }
.gc--b     { border-color: rgba(155,176,201,.40); }

.gc--sss .gc__label { color: rgba(255,207,92,.80); }
.gc--s   .gc__label { color: rgba(95,211,95,.80); }
.gc--a   .gc__label { color: rgba(240,170,40,.80); }
.gc--b   .gc__label { color: rgba(155,176,201,.80); }

/* ── 选中态：渐变背景 + 发光阴影 + 白/深色高对比文字 ── */
.gc--active {
  border-color: transparent;
  box-shadow:
    0 4rpx 16rpx rgba(0,0,0,.30),
    0 0 20rpx var(--gc-glow, rgba(255,255,255,.08));
  transform: translateY(-2rpx);
}
.gc--active:active {
  transform: scale(0.97) translateY(0);
}

/* ALL 选中：中性亮灰 */
.gc--all.gc--active {
  background: linear-gradient(135deg, #3d4a5c 0%, #2d3748 100%);
  box-shadow:
    0 4rpx 16rpx rgba(0,0,0,.30),
    0 0 18rpx rgba(100,120,150,.15);
}
.gc--all.gc--active .gc__label {
  color: #e6edf3;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,.35);
}

/* SSS 选中：金琥珀渐变 */
.gc--sss.gc--active {
  --gc-glow: rgba(255,207,92,.28);
  background: linear-gradient(135deg, #ffcf5c 0%, #f0a020 100%);
  box-shadow:
    0 4rpx 18rpx rgba(255,160,32,.38),
    0 0 24rpx rgba(255,207,92,.22);
}
.gc--sss.gc--active .gc__label {
  color: #1a1400;
  text-shadow: 0 1rpx 2rpx rgba(255,207,92,.5);
}

/* S 选中：翠绿渐变 */
.gc--s.gc--active {
  --gc-glow: rgba(95,211,95,.28);
  background: linear-gradient(135deg, #5fd35f 0%, #2ecc71 100%);
  box-shadow:
    0 4rpx 18rpx rgba(46,204,113,.38),
    0 0 24rpx rgba(95,211,95,.22);
}
.gc--s.gc--active .gc__label {
  color: #0a1f0a;
  text-shadow: 0 1rpx 2rpx rgba(95,211,95,.5);
}

/* A 选中：橙金渐变 */
.gc--a.gc--active {
  --gc-glow: rgba(240,170,40,.28);
  background: linear-gradient(135deg, #f0aa28 0%, #e67e22 100%);
  box-shadow:
    0 4rpx 18rpx rgba(230,126,34,.38),
    0 0 24rpx rgba(240,170,40,.22);
}
.gc--a.gc--active .gc__label {
  color: #1a0f00;
  text-shadow: 0 1rpx 2rpx rgba(240,170,40,.5);
}

/* B 选中：钢蓝渐变 */
.gc--b.gc--active {
  --gc-glow: rgba(155,176,201,.28);
  background: linear-gradient(135deg, #9bb0c9 0%, #7f8fa4 100%);
  box-shadow:
    0 4rpx 18rpx rgba(127,143,164,.38),
    0 0 24rpx rgba(155,176,201,.22);
}
.gc--b.gc--active .gc__label {
  color: #0d1117;
  text-shadow: 0 1rpx 2rpx rgba(155,176,201,.5);
}

/* 来源高亮徽标（Valve 官方 / 顶级第三方） */
.hl-badge {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  line-height: 1.6;
  font-weight: 600;
  flex-shrink: 0;
}
.hl-valve { color: #ffcf5c; background: rgba(255, 207, 92, 0.12); border: 1rpx solid rgba(255, 207, 92, 0.4); }
.hl-tp    { color: #5fd3ff; background: rgba(95, 211, 255, 0.12); border: 1rpx solid rgba(95, 211, 255, 0.4); }

/* 已停办徽标（灰） */
.defunct-tag { color: #8a8f99 !important; border-color: #5b626d !important; background: rgba(91, 98, 109, 0.10); }

/* 已停办赛事归档区 */
.archive-block { margin-top: 24rpx; }
.archive-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 4rpx 16rpx;
}
.archive-title { font-size: 26rpx; font-weight: 600; color: #8a8f99; }
.archive-count {
  font-size: 20rpx;
  color: #0e1116;
  background: #8a8f99;
  border-radius: 999rpx;
  padding: 0 12rpx;
}
/* 归档项整体置灰 */
.league-item.is-defunct { opacity: 0.62; }
.league-item.is-defunct .league-name { color: #aeb6c2; }
