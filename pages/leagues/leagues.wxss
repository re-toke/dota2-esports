.container { padding: var(--space-3); }
/* .with-tab-bar 底部 padding 已在 app.wxss 全局抬到 160rpx（2026-07-29 修复 teams/follow 底部被 tabBar 遮挡），
   leagues 此处不再覆写。 */

/* 底部 spacer：配合 with-tab-bar 留出自定义 tabBar 区域 */
.bottom-spacer {
  height: 24rpx;
}

.skeleton-wrap { margin-bottom: var(--space-3); }

.league-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
  background: var(--card-grad);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4);
  margin-bottom: var(--space-2);
  box-shadow: var(--card-inner-shadow);
}
/* 左侧等级彩条（聚光灯：Tier 色浸染渐变——色带 + 向右浸染衰减）
   色标定义在 app.wxss 全局 --card-glow-* Token（v11）。
   伪元素铺满整卡宽度，渐变在 280rpx 处自然衰减到透明，不遮挡内容 */
.league-item::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 100%;
  z-index: 0;
}
/* Tier 浸染：覆盖全局 .tier-*::before 的纯双色渐变（优先级更高） */
.league-item.tier-sss::before { background: var(--card-glow-sss); }
.league-item.tier-s::before   { background: var(--card-glow-s); }
.league-item.tier-a::before   { background: var(--card-glow-a); }
.league-item.tier-b::before   { background: var(--card-glow-b); }
.league-item.tier-c::before   { background: var(--card-glow-c); }
/* 内容层置顶，确保文字在浸染渐变之上 */
.league-item .league-main,
.league-item .league-badges,
.league-item .league-sub,
.league-item .league-countdown { position: relative; z-index: 1; }
/* 进行中（LIVE）：雾峰雪 v2.0——白卡 + 绿脉冲呼吸（pulse-glow 定义在 app.wxss）
   v4.3 去红：删除 ::before 的 --card-glow-live 红渐变条，
   左侧色条回退为 Tier 色，进行中语义由绿呼吸光晕 + 状态徽标承载 */
.league-item--ongoing {
  background: var(--card-bg, #FFFFFF);
  box-shadow: 0 0 16rpx rgba(95,211,95,0.08), var(--card-inner-shadow, 0 1rpx 4rpx rgba(0,0,0,0.04));
  animation: pulse-glow var(--dur-breath) var(--ease-in-out) infinite;
}
.league-item--ongoing .league-name { color: #1F2937; }
/* 已结束：分元素衰减（文字 85% 可读 / 装饰 45% 渐暗） */
.league-item--ended { opacity: 0.85; }
.league-item--ended::before { opacity: 0.45; }
.league-item--ended .league-badges { opacity: 0.45; }
.league-item--ended .countdown-text { opacity: 0.45; }

.league-main { flex: 1; min-width: 0; }

.league-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-1-5);
  flex-wrap: wrap;
}
.league-name {
  font-size: var(--fs-emphasis);
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.league-badges {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  flex-shrink: 0;
}

.league-meta {
  display: flex;
  align-items: center;
  gap: var(--space-1-5);
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.league-meta .src { font-size: var(--fs-caption); }

/* 状态徽标 */
.status-tag {
  font-size: var(--fs-micro);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid;
  line-height: var(--lh-relaxed);
}

/* 第二行（批次3 · PRD §10.1 meta 行）：左侧日期·场次·奖金池 ≤3 项，
   来源胶囊行尾右对齐（多源验证为差异化卖点，micro 级胶囊视觉轻）。 */
.league-sub {
  margin-top: var(--space-1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-1);
  font-size: var(--fs-caption);
}
.league-sub-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text-3);
}
.date-range { color: #9bb0c9; }
.league-sub .src-inline { flex-shrink: 0; }

/* 即将到来：倒计时高亮（批次1 §9.2：绿→琥珀 --status-upcoming） */
.league-countdown {
  margin-top: var(--space-1);
  display: inline-flex;
  align-items: center;
  background: rgba(240, 170, 40, 0.10);
  border: 1rpx solid rgba(240, 170, 40, 0.3);
  border-radius: var(--radius-pill, 999rpx);
  padding: var(--space-0-5) var(--space-2);
}
.countdown-text {
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--status-upcoming);
  letter-spacing: 0.5rpx;
}

/* 批次3 §10.1：.league-source-row 死样式已移除（来源胶囊并入 league-sub 行尾） */

/* 底部新鲜度 */
.fresh-bottom {
  text-align: center;
  padding: var(--space-2) 0 var(--space-1);
}

.star-btn { padding: var(--space-1) 0 var(--space-1) var(--space-2); min-width: 88rpx; min-height: 88rpx; display: inline-flex; align-items: center; justify-content: flex-start; box-sizing: border-box; }

/* ===== 2026-08-07（v1.3/v1.4）：底部提示条——暖灰渐变融入列表、金色箭头点缀 ===== */
.loadmore-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: var(--space-3-5) auto var(--space-1-5);
  padding: var(--space-2-5) var(--space-5);
  width: fit-content;
  max-width: 520rpx;
  background: var(--card-grad);
  box-shadow: var(--card-inner-shadow);
  border: 1rpx solid #E5E7EB;
  border-radius: var(--radius-pill);          /* 胶囊形 */
  transition: transform 0.12s ease;
}
.loadmore-bar--loading {
  /* 加载中态：去掉点击反馈，降低视觉重量 */
  opacity: 0.7;
  border-style: dashed;
}
/* v1.4：ARMED 确认态——金色边框高亮 + 呼吸动画，提示「可加载」 */
.loadmore-bar--armed {
  border: 1rpx solid rgba(255, 209, 92, 0.6);
  box-shadow: inset 0 2rpx 0 rgba(0,0,0,0.12), inset 0 -2rpx 0 rgba(0,0,0,0.08), 0 0 16rpx rgba(255, 209, 92, 0.12);
  animation: lmArmedGlow var(--dur-sway) var(--ease-in-out) infinite;
}
@keyframes lmArmedGlow {
  0%, 100% { border-color: rgba(255, 209, 92, 0.35); }
  50% { border-color: rgba(255, 209, 92, 0.85); }
}
.lm-text {
  font-size: var(--fs-label);
  color: var(--text-2);
  letter-spacing: 0.5rpx;
}
.lm-text--armed {
  color: #C8A951;
  font-weight: 500;
}
.lm-text--loading {
  color: var(--text-4);
}
.lm-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  /* 金色渐变点缀，呼应项目 SSS tier 色（#C8A951 → #C8A951） */
  filter: drop-shadow(0 0 4rpx rgba(255, 209, 92, 0.15));
  animation: lmArrowBob var(--dur-sway) var(--ease-in-out) infinite;
}
@keyframes lmArrowBob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(4rpx); }
}
/* 旋转加载圈（纯 CSS 无图） */
.lm-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #D1D5DB;
  border-top-color: #C8A951;
  border-radius: 50%;
  animation: lmSpin 0.7s linear infinite;
}
@keyframes lmSpin {
  to { transform: rotate(360deg); }
}

/* 即将到来懒加载进度 */
.progress-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx var(--space-5);
}
.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #E5E7EB;
  border-top-color: var(--dota-gold);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: var(--space-3);
}
@keyframes spin { to { transform: rotate(360deg); } }
.progress-text { font-size: var(--fs-subhead); color: #1F2937; margin-bottom: var(--space-1-5); }
.progress-tip { font-size: var(--fs-caption); color: var(--text-3); text-align: center; }

/* ===== v8.1 P1-4：过期快照「数据截至」提示条（非模态、不打断浏览）===== */
.upcoming-asof-bar {
  margin: 0 var(--space-2) var(--space-2);
  padding: var(--space-1) var(--space-2);
  background: var(--bg-2);
  border-radius: var(--radius-sm);
  text-align: center;
}
.asof-text {
  font-size: var(--fs-caption);
  color: var(--text-3);
  line-height: 1.5;
}

/* 即将到来为空且 STRATZ 未启用时的引导卡片 */
.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-5) var(--space-4) 60rpx;
}
.hint-card {
  width: 100%;
  margin-top: var(--space-3);
  padding: var(--space-4) var(--space-3-5);
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-left: 6rpx solid var(--dota-gold, #C8A951);
  border-radius: var(--radius-lg);
  box-sizing: border-box;
}
.hint-title {
  font-size: var(--fs-emphasis);
  font-weight: 600;
  color: var(--dota-gold-strong);
  margin-bottom: var(--space-2);
}
.hint-desc {
  font-size: var(--fs-label);
  color: var(--text-2);
  line-height: var(--lh-relaxed);
  margin-bottom: var(--space-2-5);
}
.hint-step {
  font-size: var(--fs-body);
  color: var(--text-2);
  line-height: var(--lh-loose);
  margin-top: 10rpx;
}
.hint-code {
  font-family: monospace;
  color: #5fd3a8;
  background: #F1F3F5;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  font-size: var(--fs-caption);
}

/* ===== 等级筛选条（第二行）· 品牌色渐变芯片 ===== */
.grade-bar {
  display: flex;
  justify-content: center;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
  padding: 0 var(--space-0-5);
}
/* 芯片基础：暗底 + 细边框 + 品牌色描边 */
.gc {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 var(--space-3-5);
  border-radius: var(--radius-lg);
  font-size: 0;
  background: #FFFFFF;
  border: 1.5rpx solid #D1D5DB;
  cursor: pointer;
  overflow: hidden;
  transition:
    transform 0.20s cubic-bezier(.25,.46,.45,.94),
    border-color 0.22s ease,
    box-shadow   0.22s ease,
    background   0.25s ease;
}
/* hover 微缩放反馈 */
.gc:active {
  transform: scale(0.95);
}
/* 标签文字 */
.gc__label {
  font-size: var(--fs-label);
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--text-2);
  transition: color 0.22s ease, text-shadow 0.22s ease;
  line-height: 1;
}

/* ── 各等级默认态（未选中）：Tier 描边 + Tier 文字 ── */
.gc--all   { border-color: var(--text-3); }
.gc--s     { border-color: var(--tier-s-line); }
.gc--a     { border-color: var(--tier-a-line); }
.gc--b     { border-color: var(--tier-b-line); }

.gc--s   .gc__label { color: var(--tier-s); }
.gc--a   .gc__label { color: var(--tier-a); }
.gc--b   .gc__label { color: var(--tier-b); }

/* ── 选中态：雾峰雪 v2.0 实色浅底 + 深字（弃用渐变/阴影/光晕） ── */
.gc--active {
  border-color: transparent;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
  transform: translateY(-2rpx);
}
.gc--active:active {
  transform: scale(0.97) translateY(0);
}

/* ALL 选中：中性雾灰浅底 */
.gc--all.gc--active {
  background: #F1F3F5;
}
.gc--all.gc--active .gc__label {
  color: #1F2937;
}

/* S 选中：金浅底（雾峰雪 v2.0） */
.gc--s.gc--active {
  background: #FDF6E3;
}
.gc--s.gc--active .gc__label {
  color: #7A6520;
}

/* A 选中：indigo 浅底（雾峰雪 v2.0） */
.gc--a.gc--active {
  background: #EEF0FB;
}
.gc--a.gc--active .gc__label {
  color: #3730A3;
}

/* B 选中：蓝浅底（雾峰雪 v2.0） */
.gc--b.gc--active {
  background: #EBF4FE;
}
.gc--b.gc--active .gc__label {
  color: #1E40AF;
}
.gc--b.gc--active .gc__label {
  color: #1E40AF;
}

/* 来源高亮徽标（Valve 官方，信任信号保留） */
/* 批次3（2026-08-30）§10.1：hl-tp（顶级第三方）、defunct-tag、archive-x、is-defunct 样式已移除
   （徽章信息移入详情页；defunct 赛事在 applyAndSlice 已过滤不渲染）。 */
.hl-badge {
  font-size: var(--fs-micro);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  line-height: var(--lh-relaxed);
  font-weight: 600;
  flex-shrink: 0;
}
.hl-valve { color: #7A6520; background: #FDF6E3; border: 1rpx solid rgba(200, 169, 81, 0.4); }

/* ===== 焦点卡：重点运营节点（雾峰雪 v2.0 · 白卡 + 品牌金点缀） =====
   弃用暗色渐变 / 重阴影；改用白卡 + 金色径向晕染 + 极淡外阴影。 */
.focus-card {
  position: relative;
  overflow: hidden;
  margin-bottom: var(--space-3);
  padding: var(--space-3-5) var(--space-3-5) 26rpx;
  border-radius: var(--radius-lg);
  background:
    radial-gradient(120% 140% at 0% 0%, rgba(200,169,81,0.10) 0%, rgba(200,169,81,0) 55%),
    var(--card-bg, #FFFFFF);
  border: 1rpx solid #E5E7EB;
  box-shadow: var(--card-inner-shadow, 0 1rpx 4rpx rgba(0,0,0,0.04));
}
/* Tier 色浸染：伪元素铺满整卡（角部光斑 focus-glow 已删，浸染更贴 PRD 视觉） */
.focus-card--tier::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 100%;
  z-index: 0;
  background: var(--card-glow-sss);
  pointer-events: none;
}
.focus-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.focus-badges { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.focus-valve {
  font-size: var(--fs-micro); font-weight: 700;
  color: #7A6520; background: #FDF6E3;
  padding: 3rpx var(--space-1-5); border-radius: var(--radius-sm);
  border: 1rpx solid rgba(200,169,81,0.4);
}
.focus-flag {
  font-size: var(--fs-micro); font-weight: 600;
  color: var(--dota-gold-strong); border: 1rpx solid rgba(255,207,92,0.5);
  padding: 2rpx 10rpx; border-radius: var(--radius-sm);
}
/* LIVE 徽章：红点脉冲 + 文案（批次3 §10.2） */
.focus-live {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--fs-micro); font-weight: 700; color: var(--status-live);
  background: rgba(255,91,91,0.12); border: 1rpx solid rgba(255,91,91,0.45);
  padding: 2rpx 10rpx; border-radius: var(--radius-sm);
}
.focus-live-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--status-live);
  animation: focus-live-pulse 1.6s ease-in-out infinite;
}
@keyframes focus-live-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.55; transform: scale(0.82); }
}
@media (prefers-reduced-motion: reduce) {
  .focus-live-dot { animation: none; }
}
.focus-star { padding: 0 0 0 var(--space-2); }
.focus-title {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  font-size: var(--fs-display); font-weight: 800; color: var(--dota-gold-strong);
  letter-spacing: 0.5rpx;
  text-shadow: 0 2rpx 8rpx rgba(255,207,92,.18);
}
.focus-sub {
  position: relative;
  z-index: 1;
  margin-top: 6rpx;
  font-size: var(--fs-body); color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.focus-meta {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  display: flex; align-items: center; gap: 14rpx; flex-wrap: wrap;
}
.focus-date { font-size: var(--fs-body); color: #9bb0c9; }
.focus-prize {
  font-size: var(--fs-caption); font-weight: 600; color: #5fd3a8;
  background: rgba(95,211,168,0.10); border: 1rpx solid rgba(95,211,168,0.35);
  padding: 2rpx var(--space-1-5); border-radius: var(--radius-sm);
}
.focus-countdown {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  display: inline-flex; align-items: baseline; gap: var(--space-1);
  background: rgba(255,207,92,0.10);
  border: 1rpx solid rgba(255,207,92,0.35);
  border-radius: var(--radius-pill);
  padding: var(--space-1) 22rpx;
}
/* 倒计时大数字：52rpx fs-hero tnum 亮金（批次3 §10.2） */
.cd-num {
  font-size: var(--fs-hero);
  font-weight: 800;
  color: var(--dota-gold-strong);
  line-height: 1;
  font-family: var(--font-numeric);
  font-feature-settings: 'tnum';
}
.cd-unit { font-size: var(--fs-body); color: var(--dota-gold-strong); }
.focus-countdown--live { background: rgba(255,91,91,0.12); border-color: rgba(255,91,91,0.45); }
.cd-live { font-size: var(--fs-subhead); font-weight: 700; color: var(--dire); }
.focus-cta {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  font-size: var(--fs-body); color: var(--text-2);
  letter-spacing: 0.5rpx;
}

/* 进行中态：红金边框，突出直播氛围 */
.focus-card--live {
  border-color: rgba(239,68,68,0.50);
  box-shadow: var(--card-inner-shadow, 0 1rpx 4rpx rgba(0,0,0,0.04)), 0 0 16rpx rgba(239,68,68,.10);
}

/* ===== 战队筛选入口（spec A）===== */
.team-filter-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin: var(--space-2) var(--space-0-5) var(--space-0-5);
}
.team-filter-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  padding: 10rpx 22rpx;
  background: var(--card-bg, #FFFFFF);
  border: 1rpx solid var(--td-border-level-1-color, #E5E7EB);
  border-radius: var(--radius-pill);
  font-size: var(--fs-label);
  color: var(--text-2);
}
.team-filter-btn--active {
  color: var(--dota-gold, #C8A951);
  border-color: rgba(200,169,81,0.5);
  background: rgba(200,169,81,0.10);
}
.tf-label { font-weight: 600; }
.tf-badge {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 var(--space-1);
  border-radius: var(--radius-pill);
  background: var(--dota-gold, #C8A951);
  color: #1F2937;
  font-size: var(--fs-micro);
  font-weight: 800;
  line-height: 30rpx;
  text-align: center;
}
.team-clear {
  font-size: var(--fs-body);
  color: var(--dire);
}
.team-hint {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

/* ===== 战队筛选弹层（spec A · 雾峰雪 v2.0）===== */
.tf-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.40);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.tf-sheet {
  width: 100%;
  max-height: 78vh;
  background: var(--card-bg, #FFFFFF);
  border-radius: 28rpx 28rpx 0 0;
  padding: var(--space-3-5) var(--space-3-5) calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.04);
}
.tf-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-2-5);
}
.tf-sheet-title { font-size: var(--fs-emphasis); font-weight: 700; color: var(--text-1); }
.tf-sheet-tools { display: flex; gap: var(--space-3); }
.tf-tool { font-size: var(--fs-label); color: var(--dota-gold, #C8A951); }
.tf-list {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.tf-cell {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: 22rpx var(--space-1-5);
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}
.tf-cell--checked { background: rgba(200,169,81,0.06); }
.tf-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid #3a424d;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.tf-check--on {
  background: var(--dota-gold, #C8A951);
  border-color: var(--dota-gold, #C8A951);
}
.tf-cell-tag {
  width: 64rpx;
  height: 48rpx;
  border-radius: var(--radius-md);
  background: var(--card-bg-inset, #F1F3F5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-caption);
  font-weight: 800;
  color: var(--text-2);
  flex-shrink: 0;
}
.tf-cell-name {
  font-size: var(--fs-subhead);
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tf-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx var(--space-5);
  gap: var(--space-1-5);
}
.tf-empty-text { font-size: var(--fs-subhead); color: var(--text-2); font-weight: 600; }
.tf-empty-sub { font-size: var(--fs-body); color: var(--text-3); text-align: center; }
.tf-sheet-foot {
  display: flex;
  gap: var(--space-2-5);
  margin-top: var(--space-3);
}
.tf-btn {
  flex: 1;
  height: 84rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-emphasis);
  font-weight: 700;
}
.tf-btn--cancel {
  background: var(--card-bg-inset, #F1F3F5);
  color: var(--text-2);
}
.tf-btn--confirm {
  background: var(--dota-gold, #C8A951);
  color: #1F2937;
}

/* ===== 首页「我的关注」横向卡片流（spec C.2.1）===== */
.follow-flow {
  margin: var(--space-2-5) 0 var(--space-0-5);
}
.ff-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-0-5) var(--space-1) 14rpx;
}
.ff-title {
  font-size: var(--fs-emphasis);
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: 0.5rpx;
}
.ff-more {
  font-size: var(--fs-display);
  color: var(--text-3);
  line-height: 1;
}
.ff-scroll {
  width: 100%;
  white-space: nowrap;
}
.ff-track {
  display: inline-flex;
  gap: 18rpx;
  padding: var(--space-0-5) var(--space-1) var(--space-1-5);
}
.ff-card {
  position: relative;
  overflow: hidden;
  display: inline-flex;
  flex-direction: column;
  width: 300rpx;
  padding: var(--space-2-5) 22rpx var(--space-2-5) 30rpx;
  background: var(--card-bg, #FFFFFF);
  border: 1rpx solid var(--td-border-level-1-color, #E5E7EB);
  border-radius: var(--radius-lg);
  box-shadow: var(--card-inner-shadow);
}
.ff-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6rpx;
  background: var(--td-border-level-1-color, #E5E7EB);
}
.ff-card.tier-sss::before { background: var(--tier-sss); }
.ff-card.tier-s::before { background: var(--tier-s); }
.ff-card.tier-a::before { background: var(--tier-a); }
.ff-card.tier-b::before { background: var(--tier-b); }
.ff-card-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.ff-tier {
  font-size: var(--fs-micro);
  font-weight: 700;
  color: #1F2937;
  background: var(--dota-gold, #C8A951);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.ff-league {
  font-size: var(--fs-body);
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ff-vs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  margin-bottom: 14rpx;
}
.ff-team {
  font-size: var(--fs-emphasis);
  font-weight: 800;
  color: var(--text-1);
  max-width: 110rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ff-team.win { color: var(--h2h-a, #2DD4A7); }
.ff-vs-sym {
  font-size: var(--fs-caption);
  color: var(--text-3);
  font-weight: 700;
}
.ff-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}
.ff-cd {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--dota-gold, #C8A951);
  font-family: var(--font-numeric, sans-serif);
  letter-spacing: 0.5rpx;
}
.ff-ended {
  font-size: var(--fs-caption);
  font-weight: 700;
}
.ff-ended.win { color: var(--h2h-a, #2DD4A7); }
.ff-ended.lose { color: var(--h2h-b, #F25C54); }
.ff-date {
  font-size: var(--fs-micro);
  color: var(--text-3);
  flex-shrink: 0;
}
.ff-skeleton-row {
  display: flex;
  gap: 18rpx;
  padding: var(--space-0-5) var(--space-1) var(--space-1-5);
}
.ff-skeleton-card {
  width: 300rpx;
  height: 168rpx;
  border-radius: var(--radius-lg);
  background: var(--card-bg-elevated, #F1F3F5);
  flex-shrink: 0;
}
.ff-empty {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: var(--space-3-5) var(--space-2);
  background: var(--card-bg, #FFFFFF);
  border-radius: var(--radius-lg);
  border: 1rpx dashed var(--td-border-level-1-color, #E5E7EB);
}
.ff-empty-text { font-size: var(--fs-label); color: var(--text-2); font-weight: 600; }
.ff-empty-sub { font-size: var(--fs-caption); color: var(--text-3); }

/* 未关注态引导卡 */
.follow-guide {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: var(--space-2-5) 0 var(--space-0-5);
  padding: 22rpx var(--space-3);
  background: linear-gradient(135deg, rgba(200,169,81,0.10), rgba(200,169,81,0.03));
  border: 1rpx solid rgba(200,169,81,0.28);
  border-radius: var(--radius-lg);
}
.fg-icon { font-size: var(--fs-mega); }
.fg-text { flex: 1; display: flex; flex-direction: column; gap: var(--space-0-5); }
.fg-title { font-size: var(--fs-subhead); font-weight: 700; color: var(--text-1); }
.fg-sub { font-size: var(--fs-caption); color: var(--text-2); }
.fg-btn {
  padding: var(--space-1-5) var(--space-3-5);
  background: var(--dota-gold, #C8A951);
  color: #1F2937;
  font-size: var(--fs-label);
  font-weight: 700;
  border-radius: var(--radius-pill);
}

/* 批次3（2026-08-30）· PRD §10.3：周轴视图样式（view-mode-bar/vm-chip/wk-*）已移除，
   时间轴浏览由新首页周日历承接。 */

/* ====================== B 版 · 顶部工具条（覆盖全局 .filter-bar） ====================== */
/* 原 4 行筛选 → 1 行：状态 chips 横向滚动 + 「筛选」按钮靠右 */
.filter-bar {
  display: flex;
  align-items: center;
  gap: var(--space-1-5);
  margin-bottom: var(--space-2);
}
.filter-bar .chip-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}
.filter-bar .chip-group {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1-5);
}
/* 覆盖全局 .filter-bar .chip 的 flex:1（横向滚动下应为内容宽度） */
.filter-bar .chip-group .chip {
  flex: 0 0 auto;
  padding: 14rpx 26rpx;
}
.filter-toggle {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 22rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(255,255,255,0.10);
  border-radius: var(--radius-md);
  color: var(--text-2);
  font-size: var(--fs-label);
}
.filter-toggle--active {
  border-color: rgba(200,169,81,0.5);
  background: rgba(200,169,81,0.12);
  color: var(--text-1);
}
.ft-text { font-weight: 600; }
.filter-badge {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 var(--space-1);
  border-radius: var(--radius-pill);
  background: var(--dota-gold, #C8A951);
  color: #1F2937;
  font-size: var(--fs-micro);
  font-weight: 800;
  line-height: 30rpx;
  text-align: center;
}

/* ====================== B-1 筛选抽屉（雾峰雪 v2.0）====================== */
.fp-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.40);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.fp-sheet {
  width: 100%;
  max-height: 80vh;
  background: var(--card-bg, #FFFFFF);
  border-radius: 28rpx 28rpx 0 0;
  padding: var(--space-3-5) var(--space-3-5) calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.04);
}
.fp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-1);
}
.fp-title { font-size: var(--fs-heading); font-weight: 700; color: var(--text-1); }
.fp-reset { font-size: var(--fs-label); color: var(--dota-gold, #C8A951); }
.fp-section {
  padding: var(--space-2-5) 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}
.fp-label {
  display: block;
  font-size: var(--fs-body);
  color: var(--text-2);
  margin-bottom: 14rpx;
  font-weight: 600;
}
.gc-row {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}
/* 抽屉内等级芯片：复用 .gc 视觉，缩窄高度适配抽屉 */
.fp-section .gc {
  height: 58rpx;
  padding: 0 var(--space-3);
}
.seg-row {
  display: flex;
  gap: 14rpx;
}
.seg {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  flex: 1;
  padding: var(--space-2) 0;
  border-radius: var(--radius-lg);
  background: #FFFFFF;
  border: 1rpx solid rgba(255,255,255,0.08);
  color: var(--text-2);
  font-size: var(--fs-label);
}
.seg--active {
  background: rgba(200,169,81,0.16);
  border-color: rgba(200,169,81,0.5);
  color: var(--text-1);
}
.tf-hint {
  display: block;
  margin-top: var(--space-1-5);
  font-size: var(--fs-caption);
  color: var(--text-3);
}
.fp-foot { margin-top: var(--space-3); }
.fp-btn {
  height: 84rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-emphasis);
  font-weight: 700;
}
.fp-btn--confirm {
  background: var(--dota-gold, #C8A951);
  color: #1F2937;
}

/* ====================== B-2 列表表格化（压缩密度） ====================== */
.league-item {
  padding: 18rpx var(--space-2-5) 18rpx var(--space-3-5);
  margin-bottom: var(--space-1-5);
}
.league-sub { margin-top: 6rpx; }
.league-countdown { margin-top: 6rpx; }
/* 来源并入 sub 行，避免独立一行 */
.src-inline {
  margin-left: var(--space-1);
  padding-left: 10rpx;
  border-left: 1rpx solid rgba(255,255,255,0.12);
  font-size: var(--fs-micro);
  color: var(--text-3);
}
.src-curation { color: #C8A951; }
.src-liquipedia { color: #9bb0c9; }
.src-stratz { color: #5fd3a8; }
.src-opendota { color: var(--text-2); }
