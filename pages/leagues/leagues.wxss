.container { padding: 24rpx; }
/* .with-tab-bar 底部 padding 已在 app.wxss 全局抬到 160rpx（2026-07-29 修复 teams/follow 底部被 tabBar 遮挡），
   leagues 此处不再覆写。 */

/* 底部 spacer：配合 with-tab-bar 留出自定义 tabBar 区域 */
.bottom-spacer {
  height: 24rpx;
}

.skeleton-wrap { margin-bottom: 24rpx; }

.league-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
  background: #161b22;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 24rpx 32rpx;
  margin-bottom: 16rpx;
}
/* 左侧等级彩条 */
.league-item::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6rpx;
}
.tier-sss::before { background: var(--tier-sss); }
.tier-s::before { background: var(--tier-s); }
.tier-a::before { background: var(--tier-a); }
.tier-b::before { background: var(--tier-b); }
.tier-c::before { background: var(--tier-c); }

.league-main { flex: 1; min-width: 0; }

.league-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
}
.league-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #f0f3f6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.league-badges {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.league-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.league-meta .src { font-size: 22rpx; }

/* 状态徽标 */
.status-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid;
  line-height: 1.6;
}

/* 第二行 */
.league-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
}
.date-range { color: #9bb0c9; }

/* 即将到来：倒计时高亮 */
.league-countdown {
  margin-top: 8rpx;
  display: inline-flex;
  align-items: center;
  background: rgba(95, 211, 95, 0.10);
  border: 1rpx solid rgba(95, 211, 95, 0.3);
  border-radius: var(--radius-pill, 999rpx);
  padding: 4rpx 16rpx;
}
.countdown-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #5fd35f;
  letter-spacing: 0.5rpx;
}

/* 来源徽标行 */
.league-source-row {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 底部新鲜度 */
.fresh-bottom {
  text-align: center;
  padding: 16rpx 0 8rpx;
}

.star-btn { padding: 8rpx 0 8rpx 16rpx; }

.more-btn { width: 100%; }
.loadmore { display: flex; justify-content: center; margin: 24rpx 0 8rpx; }

/* 即将到来懒加载进度 */
.progress-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}
.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #232a33;
  border-top-color: #5fd35f;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 24rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.progress-text { font-size: 28rpx; color: #e6edf3; margin-bottom: 12rpx; }
.progress-tip { font-size: 22rpx; color: #6b7280; text-align: center; }

/* 即将到来为空且 STRATZ 未启用时的引导卡片 */
.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx 60rpx;
}
.hint-card {
  width: 100%;
  margin-top: 24rpx;
  padding: 32rpx 28rpx;
  background: #1b222c;
  border: 1rpx solid #2d3744;
  border-left: 6rpx solid #ffcf5c;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.hint-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffcf5c;
  margin-bottom: 16rpx;
}
.hint-desc {
  font-size: 26rpx;
  color: #9aa4b2;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.hint-step {
  font-size: 24rpx;
  color: #7d8794;
  line-height: 1.7;
  margin-top: 10rpx;
}
.hint-code {
  font-family: monospace;
  color: #5fd3a8;
  background: #0f141b;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

/* ===== 等级筛选条（第二行）· 品牌色渐变芯片 ===== */
.grade-bar {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}
/* 芯片基础：暗底 + 细边框 + 品牌色描边 */
.gc {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  font-size: 0;
  background: #161b22;
  border: 1.5rpx solid #2d3748;
  cursor: pointer;
  overflow: hidden;
  transition:
    transform 0.20s cubic-bezier(.25,.46,.45,.94),
    border-color 0.22s ease,
    box-shadow   0.22s ease,
    background   0.25s ease;
}
/* hover 微缩放反馈 */
.gc:active {
  transform: scale(0.95);
}
/* 标签文字 */
.gc__label {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #8b949e;
  transition: color 0.22s ease, text-shadow 0.22s ease;
  line-height: 1;
}

/* ── 各等级默认态（未选中）：淡品牌色边框 + 淡文字 ── */
.gc--all   { border-color: #3d4a5c; }
.gc--sss   { border-color: var(--tier-sss-line); }
.gc--s     { border-color: var(--tier-s-line); }
.gc--a     { border-color: var(--tier-a-line); }
.gc--b     { border-color: var(--tier-b-line); }

.gc--sss .gc__label { color: var(--tier-sss); }
.gc--s   .gc__label { color: var(--tier-s); }
.gc--a   .gc__label { color: var(--tier-a); }
.gc--b   .gc__label { color: var(--tier-b); }

/* ── 选中态：渐变背景 + 发光阴影 + 白/深色高对比文字 ── */
.gc--active {
  border-color: transparent;
  box-shadow:
    0 4rpx 16rpx rgba(0,0,0,.30),
    0 0 20rpx var(--gc-glow, rgba(255,255,255,.08));
  transform: translateY(-2rpx);
}
.gc--active:active {
  transform: scale(0.97) translateY(0);
}

/* ALL 选中：中性亮灰 */
.gc--all.gc--active {
  background: linear-gradient(135deg, #3d4a5c 0%, #2d3748 100%);
  box-shadow:
    0 4rpx 16rpx rgba(0,0,0,.30),
    0 0 18rpx rgba(100,120,150,.15);
}
.gc--all.gc--active .gc__label {
  color: #e6edf3;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,.35);
}

/* SSS 选中：金琥珀渐变 */
.gc--sss.gc--active {
  --gc-glow: rgba(255,207,92,.28);
  background: linear-gradient(135deg, #ffcf5c 0%, #f0a020 100%);
  box-shadow:
    0 4rpx 18rpx rgba(255,160,32,.38),
    0 0 24rpx rgba(255,207,92,.22);
}
.gc--sss.gc--active .gc__label {
  color: #1a1400;
  text-shadow: 0 1rpx 2rpx rgba(255,207,92,.5);
}

/* S 选中：翠绿渐变 */
.gc--s.gc--active {
  --gc-glow: rgba(95,211,95,.28);
  background: linear-gradient(135deg, #5fd35f 0%, #2ecc71 100%);
  box-shadow:
    0 4rpx 18rpx rgba(46,204,113,.38),
    0 0 24rpx rgba(95,211,95,.22);
}
.gc--s.gc--active .gc__label {
  color: #0a1f0a;
  text-shadow: 0 1rpx 2rpx rgba(95,211,95,.5);
}

/* A 选中：橙金渐变 */
.gc--a.gc--active {
  --gc-glow: rgba(240,170,40,.28);
  background: linear-gradient(135deg, #f0aa28 0%, #e67e22 100%);
  box-shadow:
    0 4rpx 18rpx rgba(230,126,34,.38),
    0 0 24rpx rgba(240,170,40,.22);
}
.gc--a.gc--active .gc__label {
  color: #1a0f00;
  text-shadow: 0 1rpx 2rpx rgba(240,170,40,.5);
}

/* B 选中：钢蓝渐变 */
.gc--b.gc--active {
  --gc-glow: rgba(155,176,201,.28);
  background: linear-gradient(135deg, #9bb0c9 0%, #7f8fa4 100%);
  box-shadow:
    0 4rpx 18rpx rgba(127,143,164,.38),
    0 0 24rpx rgba(155,176,201,.22);
}
.gc--b.gc--active .gc__label {
  color: #0d1117;
  text-shadow: 0 1rpx 2rpx rgba(155,176,201,.5);
}

/* 来源高亮徽标（Valve 官方 / 顶级第三方） */
.hl-badge {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  line-height: 1.6;
  font-weight: 600;
  flex-shrink: 0;
}
.hl-valve { color: #ffcf5c; background: rgba(255, 207, 92, 0.12); border: 1rpx solid rgba(255, 207, 92, 0.4); }
.hl-tp    { color: #5fd3ff; background: rgba(95, 211, 255, 0.12); border: 1rpx solid rgba(95, 211, 255, 0.4); }

/* 已停办徽标（灰） */
.defunct-tag { color: #8a8f99 !important; border-color: #5b626d !important; background: rgba(91, 98, 109, 0.10); }

/* 已停办赛事归档区 */
.archive-block { margin-top: 24rpx; }
.archive-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 4rpx 16rpx;
}
.archive-title { font-size: 26rpx; font-weight: 600; color: #8a8f99; }
.archive-count {
  font-size: 20rpx;
  color: #0e1116;
  background: #8a8f99;
  border-radius: 999rpx;
  padding: 0 12rpx;
}
/* 归档项整体置灰 */
.league-item.is-defunct { opacity: 0.62; }
.league-item.is-defunct .league-name { color: #aeb6c2; }

/* ===== 焦点卡：重点运营节点（TI15 2026 上海） ===== */
.focus-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 28rpx 28rpx 26rpx;
  border-radius: 20rpx;
  background:
    radial-gradient(120% 140% at 0% 0%, rgba(255,207,92,0.16) 0%, rgba(255,207,92,0) 55%),
    linear-gradient(135deg, #1c2230 0%, #11161d 100%);
  border: 1.5rpx solid rgba(255,207,92,0.45);
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,.32), 0 0 24rpx rgba(255,207,92,.12);
}
.focus-glow {
  position: absolute;
  top: -60rpx; right: -60rpx;
  width: 220rpx; height: 220rpx;
  background: radial-gradient(circle, rgba(255,207,92,0.30) 0%, rgba(255,207,92,0) 70%);
  pointer-events: none;
}
.focus-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.focus-badges { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.focus-valve {
  font-size: 20rpx; font-weight: 700;
  color: #1a1400; background: linear-gradient(135deg, #ffcf5c, #f0a020);
  padding: 3rpx 12rpx; border-radius: 6rpx;
}
.focus-flag {
  font-size: 20rpx; font-weight: 600;
  color: #ffcf5c; border: 1rpx solid rgba(255,207,92,0.5);
  padding: 2rpx 10rpx; border-radius: 6rpx;
}
.focus-live {
  font-size: 20rpx; font-weight: 700; color: #ff5b5b;
  background: rgba(255,91,91,0.12); border: 1rpx solid rgba(255,91,91,0.45);
  padding: 2rpx 10rpx; border-radius: 6rpx;
}
.focus-star { padding: 0 0 0 16rpx; }
.focus-title {
  margin-top: 18rpx;
  font-size: 40rpx; font-weight: 800; color: #ffcf5c;
  letter-spacing: 0.5rpx;
  text-shadow: 0 2rpx 8rpx rgba(255,207,92,.18);
}
.focus-sub {
  margin-top: 6rpx;
  font-size: 24rpx; color: #c3ccd9;
}
.focus-meta {
  margin-top: 14rpx;
  display: flex; align-items: center; gap: 14rpx; flex-wrap: wrap;
}
.focus-date { font-size: 24rpx; color: #9bb0c9; }
.focus-prize {
  font-size: 22rpx; font-weight: 600; color: #5fd3a8;
  background: rgba(95,211,168,0.10); border: 1rpx solid rgba(95,211,168,0.35);
  padding: 2rpx 12rpx; border-radius: 6rpx;
}
.focus-countdown {
  margin-top: 18rpx;
  display: inline-flex; align-items: baseline; gap: 8rpx;
  background: rgba(255,207,92,0.10);
  border: 1rpx solid rgba(255,207,92,0.35);
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}
.cd-num { font-size: 40rpx; font-weight: 800; color: #ffcf5c; line-height: 1; }
.cd-unit { font-size: 24rpx; color: #e6c97a; }
.focus-countdown--live { background: rgba(255,91,91,0.12); border-color: rgba(255,91,91,0.45); }
.cd-live { font-size: 28rpx; font-weight: 700; color: #ff7b7b; }
.focus-cta {
  margin-top: 18rpx;
  font-size: 24rpx; color: #8b95a4;
  letter-spacing: 0.5rpx;
}

/* 进行中态：红金边框，突出直播氛围 */
.focus-card--live {
  border-color: rgba(255,91,91,0.50);
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,.32), 0 0 24rpx rgba(255,91,91,.14);
}

/* ===== 战队筛选入口（spec A）===== */
.team-filter-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 4rpx 4rpx;
}
.team-filter-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 22rpx;
  background: var(--card-bg, #161b22);
  border: 1rpx solid var(--td-border-level-1-color, #232a33);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #c3ccd9;
}
.team-filter-btn--active {
  color: var(--dota-gold, #C8A951);
  border-color: rgba(200,169,81,0.5);
  background: rgba(200,169,81,0.10);
}
.tf-label { font-weight: 600; }
.tf-badge {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--dota-gold, #C8A951);
  color: #0e1116;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 30rpx;
  text-align: center;
}
.team-clear {
  font-size: 24rpx;
  color: #ff7b7b;
}
.team-hint {
  font-size: 22rpx;
  color: #6b7280;
}

/* ===== 战队筛选弹层（spec A）===== */
.tf-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.tf-sheet {
  width: 100%;
  max-height: 78vh;
  background: var(--card-bg, #161b22);
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,.4);
}
.tf-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.tf-sheet-title { font-size: 30rpx; font-weight: 700; color: #f0f3f6; }
.tf-sheet-tools { display: flex; gap: 24rpx; }
.tf-tool { font-size: 26rpx; color: var(--dota-gold, #C8A951); }
.tf-list {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.tf-cell {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 12rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}
.tf-cell--checked { background: rgba(200,169,81,0.06); }
.tf-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid #3a424d;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.tf-check--on {
  background: var(--dota-gold, #C8A951);
  border-color: var(--dota-gold, #C8A951);
}
.tf-cell-tag {
  width: 64rpx;
  height: 48rpx;
  border-radius: 10rpx;
  background: var(--card-bg-inset, #0f141b);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  color: #9aa4b2;
  flex-shrink: 0;
}
.tf-cell-name {
  font-size: 28rpx;
  color: #e6ebf2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tf-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  gap: 12rpx;
}
.tf-empty-text { font-size: 28rpx; color: #c3ccd9; font-weight: 600; }
.tf-empty-sub { font-size: 24rpx; color: #6b7280; text-align: center; }
.tf-sheet-foot {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.tf-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}
.tf-btn--cancel {
  background: var(--card-bg-inset, #0f141b);
  color: #9aa4b2;
}
.tf-btn--confirm {
  background: var(--dota-gold, #C8A951);
  color: #0e1116;
}

/* ===== 首页「我的关注」横向卡片流（spec C.2.1）===== */
.follow-flow {
  margin: 20rpx 0 4rpx;
}
.ff-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 8rpx 14rpx;
}
.ff-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f0f3f6;
  letter-spacing: 0.5rpx;
}
.ff-more {
  font-size: 36rpx;
  color: #6b7280;
  line-height: 1;
}
.ff-scroll {
  width: 100%;
  white-space: nowrap;
}
.ff-track {
  display: inline-flex;
  gap: 18rpx;
  padding: 4rpx 8rpx 12rpx;
}
.ff-card {
  position: relative;
  overflow: hidden;
  display: inline-flex;
  flex-direction: column;
  width: 300rpx;
  padding: 20rpx 22rpx 20rpx 30rpx;
  background: var(--card-bg, #161b22);
  border: 1rpx solid var(--td-border-level-1-color, #232a33);
  border-radius: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.22);
}
.ff-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6rpx;
  background: var(--td-border-level-1-color, #232a33);
}
.ff-card.tier-sss::before { background: var(--tier-sss); }
.ff-card.tier-s::before { background: var(--tier-s); }
.ff-card.tier-a::before { background: var(--tier-a); }
.ff-card.tier-b::before { background: var(--tier-b); }
.ff-card-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.ff-tier {
  font-size: 20rpx;
  font-weight: 700;
  color: #0e1116;
  background: var(--dota-gold, #C8A951);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.ff-league {
  font-size: 24rpx;
  color: #9aa4b2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ff-vs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.ff-team {
  font-size: 30rpx;
  font-weight: 800;
  color: #e6ebf2;
  max-width: 110rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ff-team.win { color: var(--h2h-a, #2DD4A7); }
.ff-vs-sym {
  font-size: 22rpx;
  color: #6b7280;
  font-weight: 700;
}
.ff-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}
.ff-cd {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--dota-gold, #C8A951);
  font-family: var(--font-numeric, sans-serif);
  letter-spacing: 0.5rpx;
}
.ff-ended {
  font-size: 22rpx;
  font-weight: 700;
}
.ff-ended.win { color: var(--h2h-a, #2DD4A7); }
.ff-ended.lose { color: var(--h2h-b, #F25C54); }
.ff-date {
  font-size: 20rpx;
  color: #6b7280;
  flex-shrink: 0;
}
.ff-skeleton-row {
  display: flex;
  gap: 18rpx;
  padding: 4rpx 8rpx 12rpx;
}
.ff-skeleton-card {
  width: 300rpx;
  height: 168rpx;
  border-radius: 18rpx;
  background: var(--card-bg-elevated, #1c232c);
  flex-shrink: 0;
}
.ff-empty {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 28rpx 16rpx;
  background: var(--card-bg, #161b22);
  border-radius: 16rpx;
  border: 1rpx dashed var(--td-border-level-1-color, #232a33);
}
.ff-empty-text { font-size: 26rpx; color: #c3ccd9; font-weight: 600; }
.ff-empty-sub { font-size: 22rpx; color: #6b7280; }

/* 未关注态引导卡 */
.follow-guide {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 20rpx 0 4rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(135deg, rgba(200,169,81,0.10), rgba(200,169,81,0.03));
  border: 1rpx solid rgba(200,169,81,0.28);
  border-radius: 18rpx;
}
.fg-icon { font-size: 44rpx; }
.fg-text { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.fg-title { font-size: 28rpx; font-weight: 700; color: #f0f3f6; }
.fg-sub { font-size: 22rpx; color: #9aa4b2; }
.fg-btn {
  padding: 12rpx 28rpx;
  background: var(--dota-gold, #C8A951);
  color: #0e1116;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 999rpx;
}

/* ===== 1.2 视图切换 + 周轴视图 ===== */
.view-mode-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 4rpx 8rpx;
}
.vm-spacer { flex: 1; }
.vm-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 0 0 auto;
  justify-content: center;
  padding: 14rpx 22rpx;
  border-radius: 14rpx;
  background: #161b22;
  border: 1rpx solid rgba(255,255,255,0.08);
  color: #9aa4b2;
  font-size: 26rpx;
}
.vm-chip--active {
  background: rgba(200,169,81,0.16);
  border-color: rgba(200,169,81,0.5);
  color: #e8eef6;
}
.wk-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 8rpx;
}
.wk-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  flex-wrap: nowrap;
  width: max-content;
  padding-bottom: 8rpx;
}
.wk-col {
  display: inline-flex;
  flex-direction: column;
  flex-shrink: 0;
  width: 300rpx;
  margin-right: 16rpx;
  background: #161b22;
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 16rpx;
  padding: 12rpx;
  vertical-align: top;
}
.wk-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 8rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
}
.wk-label {
  font-size: 22rpx;
  color: #c9d1d9;
  font-weight: 600;
}
.wk-count {
  font-size: 20rpx;
  color: #C8A951;
  background: rgba(200,169,81,0.14);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}
.wk-item {
  padding: 10rpx 8rpx;
  border-left: 4rpx solid transparent;
  border-radius: 8rpx;
}
.wk-item:nth-child(even) { background: rgba(255,255,255,0.02); }
.wk-item-name {
  display: block;
  font-size: 24rpx;
  color: #e8eef6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wk-item-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 4rpx;
}
.wk-tag {
  font-size: 18rpx;
  color: #8a8f99;
}
.wk-date {
  font-size: 18rpx;
  color: #6b7280;
}

/* ====================== B 版 · 顶部工具条（覆盖全局 .filter-bar） ====================== */
/* 原 4 行筛选 → 1 行：状态 chips 横向滚动 + 「筛选」按钮靠右 */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.filter-bar .chip-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}
.filter-bar .chip-group {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}
/* 覆盖全局 .filter-bar .chip 的 flex:1（横向滚动下应为内容宽度） */
.filter-bar .chip-group .chip {
  flex: 0 0 auto;
  padding: 14rpx 26rpx;
}
.filter-toggle {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 22rpx;
  background: #161b22;
  border: 1rpx solid rgba(255,255,255,0.10);
  border-radius: 12rpx;
  color: #c3ccd9;
  font-size: 26rpx;
}
.filter-toggle--active {
  border-color: rgba(200,169,81,0.5);
  background: rgba(200,169,81,0.12);
  color: #e8eef6;
}
.ft-text { font-weight: 600; }
.filter-badge {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--dota-gold, #C8A951);
  color: #0e1116;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 30rpx;
  text-align: center;
}

/* ====================== B-1 筛选抽屉 ====================== */
.fp-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.fp-sheet {
  width: 100%;
  max-height: 80vh;
  background: var(--card-bg, #161b22);
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,.4);
}
.fp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.fp-title { font-size: 32rpx; font-weight: 700; color: #f0f3f6; }
.fp-reset { font-size: 26rpx; color: var(--dota-gold, #C8A951); }
.fp-section {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}
.fp-label {
  display: block;
  font-size: 24rpx;
  color: #8a8f99;
  margin-bottom: 14rpx;
  font-weight: 600;
}
.gc-row {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}
/* 抽屉内等级芯片：复用 .gc 视觉，缩窄高度适配抽屉 */
.fp-section .gc {
  height: 58rpx;
  padding: 0 24rpx;
}
.seg-row {
  display: flex;
  gap: 14rpx;
}
.seg {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 1;
  padding: 16rpx 0;
  border-radius: 14rpx;
  background: #161b22;
  border: 1rpx solid rgba(255,255,255,0.08);
  color: #9aa4b2;
  font-size: 26rpx;
}
.seg--active {
  background: rgba(200,169,81,0.16);
  border-color: rgba(200,169,81,0.5);
  color: #e8eef6;
}
.tf-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6b7280;
}
.fp-foot { margin-top: 24rpx; }
.fp-btn {
  height: 84rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}
.fp-btn--confirm {
  background: var(--dota-gold, #C8A951);
  color: #0e1116;
}

/* ====================== B-2 列表表格化（压缩密度） ====================== */
.league-item {
  padding: 18rpx 20rpx 18rpx 28rpx;
  margin-bottom: 12rpx;
}
.league-sub { margin-top: 6rpx; }
.league-countdown { margin-top: 6rpx; }
/* 来源并入 sub 行，避免独立一行 */
.src-inline {
  margin-left: 8rpx;
  padding-left: 10rpx;
  border-left: 1rpx solid rgba(255,255,255,0.12);
  font-size: 20rpx;
  color: #6b7280;
}
.src-curation { color: #C8A951; }
.src-liquipedia { color: #9bb0c9; }
.src-stratz { color: #5fd3a8; }
.src-opendota { color: #7d8794; }
