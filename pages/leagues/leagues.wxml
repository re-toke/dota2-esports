<view class="container">
  <view class="search-wrap">
    <t-search
      value="{{keyword}}"
      placeholder="搜索赛事名称"
      bind:change="onSearch"
      bind:clear="onSearch"
    />
  </view>

  <!-- 正在直播的比赛（Steam / STRATZ，实时比分） -->
  <block wx:if="{{liveGames.length > 0}}">
    <view class="live-title">
      <text class="live-dot"></text>
      <text>直播中 · {{liveGames.length}} 场</text>
    </view>
    <view class="live-card" wx:for="{{liveGames}}" wx:key="lobbyId">
      <view class="live-row">
        <text class="live-team">{{item.radiantName}}</text>
        <text class="live-score win">{{item.radiantScore}}</text>
      </view>
      <view class="live-row">
        <text class="live-team">{{item.direName}}</text>
        <text class="live-score lose">{{item.direScore}}</text>
      </view>
      <view class="live-meta">
        <text wx:if="{{item.leagueName}}" class="muted">{{item.leagueName}} · </text>
        <text wx:if="{{item.spectators > 0}}" class="muted">{{item.spectators}} 人在看</text>
        <text wx:if="{{item.source}}" class="live-src">{{item.source}}</text>
      </view>
    </view>
  </block>

  <view class="filter-bar">
    <view class="chip {{filter==='all'?'active':''}}" data-f="all" bindtap="onFilter">全部</view>
    <view class="chip {{filter==='ongoing'?'active':''}}" data-f="ongoing" bindtap="onFilter">正在进行</view>
    <view class="chip {{filter==='upcoming'?'active':''}}" data-f="upcoming" bindtap="onFilter">即将到来</view>
    
  </view>

  <!-- 加载骨架 -->
  <block wx:if="{{loading}}">
    <view class="skeleton-wrap" wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
      <t-skeleton theme="paragraph" loading="{{true}}" />
    </view>
  </block>

  <view wx:elif="{{error}}" class="error-block">
    <t-empty icon="info-circle" description="{{error}}" />
    <view class="retry-wrap">
      <t-button theme="primary" size="medium" bindtap="retry">重试</t-button>
    </view>
  </view>

  <!-- 即将到来懒加载进度 -->
  <block wx:elif="{{filter==='upcoming' && upcomingLoading}}">
    <view class="progress-box">
      <view class="spinner"></view>
      <text class="progress-text">{{upcomingProgress}}</text>
      <text class="progress-tip">首次查询赛程较慢，结果会缓存 24 小时</text>
    </view>
  </block>

  <!-- 即将到来为空且 STRATZ 未启用：明确告知需启用 STRATZ 才能获取赛程 -->
  <view wx:elif="{{filter==='upcoming' && list.length === 0 && !stratzEnabled}}" class="empty-hint">
    <t-empty icon="info-circle" description="无法获取即将到来的赛程数据" />
    <view class="hint-card">
      <view class="hint-title">赛程数据需要 STRATZ 支持</view>
      <view class="hint-desc">即将到来的比赛赛程主要来自 STRATZ GraphQL API，当前未启用，因此无法获取未来两个月的赛事赛程。</view>
      <view class="hint-step">在 <text class="hint-code">utils/config.js</text> 中填入 STRATZ apiKey 并设置 <text class="hint-code">enabled: true</text> 即可启用。</view>
      <view class="hint-step">免费申请 apiKey：stratz.com/api</view>
    </view>
  </view>

  <t-empty
    wx:elif="{{list.length === 0}}"
    description="{{filter==='upcoming' ? '暂无未来两个月内开赛的赛事' : '暂无符合条件的赛事'}}"
  />

  <block wx:else>
    <view
      class="league-item {{item.tierClass}}"
      wx:for="{{list}}"
      wx:key="leagueid"
      bindtap="openLeague"
      data-id="{{item.leagueid}}"
      data-name="{{item.name}}"
    >
      <view class="league-main">
        <view class="league-name">{{item.name}}</view>
        <view class="league-meta">
          <t-tag theme="{{item.tagTheme}}" variant="{{item.tagVariant}}" size="small">{{item.label}}</t-tag>
          <text class="status-tag" style="color:{{item.statusColor}};border-color:{{item.statusColor}}">{{item.statusText}}</text>
          <text class="muted src">{{item.source === 'community' ? '社区分级' : 'OpenDota'}}</text>
        </view>
        <view class="league-sub muted" wx:if="{{item.dateRange}}">
          <text class="date-range">{{item.dateRange}}</text>
          <text wx:if="{{item.matchCount}}"> · {{item.matchCount}} 场</text>
        </view>
      </view>
      <view class="star-btn" catchtap="toggleFollow" data-id="{{item.leagueid}}" data-name="{{item.name}}">
        <t-icon name="star" size="44rpx" color="{{item.followed ? '#ffcf5c' : '#5b626d'}}" />
      </view>
    </view>

    <view class="loadmore" wx:if="{{hasMore}}">
      <t-button theme="light" size="medium" bindtap="appendPage" t-class="more-btn">加载更多</t-button>
    </view>
  </block>
</view>
