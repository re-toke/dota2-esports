.container { padding: 32rpx; }
.header { margin-bottom: 32rpx; }
.header .title { font-size: 40rpx; font-weight: 700; color: #f0f3f6; display: block; margin-bottom: 8rpx; }
.header .desc { font-size: 26rpx; color: #8a8f99; }

.config-box {
  background: #1c232c;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}
.config-label { font-size: 24rpx; color: #8a8f99; font-weight: 600; text-transform: uppercase; letter-spacing: 1rpx; display: block; margin-bottom: 12rpx; }
.config-value { font-size: 26rpx; color: #c9d2dd; font-family: monospace; display: block; line-height: 1.8; }

.run-btn {
  width: 100%;
  background: #6054f1;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}
.run-btn.testing { opacity: 0.6; }
.run-btn[disabled] { opacity: 0.5; }

.results { margin-top: 16rpx; }
.results-title { font-size: 30rpx; font-weight: 600; color: #f0f3f6; display: block; margin-bottom: 16rpx; }

.result-item {
  background: #161b22;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-left: 4rpx solid #4b5563;
}
.result-item.pass { border-left-color: #5fd35f; }
.result-item.fail { border-left-color: #e8443b; }

.result-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.result-name { font-size: 28rpx; font-weight: 600; color: #f0f3f6; }
.result-status { font-size: 24rpx; font-weight: 600; }
.result-status.pass { color: #5fd35f; }
.result-status.fail { color: #e8443b; }

.result-detail { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 8rpx; }
.detail-row { font-size: 24rpx; color: #8a8f99; font-family: monospace; }

.result-summary {
  font-size: 22rpx;
  color: #6b7280;
  font-family: monospace;
  background: #0f141b;
  border-radius: 8rpx;
  padding: 12rpx;
  word-break: break-all;
  line-height: 1.6;
}
