.container { padding: 24rpx; }

/* ===== 头部 ===== */
.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
  gap: 16rpx;
}
.head-info { flex: 1; min-width: 0; }
.head-info .title {
  font-size: 36rpx;
  font-weight: 700;
  color: #f0f3f6;
  line-height: 1.3;
  font-family: var(--font-display, -apple-system, sans-serif);
}
.head-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}
.head-meta .sub { font-size: 24rpx; color: #8a8f99; }
.head-meta .status-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid;
  line-height: 1.6;
}
.star-btn { padding: 4rpx 0 4rpx 16rpx; flex-shrink: 0; }

/* ===== 数据溯源合并区（C 风格 · 替代原 4 个独立信息条） ===== */
.source-section {
  background: var(--card-bg-elevated, #1c232c);
  border-radius: var(--radius-lg, 16rpx);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.source-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.source-section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8a8f99;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.source-section-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 可信度 pill */
.quality-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill, 999rpx);
  align-self: flex-start;
}
.quality-pill .q-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.quality-pill .q-text { font-weight: 600; }
.quality-pill .q-src { font-size: 22rpx; opacity: 0.85; }
.quality-high { background: rgba(30, 200, 150, 0.12); color: #1ec896; }
.quality-high .q-dot { background: #1ec896; }
.quality-medium { background: rgba(255, 207, 92, 0.12); color: #ffcf5c; }
.quality-medium .q-dot { background: #ffcf5c; }
.quality-low { background: rgba(107, 114, 128, 0.16); color: #9aa3ad; }
.quality-low .q-dot { background: #9aa3ad; }

/* 规范名修正 */
.name-fix {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  flex-wrap: wrap;
}
.name-fix-val { color: #5fd35f; font-weight: 600; }

/* ===== KPI Strip 局部样式（value-row 单元） ===== */
.kpi-value-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

/* ===== 比赛卡 vs-card 局部样式 ===== */
/* vs-card 默认类已在 app.wxss 定义，这里补充比赛卡占位 logo */
.vs-team-logo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #8a8f99;
  background: var(--card-bg-inset, #0f141b);
  border: 1rpx solid #232a33;
}

/* ===== 三 Tab 分段控件 ===== */
.seg {
  display: flex;
  background: var(--card-bg-inset, #0f141b);
  border-radius: var(--radius-md, 12rpx);
  padding: 4rpx;
  margin: 16rpx 0;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #8a8f99;
  border-radius: 8rpx;
  transition: background 120ms ease, color 120ms ease;
}
.seg-item.active {
  background: var(--card-bg-elevated, #1c232c);
  color: #f0f3f6;
  font-weight: 600;
}
.seg-count {
  display: inline-block;
  margin-left: 4rpx;
  font-size: 22rpx;
  opacity: 0.8;
}

/* ===== 系列赛聚合卡（A 紧凑 · B 点缀高亮） ===== */
.series-card {
  background: var(--card-bg, #161b22);
  border-radius: var(--radius-lg, 16rpx);
  margin-bottom: 16rpx;
  overflow: hidden;
  border: 1rpx solid #232a33;
}
/* B 点缀：进行中（绿色高亮 + 左边框） */
.series-card.series-live {
  border-color: rgba(95, 211, 95, 0.4);
  border-left: 4rpx solid #5fd35f;
  background: linear-gradient(180deg, rgba(95, 211, 95, 0.05), var(--card-bg, #161b22) 30%);
}
/* B 点缀：近 2h 内结束（黄色高亮 + 左边框） */
.series-card.series-recent {
  border-color: rgba(255, 207, 92, 0.35);
  border-left: 4rpx solid #ffcf5c;
}

/* 系列头部：队A · 大比分 · 队B */
.series-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 12rpx;
  gap: 12rpx;
}
.series-team {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}
.series-team.right { justify-content: flex-end; }
.series-team-logo {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--card-bg-inset, #0f141b);
  border: 1rpx solid #232a33;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #8a8f99;
  flex-shrink: 0;
}
.series-team-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #c9d2dd;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.series-team-name.win { color: #5fd35f; }
.series-team-name.draw { color: #c9d2dd; }
/* 胜方 logo 加金色边框 */
.series-team-logo.team-win {
  border-color: rgba(255, 207, 92, 0.55);
  background: rgba(255, 207, 92, 0.08);
  color: #ffcf5c;
}
.series-score {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  padding: 0 12rpx;
  position: relative;
}
.series-score-num {
  font-size: 40rpx;
  font-weight: 800;
  font-family: var(--font-mono, "SF Mono", monospace);
  font-variant-numeric: tabular-nums;
  line-height: 1;
}
.series-score-num.win { color: #5fd35f; }
.series-score-num.lose { color: #6b7280; }
.series-score-num.draw { color: #c9d2dd; }
.series-score-sep {
  color: #4b5563;
  font-size: 28rpx;
}
/* BO2 平局徽标 */
.series-draw-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #ffcf5c;
  background: rgba(255, 207, 92, 0.18);
  border: 1rpx solid rgba(255, 207, 92, 0.45);
  border-radius: var(--radius-pill, 999rpx);
  padding: 2rpx 10rpx;
  line-height: 1.4;
}
/* B 点缀：live/recent 比分放大 */
.series-live .series-score-num,
.series-recent .series-score-num {
  font-size: 48rpx;
}

/* 系列元信息行 */
.series-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx 14rpx;
  flex-wrap: wrap;
}
/* BO 标签组：主标签 + 赛制说明 */
.series-bo-group {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.series-bo-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: rgba(96, 84, 241, 0.14);
  color: #8b80ff;
  border: 1rpx solid rgba(96, 84, 241, 0.3);
  font-weight: 600;
  letter-spacing: 1rpx;
}
/* BO2 双局积分：青色（区别于淘汰赛） */
.series-bo-tag.bo-bo2 {
  background: rgba(91, 155, 255, 0.12);
  color: #5b9bff;
  border-color: rgba(91, 155, 255, 0.3);
}
/* BO5 巅峰对决：橙金色 */
.series-bo-tag.bo-bo5 {
  background: rgba(255, 165, 70, 0.12);
  color: #ffa546;
  border-color: rgba(255, 165, 70, 0.3);
}
.series-bo-label {
  font-size: 20rpx;
  color: #6b7280;
  font-weight: 500;
}
.series-live-tag {
  font-size: 22rpx;
  color: #5fd35f;
  font-weight: 700;
  animation: live-pulse 1.6s ease-in-out infinite;
}
@keyframes live-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
.series-time {
  font-size: 22rpx;
  color: #8a8f99;
  font-family: var(--font-mono, monospace);
}
.series-dots {
  display: flex;
  gap: 6rpx;
  margin-left: auto;
}
.series-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 1rpx solid #4b5563;
}
.series-dot.a-win { background: #5fd35f; border-color: #5fd35f; }
.series-dot.b-win { background: #e8443b; border-color: #e8443b; }

/* 小场列表 */
.series-games {
  border-top: 1rpx solid #232a33;
  background: var(--card-bg-inset, #131820);
}
.series-game {
  border-bottom: 1rpx solid #1c232c;
}
.series-game:last-child { border-bottom: none; }
.series-game.expanded {
  background: var(--card-bg, #161b22);
}
.series-game-main {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}
.series-game-idx {
  font-size: 20rpx;
  color: #6b7280;
  font-family: var(--font-mono, monospace);
  font-weight: 600;
  width: 40rpx;
  flex-shrink: 0;
}
.series-game-mini {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.series-game-score {
  font-size: 24rpx;
  font-weight: 700;
  font-family: var(--font-mono, monospace);
  font-variant-numeric: tabular-nums;
}
.series-game-score.win { color: #5fd35f; }
.series-game-score.lose { color: #6b7280; }
.series-game-sep {
  color: #4b5563;
  font-size: 20rpx;
}
.series-game-time {
  font-size: 22rpx;
  color: #6b7280;
  font-family: var(--font-mono, monospace);
  flex: 1;
}
.series-game-duration {
  font-size: 20rpx;
  color: #6b7280;
  font-family: var(--font-mono, monospace);
}
.series-game-expand {
  font-size: 22rpx;
  color: #5b9bff;
  flex-shrink: 0;
}
.series-game-expand-box {
  margin-top: 4rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #232a33;
}

/* ===== A 风格 · vs-card 展开态 ===== */
.vs-card-main {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.vs-expand {
  font-size: 20rpx;
  color: #6b7280;
  margin-top: 4rpx;
}
.vs-vs.win-tag { color: var(--status-ongoing, #5fd35f); }
.vs-vs.lose-tag { color: #6b7280; }
.vs-card-expand {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #232a33;
}
.expand-loading, .expand-empty {
  font-size: 24rpx;
  color: #8a8f99;
  text-align: center;
  padding: 16rpx 0;
}

/* MVP 标记 */
.mvp-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 207, 92, 0.10);
  border-radius: var(--radius-md, 12rpx);
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}
.mvp-tag {
  font-size: 22rpx;
  color: #ffcf5c;
  font-weight: 700;
  background: rgba(255, 207, 92, 0.2);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill, 999rpx);
}
.mvp-name {
  font-size: 26rpx;
  color: #f0f3f6;
  font-weight: 600;
}
.mvp-kda {
  font-size: 22rpx;
  color: #8a8f99;
  font-family: var(--font-mono, monospace);
  margin-left: auto;
}

/* 双方英雄阵容 */
.hero-lineup {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.hero-side {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.hero-side-label {
  font-size: 22rpx;
  color: #8a8f99;
  width: 120rpx;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-side.radiant .hero-side-label { color: var(--status-ongoing, #5fd35f); }
.hero-side.dire .hero-side-label { color: #e8443b; }
.hero-icons {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  flex: 1;
}
.hero-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.hero-icon-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--card-bg-inset, #0f141b);
  border: 1rpx solid #232a33;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #c9d2dd;
}
.hero-icon-kda {
  font-size: 18rpx;
  color: #6b7280;
  font-family: var(--font-mono, monospace);
}

/* 完整战报入口 */
.report-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  background: rgba(91, 155, 255, 0.08);
  border-radius: var(--radius-md, 12rpx);
  font-size: 24rpx;
  color: #5b9bff;
  font-weight: 500;
}

/* ===== Tab 2 / 3 · 数据表通用样式 ===== */
.player-table, .standings-card {
  background: var(--card-bg, #161b22);
  border-radius: var(--radius-lg, 16rpx);
  overflow: hidden;
  margin-bottom: 16rpx;
}
.table-head, .stand-head {
  display: flex;
  align-items: center;
  background: var(--card-bg-elevated, #1c232c);
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  color: #8a8f99;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}
.table-row, .stand-row {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid #232a33;
  font-size: 26rpx;
  color: #f0f3f6;
  transition: background 120ms ease;
}
.table-row:active, .stand-row:active { background: var(--card-bg-elevated, #1c232c); }
.col-rank {
  width: 80rpx;
  text-align: center;
  font-weight: 700;
  font-family: var(--font-mono, monospace);
}
.col-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 8rpx;
}
.col-num {
  width: 120rpx;
  text-align: right;
  font-family: var(--font-numeric, "SF Pro Display", sans-serif);
  font-variant-numeric: tabular-nums;
}
.kda { color: #5fd35f; font-weight: 600; }
.wr-high { color: var(--kpi-primary, #5fd35f); font-weight: 600; }
.wr-mid { color: var(--kpi-warning, #f0aa28); }
.wr-low { color: #8a8f99; }

/* 排名前三颜色 */
.rank-1 { color: #ffcf5c; }
.rank-2 { color: #c9d2dd; }
.rank-3 { color: #d99252; }

.loading-row {
  text-align: center;
  color: #8a8f99;
  font-size: 24rpx;
  padding: 24rpx 0;
}

/* ===== 通用 ===== */
.more-btn { width: 100%; }
.loadmore { display: flex; justify-content: center; margin: 24rpx 0 8rpx; }
.error-block { display: flex; flex-direction: column; align-items: center; }
.retry-wrap { margin-top: 16rpx; }

/* 兼容旧版样式（部分组件可能仍引用） */
.liq-banner {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #161b22;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}
.meta-card {
  background: #161b22;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.match-card {
  background: #161b22;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
