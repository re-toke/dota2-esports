# ============================================================
# 管理后台环境变量（阶段2-⑤：已从 云开发 迁到 Supabase）
#
# 用法：复制本文件为 .env.local，填入真实值。
#   复制命令（在当前目录执行）：
#     cmd:        copy admin\.env.local.example admin\.env.local
#     PowerShell: Copy-Item admin\.env.local.example admin\.env.local
# ⚠️ .env.local 已在 admin/.gitignore 中忽略 —— 绝不提交。
# ============================================================

# ---- Supabase ----
# anon key 是「公开密钥」，受 RLS 保护，放前端是安全的。
# 位置：Supabase Dashboard → Project Settings → API → Project API keys → anon / public
VITE_SUPABASE_URL=https://gkticzdaicpdtxheyxsd.supabase.co
VITE_SUPABASE_ANON_KEY=<粘贴 anon public key>

# ---- 管理令牌 ----
# 用于调用写入口 EF（admin-write）。必须与 EF 侧 secret ADMIN_TOKEN 完全一致。
#
# ① 生成令牌（项目根目录执行，node 已在环境里）：
#      node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ② 设到 EF：
#      supabase secrets set ADMIN_TOKEN=<同一个令牌>
# ③ 把同一个令牌填到下面：
VITE_ADMIN_TOKEN=<粘贴管理令牌>
