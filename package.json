{
  "name": "dota2-esports",
  "version": "1.2.0",
  "description": "DOTA2赛事微信小程序（TDesign 版）",
  "scripts": {
    "lint": "eslint --rulesdir scripts/eslint-rules utils/ pages/ subpackages/ scripts/ --ext .js",
    "lint:fix": "eslint --rulesdir scripts/eslint-rules utils/ pages/ subpackages/ scripts/ --ext .js --fix",
    "test": "node scripts/test/test-canonical.js && node scripts/test/test-bo.js && node scripts/test/test-lp-fetch-guard.js",
    "test:all": "node scripts/test/run-all.js",
    "sync:canon": "node scripts/sync/sync-canon-map.js",
    "sync:parse": "node scripts/sync/sync-liquipedia-parse.js",
    "sync:slugmap": "node scripts/sync/sync-slugmap.js",
    "sync:brackets": "node scripts/sync/sync-liquipedia-brackets.js",
    "prewarm:liquipedia": "node scripts/sync/prewarm-liquipedia.js",
    "fetch:upcoming": "node scripts/sync/fetch-liquipedia-upcoming.js",
    "fetch:logos": "node scripts/sync/fetch-team-logos.js",
    "privacy:extract": "node scripts/sync/extract-privacy-text.js",
    "privacy:out": "node scripts/sync/extract-privacy-text.js --out",
    "privacy:check": "node scripts/sync/extract-privacy-text.js --check",
    "purge:events": "node scripts/sync/purge-uncollectable-events.js",
    "purge:events:apply": "node scripts/sync/purge-uncollectable-events.js --apply",
    "migrate:curation": "node scripts/sync/migrate-curation-to-db.js",
    "migrate:curation:dry": "node scripts/sync/migrate-curation-to-db.js --dry-run",
    "migrate:curation:export": "node scripts/sync/migrate-curation-to-db.js --export",
    "check:syntax": "node scripts/ops/check-syntax.js",
    "coverage": "node scripts/ops/curation-coverage.js",
    "coverage:offline": "node scripts/ops/curation-coverage.js --offline",
    "prepare": "husky",
    "precommit": "node scripts/ops/check-syntax.js && npx eslint --rulesdir scripts/eslint-rules && npm test",
    "audit:colors": "node scripts/ops/audit-wxss-colors.js",
    "audit:colors:gate": "node scripts/ops/audit-wxss-colors.js --fail-on-p0",
    "tokenize:colors": "node scripts/ops/tokenize-wxss-colors.js",
    "tokenize:colors:apply": "node scripts/ops/tokenize-wxss-colors.js --apply",
    "verify:tokenize": "node scripts/ops/verify-tokenize-equivalence.js",
    "check:handlers": "node scripts/ops/check-page-handlers.js",
    "check:token-overreach": "node scripts/ops/check-token-overreach.js",
    "check:card-contract": "node scripts/ops/check-card-contract.js",
    "check:edge-actions": "node scripts/ops/check-edge-actions.js",
    "check:ef-contract": "node scripts/ops/check-ef-contract.js",
    "check:snapshot-freshness": "node scripts/ops/check-snapshot-freshness.js",
    "cleanup:cache": "node scripts/ops/cleanup-cache.js",
    "verify:lp-slugs": "node scripts/ops/verify-lp-slugs.js"
  },
  "dependencies": {
    "tdesign-miniprogram": "^1.15.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^8.57.0",
    "husky": "^9.1.0"
  }
}
