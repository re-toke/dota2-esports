.container {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* ===== 头部 ===== */
.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
  gap: 16rpx;
}
.head-info { flex: 1; min-width: 0; }
.head-info .title {
  font-size: 36rpx;
  font-weight: 700;
  color: #f0f3f6;
  line-height: 1.3;
  font-family: var(--font-display, -apple-system, sans-serif);
}
.head-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}
.head-meta .sub { font-size: 24rpx; color: #8a8f99; }
.head-meta .status-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid;
  line-height: 1.6;
}
.star-btn { padding: 4rpx 0 4rpx 16rpx; flex-shrink: 0; }

/* ===== 数据溯源合并区（C 风格 · 替代原 4 个独立信息条） ===== */
.source-section {
  background: var(--card-bg-elevated, #1c232c);
  border-radius: var(--radius-lg, 16rpx);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.source-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.source-section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8a8f99;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.source-section-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 可信度 pill */
.quality-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill, 999rpx);
  align-self: flex-start;
}
.quality-pill .q-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.quality-pill .q-text { font-weight: 600; }
.quality-pill .q-src { font-size: 22rpx; opacity: 0.85; }
.quality-high { background: rgba(30, 200, 150, 0.12); color: #1ec896; }
.quality-high .q-dot { background: #1ec896; }
.quality-medium { background: rgba(255, 207, 92, 0.12); color: #ffcf5c; }
.quality-medium .q-dot { background: #ffcf5c; }
.quality-low { background: rgba(107, 114, 128, 0.16); color: #9aa3ad; }
.quality-low .q-dot { background: #9aa3ad; }

/* 规范名修正 */
.name-fix {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  flex-wrap: wrap;
}
.name-fix-val { color: #5fd35f; font-weight: 600; }

/* ===== KPI Strip 局部样式（value-row 单元） ===== */
.kpi-value-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  flex-wrap: wrap;
}

/* ===== 比赛卡 vs-card 局部样式 ===== */
/* vs-card 默认类已在 app.wxss 定义，这里补充比赛卡占位 logo */
.vs-team-logo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #8a8f99;
  background: var(--card-bg-inset, #0f141b);
  border: 1rpx solid #232a33;
}

/* ===== 三 Tab 分段控件 ===== */
.seg {
  display: flex;
  background: var(--card-bg-inset, #0f141b);
  border-radius: var(--radius-md, 12rpx);
  padding: 4rpx;
  margin: 16rpx 0;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #8a8f99;
  border-radius: 8rpx;
  transition: background 120ms ease, color 120ms ease;
}
.seg-item.active {
  background: var(--card-bg-elevated, #1c232c);
  color: #f0f3f6;
  font-weight: 600;
}
.seg-count {
  display: inline-block;
  margin-left: 4rpx;
  font-size: 22rpx;
  opacity: 0.8;
}

/* ===== 系列赛聚合卡（A 紧凑 · B 点缀高亮） ===== */
.series-card {
  background: var(--card-bg, #161b22);
  border-radius: var(--radius-lg, 16rpx);
  margin-bottom: 16rpx;
  overflow: hidden;
  border: 1rpx solid #232a33;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  transition: border-color 200ms ease, box-shadow 200ms ease;
}
/* B 点缀：进行中（绿色高亮 + 左边框 + 呼吸光效） */
.series-card.series-live {
  border-color: rgba(95, 211, 95, 0.4);
  border-left: 4rpx solid #5fd35f;
  background: linear-gradient(180deg, rgba(95, 211, 95, 0.06), var(--card-bg, #161b22) 40%);
  box-shadow: 0 2rpx 12rpx rgba(95, 211, 95, 0.12);
}
/* B 点缀：近 2h 内结束（黄色高亮 + 左边框） */
.series-card.series-recent {
  border-color: rgba(255, 207, 92, 0.35);
  border-left: 4rpx solid #ffcf5c;
  box-shadow: 0 2rpx 10rpx rgba(255, 207, 92, 0.08);
}

/* 系列头部：队A · 大比分 · 队B */
.series-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 14rpx;
  gap: 12rpx;
}
.series-team {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.series-team.right { justify-content: flex-end; }
.series-team-logo {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--card-bg-inset, #0f141b);
  border: 1rpx solid #2a323d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #8a8f99;
  flex-shrink: 0;
  overflow: hidden;  /* ★ 新增：让 <image> 被裁剪到圆角内 */
  transition: border-color 200ms ease, background 200ms ease;
}
.series-team-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #d4dce6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
}
.series-team-name.win { color: #5fd35f; }
.series-team-name.draw { color: #d4dce6; }
/* 胜方 logo 加金色边框 + 微妙光效 */
.series-team-logo.team-win {
  border-color: rgba(255, 207, 92, 0.6);
  background: linear-gradient(135deg, rgba(255, 207, 92, 0.12), rgba(255, 207, 92, 0.04));
  color: #ffcf5c;
  box-shadow: 0 0 8rpx rgba(255, 207, 92, 0.2);
}
.series-score {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 4rpx 16rpx;
  position: relative;
  background: var(--card-bg-inset, #0f141b);
  border-radius: var(--radius-md, 12rpx);
  border: 1rpx solid #1f262f;
}
.series-score-num {
  font-size: 44rpx;
  font-weight: 800;
  font-family: var(--font-mono, "SF Mono", "JetBrains Mono", monospace);
  font-variant-numeric: tabular-nums;
  line-height: 1;
  letter-spacing: -1rpx;
}
.series-score-num.win { color: #5fd35f; }
.series-score-num.lose { color: #5b626d; }
.series-score-num.draw { color: #d4dce6; }
.series-score-sep {
  color: #3a4250;
  font-size: 28rpx;
  font-weight: 400;
}
/* BO2 平局徽标 */
.series-draw-badge {
  position: absolute;
  top: -10rpx;
  right: -12rpx;
  font-size: 16rpx;
  font-weight: 700;
  color: #ffcf5c;
  background: rgba(255, 207, 92, 0.2);
  border: 1rpx solid rgba(255, 207, 92, 0.5);
  border-radius: var(--radius-pill, 999rpx);
  padding: 2rpx 10rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
}
/* B 点缀：live/recent 比分放大 */
.series-live .series-score-num,
.series-recent .series-score-num {
  font-size: 52rpx;
}
.series-live .series-score {
  border-color: rgba(95, 211, 95, 0.3);
  background: rgba(95, 211, 95, 0.04);
}
.series-recent .series-score {
  border-color: rgba(255, 207, 92, 0.25);
}

/* 系列元信息行 */
.series-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx 16rpx;
  flex-wrap: wrap;
}
/* BO 标签组：主标签 + 赛制说明 */
.series-bo-group {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.series-bo-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: rgba(96, 84, 241, 0.14);
  color: #8b80ff;
  border: 1rpx solid rgba(96, 84, 241, 0.3);
  font-weight: 700;
  letter-spacing: 1.5rpx;
}
/* BO2 双局积分：青色（区别于淘汰赛） */
.series-bo-tag.bo-bo2 {
  background: rgba(91, 155, 255, 0.12);
  color: #5b9bff;
  border-color: rgba(91, 155, 255, 0.35);
}
/* BO5 巅峰对决：橙金色 */
.series-bo-tag.bo-bo5 {
  background: rgba(255, 165, 70, 0.12);
  color: #ffa546;
  border-color: rgba(255, 165, 70, 0.35);
}
.series-bo-label {
  font-size: 20rpx;
  color: #5b626d;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}
.series-live-tag {
  font-size: 22rpx;
  color: #5fd35f;
  font-weight: 700;
  letter-spacing: 1rpx;
  animation: live-pulse 1.6s ease-in-out infinite;
}
@keyframes live-pulse {
  0%, 100% { opacity: 1; text-shadow: 0 0 4rpx rgba(95, 211, 95, 0.6); }
  50% { opacity: 0.6; text-shadow: 0 0 2rpx rgba(95, 211, 95, 0.3); }
}
.series-time {
  font-size: 22rpx;
  color: #5b626d;
  font-family: var(--font-mono, monospace);
  letter-spacing: 0.5rpx;
}
.series-dots {
  display: flex;
  gap: 6rpx;
  margin-left: auto;
}
.series-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 1rpx solid #3a4250;
  background: transparent;
}
.series-dot.a-win { background: #5fd35f; border-color: #5fd35f; box-shadow: 0 0 4rpx rgba(95, 211, 95, 0.4); }
.series-dot.b-win { background: #e8443b; border-color: #e8443b; box-shadow: 0 0 4rpx rgba(232, 68, 59, 0.4); }
/* 2026-07-28：未结束比赛（aWin/bWin 均为 false）显示空心灰边，不亮红/绿，避免误判胜负 */
.series-dot.pending { background: transparent; border-color: #3a4250; }

/* 小场列表 */
.series-games {
  border-top: 1rpx solid #1f262f;
  background: var(--card-bg-inset, #0f141b);
}
.series-game {
  border-bottom: 1rpx solid #1a1f26;
  transition: background 150ms ease;
}
.series-game:last-child { border-bottom: none; }
.series-game.expanded {
  background: var(--card-bg, #161b22);
}
.series-game-main {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  gap: 14rpx;
}
.series-game-idx {
  font-size: 20rpx;
  color: #4b5563;
  font-family: var(--font-mono, monospace);
  font-weight: 700;
  width: 44rpx;
  flex-shrink: 0;
  letter-spacing: 0.5rpx;
}
.series-game-mini {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.03);
  padding: 4rpx 10rpx;
  border-radius: var(--radius-sm, 8rpx);
}
.series-game-score {
  font-size: 24rpx;
  font-weight: 700;
  font-family: var(--font-mono, monospace);
  font-variant-numeric: tabular-nums;
}
.series-game-score.win { color: #5fd35f; }
.series-game-score.lose { color: #4b5563; }
.series-game-sep {
  color: #3a4250;
  font-size: 20rpx;
}
.series-game-time {
  font-size: 22rpx;
  color: #5b626d;
  font-family: var(--font-mono, monospace);
  flex: 1;
  letter-spacing: 0.5rpx;
}
.series-game-duration {
  font-size: 20rpx;
  color: #4b5563;
  font-family: var(--font-mono, monospace);
}
.series-game-expand {
  font-size: 22rpx;
  color: #5b9bff;
  flex-shrink: 0;
  transition: transform 200ms ease;
}
.series-game.expanded .series-game-expand {
  transform: rotate(180deg);
}
.series-game-expand-box {
  margin-top: 0;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #232a33;
  background: var(--card-bg, #161b22);
}

/* ===== A 风格 · vs-card 展开态 ===== */
.vs-card-main {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.vs-expand {
  font-size: 20rpx;
  color: #6b7280;
  margin-top: 4rpx;
}
.vs-vs.win-tag { color: var(--status-ongoing, #5fd35f); }
.vs-vs.lose-tag { color: #6b7280; }
.vs-card-expand {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #232a33;
}
.expand-loading, .expand-empty {
  font-size: 24rpx;
  color: #8a8f99;
  text-align: center;
  padding: 16rpx 0;
}

/* MVP 标记 */
.mvp-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 207, 92, 0.10);
  border-radius: var(--radius-md, 12rpx);
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}
.mvp-tag {
  font-size: 22rpx;
  color: #ffcf5c;
  font-weight: 700;
  background: rgba(255, 207, 92, 0.2);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill, 999rpx);
}
.mvp-name {
  font-size: 26rpx;
  color: #f0f3f6;
  font-weight: 600;
}
.mvp-kda {
  font-size: 22rpx;
  color: #8a8f99;
  font-family: var(--font-mono, monospace);
  margin-left: auto;
}

/* 双方英雄阵容 */
.hero-lineup {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.hero-side {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.hero-side-label {
  font-size: 22rpx;
  color: #8a8f99;
  width: 120rpx;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-side.radiant .hero-side-label { color: var(--status-ongoing, #5fd35f); }
.hero-side.dire .hero-side-label { color: #e8443b; }
.hero-icons {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  flex: 1;
}
.hero-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.hero-icon-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--card-bg-inset, #0f141b);
  border: 1rpx solid #232a33;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #c9d2dd;
}
/* 英雄头像图片（Steam CDN _sb.png，mode=aspectFill 裁切填满） */
.hero-icon-img {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm, 8rpx);
  border: 1rpx solid #232a33;
  background: var(--card-bg-inset, #0f141b);
}
.hero-icon-kda {
  font-size: 18rpx;
  color: #6b7280;
  font-family: var(--font-mono, monospace);
}

/* 完整战报入口 */
.report-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  background: rgba(91, 155, 255, 0.08);
  border-radius: var(--radius-md, 12rpx);
  font-size: 24rpx;
  color: #5b9bff;
  font-weight: 500;
}

/* ===== Tab 2 · 赛事排名数据表样式 ===== */
.standings-card {
  background: var(--card-bg, #161b22);
  border-radius: var(--radius-lg, 16rpx);
  overflow: hidden;
  margin-bottom: 16rpx;
}
.stand-head {
  display: flex;
  align-items: center;
  background: var(--card-bg-elevated, #1c232c);
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  color: #8a8f99;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}
.stand-row {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-top: 1rpx solid #232a33;
  font-size: 26rpx;
  color: #f0f3f6;
  transition: background 120ms ease;
}
.stand-row:active { background: var(--card-bg-elevated, #1c232c); }
.col-rank {
  width: 80rpx;
  text-align: center;
  font-weight: 700;
  font-family: var(--font-mono, monospace);
}
.col-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 8rpx;
}
.col-num {
  width: 120rpx;
  text-align: right;
  font-family: var(--font-numeric, "SF Pro Display", sans-serif);
  font-variant-numeric: tabular-nums;
}

/* 排名前三颜色 */
.rank-1 { color: #ffcf5c; }
.rank-2 { color: #c9d2dd; }
.rank-3 { color: #d99252; }

.loading-row {
  text-align: center;
  color: #8a8f99;
  font-size: 24rpx;
  padding: 24rpx 0;
}

/* ===== 通用 ===== */
.more-btn { width: 100%; }
.loadmore { display: flex; justify-content: center; margin: 24rpx 0 8rpx; }
.error-block { display: flex; flex-direction: column; align-items: center; }
.retry-wrap { margin-top: 16rpx; }

/* 兼容旧版样式（部分组件可能仍引用） */
.liq-banner {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #161b22;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}
.meta-card {
  background: #161b22;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.match-card {
  background: #161b22;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

/* ===== 赛事概述卡片 ===== */
.overview-card {
  background: var(--card-bg-elevated, #1c232c);
  border-radius: var(--radius-lg, 16rpx);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.overview-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.overview-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8a8f99;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.overview-body {
  display: block;
  font-size: 26rpx;
  color: #c9d2dd;
  line-height: 1.65;
}
.overview-name { font-weight: 600; color: #f0f3f6; }
.overview-highlight { color: #ffcf5c; font-weight: 600; }

/* ===== 参赛队伍卡片 ===== */
.teams-card {
  background: var(--card-bg-elevated, #1c232c);
  border-radius: var(--radius-lg, 16rpx);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.teams-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.teams-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8a8f99;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.teams-count {
  font-size: 22rpx;
  color: #5b626d;
  font-family: var(--font-numeric);
}
.teams-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}
.team-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--card-bg, #161b22);
  border: 1rpx solid #232a33;
  border-radius: var(--radius-md, 12rpx);
  padding: 14rpx 16rpx;
  transition: background 120ms ease, border-color 120ms ease;
}
.team-chip:active { background: var(--card-bg-inset, #0f141b); }
.team-chip-logo {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--card-bg-inset, #0f141b);
  border: 1rpx solid #2a323d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #8a8f99;
  flex-shrink: 0;
  overflow: hidden;  /* ★ 新增：让 <image> 被裁剪到圆角内 */
}
.team-chip-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #d4dce6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 2026-07-28：参赛队伍 chip 信息区（队名 + 标签行）与赛区/分组标签 */
.team-chip-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.team-chip-tags {
  display: flex;
  gap: 6rpx;
  flex-wrap: nowrap;
}
.team-chip-group {
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #1ec896, #17a083);
  border-radius: 4rpx;
  padding: 1rpx 8rpx;
  line-height: 1.6;
  flex-shrink: 0;
  text-align: center;
  min-width: 28rpx;
}
.team-chip-group.group-B {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
}
.team-chip-group.group-Play-In {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
  font-size: 16rpx;
}
.team-chip-region {
  font-size: 18rpx;
  color: #9ca3af;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 4rpx;
  padding: 1rpx 8rpx;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 160rpx;
}
/* 2026-07-28：参赛队伍 chip 状态徽标（直邀/预选）与待公布样式 */
.team-chip-badge {
  font-size: 20rpx;
  color: #8a8f99;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  flex-shrink: 0;
}
.team-chip.is-pending {
  opacity: 0.5;
  border-style: dashed;
}
.team-chip.is-pending .team-chip-name {
  color: #5b626d;
  font-style: italic;
}
.teams-empty {
  font-size: 24rpx;
  color: #5b626d;
  text-align: center;
  padding: 16rpx 0;
}

/* 赛事信息补充（curation 兜底：Liquipedia slug 链接） */
.meta-extra {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  background: #161b22;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}
.meta-extra-label { color: #8a8f99; }
.meta-extra-link { color: #5fd3ff; text-decoration: underline; }

/* ===== 战队 LOGO image 通用样式（2026-07-28 新增） ===== */
/* logo image 填满父容器（series-team-logo / team-chip-logo），
   父容器已设 overflow: hidden + border-radius，image 自动被裁剪到圆角内。
   aspectFill 模式保持比例填满，避免拉伸变形。 */
.team-logo-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* ===== 三段式分段分隔符（2026-07-28 新增） ===== */
/* 分段标题：左侧色条 + 文案 + 计数 + 可折叠按钮（仅 RECENT） */
.phase-divider {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 12rpx;
  margin-top: 8rpx;
}
.phase-divider-bar {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.phase-divider-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #c0c4cc;
  flex: 1;
}
.phase-divider-toggle {
  font-size: 22rpx;
  color: #8a8f99;
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 6rpx;
}
/* LIVE 段：绿色色条 */
.phase-divider-live .phase-divider-bar {
  background: #1ec896;
  box-shadow: 0 0 12rpx rgba(30, 200, 150, 0.4);
}
.phase-divider-live .phase-divider-text {
  color: #1ec896;
}
/* UPCOMING 段：黄色色条 */
.phase-divider-upcoming .phase-divider-bar {
  background: #ffcf5c;
  box-shadow: 0 0 12rpx rgba(255, 207, 92, 0.4);
}
.phase-divider-upcoming .phase-divider-text {
  color: #ffcf5c;
}
/* RECENT 段：灰色色条，可点击折叠 */
.phase-divider-recent .phase-divider-bar {
  background: #5a6068;
}
.phase-divider-recent {
  /* 点击折叠区域 */
}
.phase-divider-recent .phase-divider-toggle {
  cursor: pointer;
}

/* ===== 三段式 series-card 差异化样式（2026-07-28 新增） ===== */
/* 基础卡片样式不动，仅追加 phase 差异化 class */

/* LIVE 段：绿色左边框 + 轻微发光 */
.series-card.series-live {
  border-left: 3rpx solid #1ec896;
  box-shadow: 0 0 24rpx -8rpx rgba(30, 200, 150, 0.25);
}
/* LIVE 标签已有样式（series-live-tag），这里仅强化脉冲 */
.series-card.series-live .series-live-tag {
  color: #1ec896;
  animation: live-pulse 1.8s ease-in-out infinite;
}
@keyframes live-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* UPCOMING 段：黄色左边框 + 浅黄背景 */
.series-card.series-upcoming {
  border-left: 3rpx solid #ffcf5c;
  background: linear-gradient(90deg, rgba(255, 207, 92, 0.05) 0%, transparent 100%);
}
/* 未开赛：开赛时间样式（替代比分位） */
.series-scheduled-time {
  font-size: 28rpx;
  color: #ffcf5c;
  font-weight: 600;
  letter-spacing: 1rpx;
}
/* 未开赛：倒计时标签 */
.series-upcoming-tag {
  color: #ffcf5c;
  font-size: 22rpx;
  margin-left: auto;
}

/* RECENT 段：整体降透明度，弱化次要信息 */
.series-card.series-recent {
  opacity: 0.75;
}
.series-card.series-recent .series-team-logo {
  opacity: 0.9;
}

