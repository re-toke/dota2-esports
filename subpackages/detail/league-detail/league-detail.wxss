.container {
  padding: var(--space-3);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* ===== KPI Strip 三色语义（v11 聚光灯 Phase 6.4 映射） =====
   奖金池=金色 / 参赛队=天辉绿 / 赛制=灰色——三项数值用三种语义色区分 */
.kpi-gold { color: var(--dota-gold, #C8A951); }
.kpi-teams { color: var(--radiant, #5fd35f); }
.kpi-format { color: var(--text-2); }

/* ===== 头部 ===== */
.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: var(--space-2);
  gap: var(--space-2);
}
.head-info { flex: 1; min-width: 0; }
.head-info .title {
  font-size: var(--fs-display);
  font-weight: 700;
  color: var(--text-1);
  line-height: var(--lh-tight);
  font-family: var(--font-display, -apple-system, sans-serif);
}
.head-meta {
  display: flex;
  align-items: center;
  gap: var(--space-1-5);
  margin-top: var(--space-1);
  flex-wrap: wrap;
}
.head-meta .sub { font-size: var(--fs-body); color: var(--text-2); }
.head-meta .status-tag {
  font-size: var(--fs-micro);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid;
  line-height: var(--lh-relaxed);
}
.star-btn { padding: var(--space-0-5) 0 var(--space-0-5) var(--space-2); flex-shrink: 0; min-width: 88rpx; min-height: 88rpx; display: inline-flex; align-items: center; justify-content: flex-start; box-sizing: border-box; }

/* ===== 数据溯源合并区（C 风格 · 替代原 4 个独立信息条） ===== */
.source-section {
  background: var(--card-bg-elevated, #222226);
  border-radius: var(--radius-lg, 16rpx);
  padding: var(--space-2-5) var(--space-3);
  margin-bottom: var(--space-2);
}
.source-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-1-5);
}
.source-section-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.source-section-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-1-5);
}

/* 可信度 pill */
.quality-pill {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--fs-body);
  padding: 6rpx var(--space-2);
  border-radius: var(--radius-pill, 999rpx);
  align-self: flex-start;
}
.quality-pill .q-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.quality-pill .q-text { font-weight: 600; }
.quality-pill .q-src { font-size: var(--fs-caption); opacity: 0.85; }
.quality-high { background: rgba(95, 211, 168, 0.12); color: var(--status-verified); }
.quality-high .q-dot { background: var(--status-verified); }
.quality-medium { background: rgba(255, 207, 92, 0.12); color: #ffcf5c; }
.quality-medium .q-dot { background: #ffcf5c; }
.quality-low { background: rgba(107, 114, 128, 0.16); color: var(--text-2); }
.quality-low .q-dot { background: var(--text-2); }

/* 规范名修正 */
.name-fix {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--fs-body);
  flex-wrap: wrap;
}
.name-fix-val { color: var(--radiant); font-weight: 600; }

/* ===== KPI Strip 局部样式（value-row 单元） ===== */
.kpi-value-row {
  display: flex;
  align-items: baseline;
  gap: var(--space-0-5);
  flex-wrap: wrap;
}

/* ===== 比赛卡 vs-card 局部样式 ===== */
/* vs-card 默认类已在 app.wxss 定义，这里补充比赛卡占位 logo */
.vs-team-logo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--text-2);
  background: var(--card-bg-inset, #131316);
  border: 1rpx solid #262628;
}

/* ===== 三 Tab 分段控件 ===== */
.seg {
  display: flex;
  background: var(--card-bg-inset, #131316);
  border-radius: var(--radius-md, 12rpx);
  padding: var(--space-0-5);
  margin: var(--space-2) 0;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: var(--fs-label);
  color: var(--text-2);
  border-radius: var(--radius-sm);
  transition: background 120ms ease, color 120ms ease;
}
.seg-item.active {
  background: var(--card-bg-elevated, #222226);
  color: var(--text-1);
  font-weight: 600;
}
.seg-count {
  display: inline-block;
  margin-left: var(--space-0-5);
  font-size: var(--fs-caption);
  opacity: 0.8;
}

/* ===== 系列赛聚合卡（A 紧凑 · B 点缀高亮） ===== */
.series-card {
  background: var(--card-bg, #1a1a1e);
  border-radius: var(--radius-lg, 16rpx);
  margin-bottom: var(--space-2);
  overflow: hidden;
  border: 1rpx solid #262628;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  transition: border-color 200ms ease, box-shadow 200ms ease;
}
/* B 点缀：直播中（红色高亮 + 左边框 + 呼吸光效；批次1 §9.2 LIVE 全站统一红） */
.series-card.series-live {
  border-color: rgba(255, 91, 82, 0.4);
  border-left: 4rpx solid var(--status-live);
  background: linear-gradient(180deg, rgba(255, 91, 82, 0.06), var(--card-bg, #1a1a1e) 40%);
  box-shadow: 0 2rpx 12rpx rgba(255, 91, 82, 0.12);
}
/* B 点缀：近 2h 内结束（黄色高亮 + 左边框） */
.series-card.series-recent {
  border-color: rgba(255, 207, 92, 0.35);
  border-left: 4rpx solid #ffcf5c;
  box-shadow: 0 2rpx 10rpx rgba(255, 207, 92, 0.08);
}

/* 系列头部：队A · 大比分 · 队B */
.series-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-3) 14rpx;
  gap: var(--space-1-5);
}
.series-team {
  display: flex;
  align-items: center;
  gap: var(--space-1-5);
  flex: 1;
  min-width: 0;
}
.series-team.right { justify-content: flex-end; }
.series-team-logo {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--card-bg-inset, #131316);
  border: 1rpx solid #2a323d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-caption);
  font-weight: 700;
  color: var(--text-2);
  flex-shrink: 0;
  overflow: hidden;  /* ★ 新增：让 <image> 被裁剪到圆角内 */
  transition: border-color 200ms ease, background 200ms ease;
}
/* 保险：让内部 image-fallback 自定义组件占满 logo 容器，
   与组件内 :host 声明形成双重保障，避免某些场景下组件尺寸塌陷。 */
.series-team-logo image-fallback {
  width: 100%;
  height: 100%;
  display: block;
}
.series-team-name {
  font-size: var(--fs-subhead);
  font-weight: 600;
  color: #d4dce6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0.5rpx;
}
/* 已结束胜负标识（金色强调，区别于 .win 绿阵营语义）：
   胜方队名加粗 + 金色；败方常规字重 + 灰色 */
.series-team.win .series-team-name,
.series-team.is-win .series-team-name {
  color: var(--dota-gold, #C8A951);
  font-weight: 800;
}
.series-team.is-lose .series-team-name {
  color: var(--text-3);
  font-weight: 400;
}
.series-team-name.draw { color: #d4dce6; }
.series-team.is-draw .series-team-name { color: #d4dce6; }
/* 胜方 logo 加金色边框 + 微妙光效 */
.series-team-logo.team-win {
  border-color: rgba(255, 207, 92, 0.6);
  background: linear-gradient(135deg, rgba(255, 207, 92, 0.12), rgba(255, 207, 92, 0.04));
  color: #ffcf5c;
  box-shadow: 0 0 8rpx rgba(255, 207, 92, 0.2);
}
/* 胜方行左侧/右侧金色竖线（3-4px），败方浅灰线 */
.series-team.is-win { box-shadow: inset 4rpx 0 0 0 var(--dota-gold, #C8A951); }
.series-team.is-lose { box-shadow: inset 4rpx 0 0 0 rgba(120, 128, 140, 0.25); }
.series-team.right.is-win { box-shadow: inset -4rpx 0 0 0 var(--dota-gold, #C8A951); }
.series-team.right.is-lose { box-shadow: inset -4rpx 0 0 0 rgba(120, 128, 140, 0.25); }
.series-score {
  display: flex;
  align-items: baseline;
  gap: var(--space-1);
  padding: var(--space-0-5) var(--space-2);
  position: relative;
  background: var(--card-bg-inset, #131316);
  border-radius: var(--radius-md, 12rpx);
  border: 1rpx solid #1f262f;
}
.series-score-num {
  font-size: var(--fs-mega);
  font-weight: 800;
  font-family: var(--font-mono, "SF Mono", "JetBrains Mono", monospace);
  font-variant-numeric: tabular-nums;
  line-height: 1;
  letter-spacing: -1rpx;
}
/* 胜方比分：金色加粗 + 底部色块衬底；败方灰色常规 */
.series-score-num.win,
.series-score-num.is-win {
  color: var(--dota-gold, #C8A951);
  font-weight: 800;
  border-bottom: 4rpx solid var(--dota-gold, #C8A951);
  padding-bottom: 2rpx;
}
.series-score-num.lose,
.series-score-num.is-lose { color: var(--text-4); }
.series-score-num.draw,
.series-score-num.is-draw { color: #d4dce6; }
.series-score-sep {
  color: #3a4250;
  font-size: var(--fs-subhead);
  font-weight: 400;
}
/* BO2 平局徽标 */
.series-draw-badge {
  position: absolute;
  top: -10rpx;
  right: -12rpx;
  font-size: var(--fs-badge);
  font-weight: 700;
  color: #ffcf5c;
  background: rgba(255, 207, 92, 0.2);
  border: 1rpx solid rgba(255, 207, 92, 0.5);
  border-radius: var(--radius-pill, 999rpx);
  padding: 2rpx 10rpx;
  line-height: var(--lh-normal);
  letter-spacing: 1rpx;
}
/* 胜方「胜」徽章（圆角填充） */
.series-win-badge {
  margin-left: 10rpx;
  font-size: var(--fs-badge);
  font-weight: 700;
  color: #1a1205;
  background: linear-gradient(135deg, #ffcf5c, #C8A951);
  border-radius: var(--radius-pill);
  padding: 2rpx var(--space-1-5);
  line-height: var(--lh-normal);
  letter-spacing: 1rpx;
  flex-shrink: 0;
}
/* 数据缺失：已结束但无比分，仅显示「已结束」 */
.series-score-missing {
  font-size: var(--fs-label);
  font-weight: 600;
  color: var(--text-2);
  letter-spacing: 1rpx;
}
/* B 点缀：live/recent 比分放大 */
.series-live .series-score-num,
.series-recent .series-score-num {
  font-size: var(--fs-hero);
}
.series-live .series-score {
  border-color: rgba(255, 91, 82, 0.3);
  background: rgba(255, 91, 82, 0.04);
}
/* v11 聚光灯 Phase 6.4：LIVE 比分阵营色——天辉方绿 / 夜魇方红（当前直播比分）
   天辉方 = scoreACls 含 'win' 且为 radiant 胜者时由 JS 注入阵营类 */
.series-live .score-radiant { color: var(--radiant, #5fd35f); font-weight: 700; }
.series-live .score-dire    { color: var(--dire, #e8443b);   font-weight: 700; }
.series-recent .series-score {
  border-color: rgba(255, 207, 92, 0.25);
}
/* v11 聚光灯：LIVE 标签脉冲呼吸（pulse-glow 定义在 app.wxss） */
.series-live .series-live-tag {
  animation: pulse-glow var(--dur-breath) var(--ease-in-out) infinite;
}

/* 系列元信息行 */
.series-meta {
  display: flex;
  align-items: center;
  gap: var(--space-1-5);
  padding: 0 var(--space-3) var(--space-2);
  flex-wrap: wrap;
}
/* BO 标签组：主标签 + 赛制说明 */
.series-bo-group {
  display: flex;
  align-items: baseline;
  gap: var(--space-1);
}
.series-bo-tag {
  font-size: var(--fs-micro);
  padding: var(--space-0-5) 14rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: rgba(96, 84, 241, 0.14);
  color: #8b80ff;
  border: 1rpx solid rgba(96, 84, 241, 0.3);
  font-weight: 700;
  letter-spacing: 1.5rpx;
}
/* BO2 双局积分：青色（区别于淘汰赛） */
.series-bo-tag.bo-bo2 {
  background: rgba(91, 155, 255, 0.12);
  color: #5b9bff;
  border-color: rgba(91, 155, 255, 0.35);
}
/* BO3 三局两胜：天辉绿 */
.series-bo-tag.bo-bo3 {
  background: rgba(95, 211, 95, 0.12);
  color: var(--radiant);
  border-color: rgba(95, 211, 95, 0.35);
}
/* BO5 巅峰对决：橙金色 */
.series-bo-tag.bo-bo5 {
  background: rgba(255, 165, 70, 0.12);
  color: #ffa546;
  border-color: rgba(255, 165, 70, 0.35);
}
.series-bo-label {
  font-size: var(--fs-micro);
  color: var(--text-4);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}
.series-live-tag {
  font-size: var(--fs-caption);
  color: var(--status-live);
  font-weight: 700;
  letter-spacing: 1rpx;
  animation: live-pulse var(--dur-sway) var(--ease-in-out) infinite;
}
@keyframes live-pulse {
  0%, 100% { opacity: 1; text-shadow: 0 0 4rpx rgba(255, 91, 82, 0.6); }
  50% { opacity: 0.6; text-shadow: 0 0 2rpx rgba(255, 91, 82, 0.3); }
}
.series-time {
  font-size: var(--fs-caption);
  color: var(--text-4);
  font-family: var(--font-mono, monospace);
  letter-spacing: 0.5rpx;
}
.series-dots {
  display: flex;
  gap: 6rpx;
  margin-left: auto;
}
.series-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 1rpx solid #3a4250;
  background: transparent;
}
.series-dot.a-win { background: var(--radiant); border-color: var(--radiant); box-shadow: 0 0 4rpx rgba(95, 211, 95, 0.4); }
.series-dot.b-win { background: var(--dire); border-color: var(--dire); box-shadow: 0 0 4rpx rgba(232, 68, 59, 0.4); }
/* 2026-07-28：未结束比赛（aWin/bWin 均为 false）显示空心灰边，不亮红/绿，避免误判胜负 */
.series-dot.pending { background: transparent; border-color: #3a4250; }

/* 小场列表 */
.series-games {
  border-top: 1rpx solid #1f262f;
  background: var(--card-bg-inset, #131316);
}
.series-game {
  border-bottom: 1rpx solid #1a1f26;
  transition: background 150ms ease;
}
.series-game:last-child { border-bottom: none; }
.series-game.expanded {
  background: var(--card-bg, #1a1a1e);
}
.series-game-main {
  display: flex;
  align-items: center;
  padding: 18rpx var(--space-3);
  gap: 14rpx;
}
.series-game-idx {
  font-size: var(--fs-micro);
  color: #4b5563;
  font-family: var(--font-mono, monospace);
  font-weight: 700;
  width: 44rpx;
  flex-shrink: 0;
  letter-spacing: 0.5rpx;
}
.series-game-mini {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.03);
  padding: var(--space-0-5) 10rpx;
  border-radius: var(--radius-sm, 8rpx);
}
.series-game-score {
  font-size: var(--fs-body);
  font-weight: 700;
  font-family: var(--font-mono, monospace);
  font-variant-numeric: tabular-nums;
}
.series-game-score.win { color: var(--radiant); }
.series-game-score.lose { color: #4b5563; }
.series-game-sep {
  color: #3a4250;
  font-size: var(--fs-micro);
}
.series-game-time {
  font-size: var(--fs-caption);
  color: var(--text-4);
  font-family: var(--font-mono, monospace);
  flex: 1;
  letter-spacing: 0.5rpx;
}
.series-game-duration {
  font-size: var(--fs-micro);
  color: #4b5563;
  font-family: var(--font-mono, monospace);
}
.series-game-expand {
  font-size: var(--fs-caption);
  color: #5b9bff;
  flex-shrink: 0;
  transition: transform 200ms ease;
}
.series-game.expanded .series-game-expand {
  transform: rotate(180deg);
}
.series-game-expand-box {
  margin-top: 0;
  padding: var(--space-2-5) var(--space-3);
  border-top: 1rpx solid #262628;
  background: var(--card-bg, #1a1a1e);
}

/* ===== A 风格 · vs-card 展开态 ===== */
.vs-card-main {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}
.vs-expand {
  font-size: var(--fs-micro);
  color: var(--text-3);
  margin-top: var(--space-0-5);
}
.vs-vs.win-tag { color: var(--status-ongoing, #5fd35f); }
.vs-vs.lose-tag { color: var(--text-3); }
.vs-card-expand {
  margin-top: var(--space-2);
  padding-top: var(--space-2);
  border-top: 1rpx solid #262628;
}
.expand-loading, .expand-empty {
  font-size: var(--fs-body);
  color: var(--text-2);
  text-align: center;
  padding: var(--space-2) 0;
}

/* MVP 标记 */
.mvp-row {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  background: rgba(255, 207, 92, 0.10);
  border-radius: var(--radius-md, 12rpx);
  padding: var(--space-1-5) var(--space-2);
  margin-bottom: var(--space-1-5);
  flex-wrap: wrap;
}
.mvp-tag {
  font-size: var(--fs-caption);
  color: #ffcf5c;
  font-weight: 700;
  background: rgba(255, 207, 92, 0.2);
  padding: var(--space-0-5) var(--space-1-5);
  border-radius: var(--radius-pill, 999rpx);
}
.mvp-name {
  font-size: var(--fs-label);
  color: var(--text-1);
  font-weight: 600;
}
.mvp-kda {
  font-size: var(--fs-caption);
  color: var(--text-2);
  font-family: var(--font-mono, monospace);
  margin-left: auto;
}

/* 双方英雄阵容 */
.hero-lineup {
  display: flex;
  flex-direction: column;
  gap: var(--space-1-5);
}
.hero-side {
  display: flex;
  align-items: center;
  gap: var(--space-1-5);
}
.hero-side-label {
  font-size: var(--fs-caption);
  color: var(--text-2);
  width: 120rpx;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-side.radiant .hero-side-label { color: var(--status-ongoing, #5fd35f); }
.hero-side.dire .hero-side-label { color: var(--dire); }
.hero-icons {
  display: flex;
  gap: var(--space-1-5);
  flex-wrap: wrap;
  flex: 1;
}
.hero-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-0-5);
}
.hero-icon-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--card-bg-inset, #131316);
  border: 1rpx solid #262628;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-micro);
  font-weight: 700;
  color: #c9d2dd;
}
/* 英雄头像图片（Steam CDN _sb.png，mode=aspectFill 裁切填满） */
.hero-icon-img {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm, 8rpx);
  border: 1rpx solid #262628;
  background: var(--card-bg-inset, #131316);
}
.hero-icon-kda {
  font-size: var(--fs-badge);
  color: var(--text-3);
  font-family: var(--font-mono, monospace);
}

/* 完整战报入口 */
.report-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-2);
  padding: 14rpx var(--space-2);
  background: rgba(91, 155, 255, 0.08);
  border-radius: var(--radius-md, 12rpx);
  font-size: var(--fs-body);
  color: #5b9bff;
  font-weight: 500;
}

/* ===== Tab 2 · 赛事排名数据表样式 ===== */
.standings-card {
  background: var(--card-bg, #1a1a1e);
  border-radius: var(--radius-lg, 16rpx);
  overflow: hidden;
  margin-bottom: var(--space-2);
}
.stand-head {
  display: flex;
  align-items: center;
  background: var(--card-bg-elevated, #222226);
  padding: var(--space-2) var(--space-2-5);
  font-size: var(--fs-caption);
  color: var(--text-2);
  letter-spacing: 1rpx;
  text-transform: uppercase;
}
.stand-row {
  display: flex;
  align-items: center;
  padding: var(--space-2) var(--space-2-5);
  border-top: 1rpx solid #262628;
  font-size: var(--fs-label);
  color: var(--text-1);
  transition: background 120ms ease;
}
.stand-row:active { background: var(--card-bg-elevated, #222226); }
.col-rank {
  width: 80rpx;
  text-align: center;
  font-weight: 700;
  font-family: var(--font-mono, monospace);
}
.col-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 var(--space-1);
}
.col-num {
  width: 120rpx;
  text-align: right;
  font-family: var(--font-numeric, "SF Pro Display", sans-serif);
  font-variant-numeric: tabular-nums;
}

/* 排名前三颜色 */
.rank-1 { color: #ffcf5c; }
.rank-2 { color: #c9d2dd; }
.rank-3 { color: #d99252; }

.loading-row {
  text-align: center;
  color: var(--text-2);
  font-size: var(--fs-body);
  padding: var(--space-3) 0;
}

/* ===== 通用 ===== */
.more-btn { width: 100%; }
.loadmore { display: flex; justify-content: center; margin: var(--space-3) 0 var(--space-1); }
.error-block { display: flex; flex-direction: column; align-items: center; }
.retry-wrap { margin-top: var(--space-2); }

/* 兼容旧版样式（部分组件可能仍引用） */
.liq-banner {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #1a1a1e;
  border-radius: var(--radius-md);
  padding: 14rpx var(--space-2-5);
  margin-bottom: var(--space-2);
  font-size: var(--fs-body);
}
.meta-card {
  background: #1a1a1e;
  border-radius: var(--radius-lg);
  padding: var(--space-2-5) var(--space-3);
  margin-bottom: var(--space-2);
}
.match-card {
  background: #1a1a1e;
  border-radius: var(--radius-lg);
  padding: var(--space-2-5) var(--space-3);
  margin-bottom: var(--space-2);
}

/* ===== 赛事概述卡片 ===== */
.overview-card {
  background: var(--card-bg-elevated, #222226);
  border-radius: var(--radius-lg, 16rpx);
  padding: var(--space-2-5) var(--space-3);
  margin-bottom: var(--space-2);
}
.overview-head {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  margin-bottom: var(--space-1-5);
}
.overview-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.overview-body {
  display: block;
  font-size: var(--fs-label);
  color: #c9d2dd;
  line-height: var(--lh-loose);
}
.overview-name { font-weight: 600; color: var(--text-1); }
.overview-highlight { color: #ffcf5c; font-weight: 600; }

/* ===== 参赛队伍卡片 ===== */
.teams-card {
  background: var(--card-bg-elevated, #222226);
  border-radius: var(--radius-lg, 16rpx);
  padding: var(--space-2-5) var(--space-3);
  margin-bottom: var(--space-2);
}
.teams-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-2);
}
.teams-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.teams-count {
  font-size: var(--fs-caption);
  color: var(--text-4);
  font-family: var(--font-numeric);
}
.teams-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-1-5);
}
.team-chip {
  display: flex;
  align-items: center;
  gap: var(--space-1-5);
  background: var(--card-bg, #1a1a1e);
  border: 1rpx solid #262628;
  border-radius: var(--radius-md, 12rpx);
  padding: 14rpx var(--space-2);
  transition: background 120ms ease, border-color 120ms ease;
}
.team-chip:active { background: var(--card-bg-inset, #131316); }
.team-chip-logo {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--card-bg-inset, #131316);
  border: 1rpx solid #2a323d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-micro);
  font-weight: 700;
  color: var(--text-2);
  flex-shrink: 0;
  overflow: hidden;  /* ★ 新增：让 <image> 被裁剪到圆角内 */
}
.team-chip-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-label);
  color: #d4dce6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 2026-07-28：参赛队伍 chip 信息区（队名 + 标签行）与赛区/分组标签 */
.team-chip-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-0-5);
}
.team-chip-tags {
  display: flex;
  gap: 6rpx;
  flex-wrap: nowrap;
}
.team-chip-group {
  font-size: var(--fs-badge);
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, var(--radiant), var(--radiant-strong));
  border-radius: var(--radius-xs);
  padding: 1rpx var(--space-1);
  line-height: var(--lh-relaxed);
  flex-shrink: 0;
  text-align: center;
  min-width: 28rpx;
}
.team-chip-group.group-B {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
}
.team-chip-group.group-Play-In {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
  font-size: var(--fs-badge);
}
.team-chip-region {
  font-size: var(--fs-badge);
  color: var(--text-2);
  background: rgba(255, 255, 255, 0.05);
  border-radius: var(--radius-xs);
  padding: 1rpx var(--space-1);
  line-height: var(--lh-relaxed);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 160rpx;
}
/* 2026-07-28：参赛队伍 chip 状态徽标（直邀/预选）与待公布样式 */
.team-chip-badge {
  font-size: var(--fs-micro);
  color: var(--text-2);
  background: rgba(255, 255, 255, 0.06);
  border-radius: var(--radius-sm);
  padding: 2rpx var(--space-1);
  flex-shrink: 0;
}
.team-chip.is-pending {
  opacity: 0.5;
  border-style: dashed;
}
.team-chip.is-pending .team-chip-name {
  color: var(--text-4);
  font-style: italic;
}
.teams-empty {
  font-size: var(--fs-body);
  color: var(--text-4);
  text-align: center;
  padding: var(--space-2) 0;
}

/* 赛事信息补充（curation 兜底：Liquipedia slug 链接） */
.meta-extra {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-1);
  background: #1a1a1e;
  border-radius: var(--radius-md);
  padding: 14rpx var(--space-2-5);
  margin-bottom: var(--space-2);
  font-size: var(--fs-body);
}
.meta-extra-label { color: var(--text-2); }
.meta-extra-link { color: #5fd3ff; text-decoration: underline; }

/* ===== 战队 LOGO image 通用样式（2026-07-28 新增） ===== */
/* logo image 填满父容器（series-team-logo / team-chip-logo），
   父容器已设 overflow: hidden + border-radius，image 自动被裁剪到圆角内。
   aspectFill 模式保持比例填满，避免拉伸变形。 */
.team-logo-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* ===== 三段式分段分隔符（2026-07-28 新增） ===== */
/* 分段标题：左侧色条 + 文案 + 计数 + 可折叠按钮（仅 RECENT） */
.phase-divider {
  display: flex;
  align-items: center;
  padding: var(--space-3) var(--space-4) var(--space-1-5);
  margin-top: var(--space-1);
}
.phase-divider-bar {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  margin-right: var(--space-2);
  flex-shrink: 0;
}
.phase-divider-text {
  font-size: var(--fs-label);
  font-weight: 600;
  color: #c0c4cc;
  flex: 1;
}
.phase-divider-toggle {
  font-size: var(--fs-caption);
  color: var(--text-2);
  padding: var(--space-0-5) var(--space-1-5);
  background: rgba(255, 255, 255, 0.04);
  border-radius: var(--radius-sm);
}
/* LIVE 段：红色色条（批次1 §9.2 LIVE 统一红） */
.phase-divider-live .phase-divider-bar {
  background: var(--status-live);
  box-shadow: 0 0 12rpx rgba(255, 91, 82, 0.4);
}
.phase-divider-live .phase-divider-text {
  color: var(--status-live);
}
/* UPCOMING 段：黄色色条 */
.phase-divider-upcoming .phase-divider-bar {
  background: #ffcf5c;
  box-shadow: 0 0 12rpx rgba(255, 207, 92, 0.4);
}
.phase-divider-upcoming .phase-divider-text {
  color: #ffcf5c;
}
/* RECENT 段：灰色色条，可点击折叠 */
.phase-divider-recent .phase-divider-bar {
  background: #5a6068;
}
.phase-divider-recent {
  /* 点击折叠区域 */
}
.phase-divider-recent .phase-divider-toggle {
  cursor: pointer;
}

/* ===== 三段式 series-card 差异化样式（2026-07-28 新增） ===== */
/* 基础卡片样式不动，仅追加 phase 差异化 class */

/* LIVE 段：红色左边框 + 轻微发光（批次1 §9.2 LIVE 统一红） */
.series-card.series-live {
  border-left: 3rpx solid var(--status-live);
  box-shadow: 0 0 24rpx -8rpx rgba(255, 91, 82, 0.25);
}
/* LIVE 标签已有样式（series-live-tag），这里仅强化脉冲 */
.series-card.series-live .series-live-tag {
  color: var(--status-live);
  animation: live-pulse var(--dur-sway) var(--ease-in-out) infinite;
}
@keyframes live-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* UPCOMING 段：黄色左边框 + 浅黄背景 */
.series-card.series-upcoming {
  border-left: 3rpx solid #ffcf5c;
  background: linear-gradient(90deg, rgba(255, 207, 92, 0.05) 0%, transparent 100%);
}
/* 未开赛：开赛时间样式（替代比分位） */
.series-scheduled-time {
  font-size: var(--fs-subhead);
  color: #ffcf5c;
  font-weight: 600;
  letter-spacing: 1rpx;
}
/* 未开赛：倒计时标签 */
.series-upcoming-tag {
  color: #ffcf5c;
  font-size: var(--fs-caption);
  margin-left: auto;
}

/* RECENT 段：整体降透明度，弱化次要信息 */
.series-card.series-recent {
  opacity: 0.75;
}
.series-card.series-recent .series-team-logo {
  opacity: 0.9;
}

/* ===== v3 优化项26：cancelled 赛事提示 ===== */
.cancelled-notice {
  text-align: center;
  padding: var(--space-4) var(--space-3);
  margin: var(--space-2) 0;
  background: rgba(232, 68, 59, 0.08);
  border-radius: var(--radius-lg, 16rpx);
  border: 1rpx solid rgba(232, 68, 59, 0.2);
  color: var(--dire);
  font-size: var(--fs-subhead);
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* ===== v3 优化项⑬：LIVE 系列进度与已进行时长 ===== */
.series-live-progress {
  font-size: var(--fs-caption);
  color: var(--status-live);
  font-weight: 600;
  letter-spacing: 0.5rpx;
}
.series-elapsed {
  font-size: var(--fs-caption);
  color: rgba(30, 200, 150, 0.75);
  font-family: var(--font-mono, monospace);
  letter-spacing: 0.5rpx;
}

/* ===== v3 优化项⑭：UPCOMING 确定性标识与焦点战 ===== */
.series-confirmed-badge {
  font-size: var(--fs-caption);
  color: #4cd964;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}
/* ★ 2026-08-05（v1.1，审核 R3）：未确认方队名 —— 方案 D 斜体浅灰，与正常队名区分（待定徽标 UI 已移除，仅保留队名位斜体） */
.series-team-name.tbd {
  color: #b8b8c4;
  font-style: italic;
  font-weight: 400;
}
.series-focus-badge {
  font-size: var(--fs-caption);
  color: #ffcc00;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  text-shadow: 0 0 6rpx rgba(255, 204, 0, 0.3);
}

/* ===== v3 优化项21：UPCOMING 日期子标题 ===== */
.date-sep {
  display: flex;
  align-items: center;
  padding: var(--space-2-5) var(--space-3) var(--space-1);
  margin-top: var(--space-0-5);
}
.date-sep::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ffcf5c;
  margin-right: var(--space-1-5);
  flex-shrink: 0;
  opacity: 0.7;
}
.date-sep-text {
  font-size: var(--fs-body);
  font-weight: 600;
  color: #c0c4cc;
  letter-spacing: 1rpx;
}

/* ===== v3 优化项21：远期赛程折叠入口 ===== */
.far-future-toggle {
  text-align: center;
  padding: var(--space-2-5) var(--space-3);
  margin: var(--space-1) 0 var(--space-2);
  color: #5b9bff;
  font-size: var(--fs-label);
  font-weight: 600;
  background: rgba(91, 155, 255, 0.06);
  border-radius: var(--radius-md, 12rpx);
  border: 1rpx solid rgba(91, 155, 255, 0.15);
  letter-spacing: 0.5rpx;
}

/* ===== v3 优化项⑮：RECENT 时间分层子标题 ===== */
.time-layer-sep {
  display: flex;
  align-items: center;
  padding: var(--space-2) var(--space-3) 6rpx;
  margin-top: var(--space-0-5);
}
.time-layer-sep::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--text-2);
  margin-right: var(--space-1-5);
  flex-shrink: 0;
  opacity: 0.6;
}
.time-layer-sep-text {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-2);
  letter-spacing: 1rpx;
}

/* ===== v3 优化项⑮：RECENT 总耗时 ===== */
.series-total-duration {
  font-size: var(--fs-caption);
  color: var(--text-4);
  font-family: var(--font-mono, monospace);
  letter-spacing: 0.5rpx;
  margin-left: auto;
}

