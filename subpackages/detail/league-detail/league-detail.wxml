<view class="container">
  <!-- 头部：赛事名 + 关注 + 比赛数 + 状态徽标 -->
  <view class="head">
    <view class="head-info">
      <view class="title">{{displayName}}</view>
      <view class="head-meta">
        <text class="sub">共 {{totalSeries}} 组对阵{{hasMore ? '（持续加载）' : ''}}</text>
        <text wx:if="{{eventWindow}}" class="sub">{{eventWindow.range}}</text>
        <text wx:if="{{eventWindow}}" class="status-tag" style="color:{{eventWindow.statusColor}};border-color:{{eventWindow.statusColor}}">{{eventWindow.statusText}}</text>
        <text wx:if="{{liqTier}}" class="status-tag" style="color:{{liqTier.confidence === 'high' ? '#5fd35f' : '#f0aa28'}};border-color:{{liqTier.confidence === 'high' ? '#5fd35f' : '#f0aa28'}}">{{liqTier.label}}</text>
      </view>
    </view>
    <view class="star-btn" catchtap="toggleFollow">
      <t-icon name="star" size="48rpx" color="{{followed ? '#ffcf5c' : '#5b626d'}}" />
    </view>
  </view>

  <!-- 数据溯源合并区（C 风格 · 把 quality / name-fix / liq-banner / sources 收敛为一区） -->
  <view class="source-section" wx:if="{{quality || (nameInfo && nameInfo.differs) || liqTier || sourceBadges.length}}">
    <view class="source-section-head">
      <text class="source-section-title">数据溯源</text>
      <text wx:if="{{updatedLabel}}" class="fresh-label">{{updatedLabel}}</text>
    </view>
    <view class="source-section-body">
      <view wx:if="{{quality}}" class="quality-pill quality-{{quality.level}}">
        <text class="q-dot"></text>
        <text class="q-text">{{quality.text}}</text>
        <text wx:if="{{quality.sources > 1}}" class="q-src">· {{quality.sources}} 源</text>
      </view>
      <view wx:if="{{nameInfo && nameInfo.differs}}" class="name-fix">
        <text class="muted">规范名（{{nameInfo.sourceLabel}}）：</text>
        <text class="name-fix-val">{{nameInfo.value}}</text>
      </view>
      <view class="source-grid" wx:if="{{sourceBadges.length}}">
        <text class="src-badge src-{{item.key}}" wx:for="{{sourceBadges}}" wx:key="key">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- F1 直播聚合入口（isLive 时高亮置顶） -->
  <live-card wx:if="{{liveSources.length}}" sources="{{liveSources}}" live="{{isLive}}" event-name="{{name}}" />

  <!-- 赛事元数据 KPI Strip：所有字段常驻，缺失时显示 '--'，确保各赛事信息结构统一 -->
  <view class="kpi-strip">
    <view class="kpi-cell">
      <text class="kpi-label">奖金池</text>
      <view class="kpi-value-row">
        <text class="kpi-value accent {{metadata.prizePool ? '' : 'is-empty'}}">{{metadata.prizePool || '--'}}</text>
        <text wx:if="{{metadata.prizePool}}" class="kpi-unit">{{metadata.prizePoolCurrency || 'USD'}}</text>
      </view>
    </view>
    <view class="kpi-cell">
      <text class="kpi-label">地点</text>
      <text class="kpi-value {{metadata.location ? '' : 'is-empty'}}">{{metadata.location || '--'}}</text>
    </view>
    <view class="kpi-cell">
      <text class="kpi-label">赛制</text>
      <text class="kpi-value {{metadata.format ? '' : 'is-empty'}}">{{metadata.format || '--'}}</text>
    </view>
    <view class="kpi-cell">
      <text class="kpi-label">主办方</text>
      <text class="kpi-value {{metadata.organizer ? '' : 'is-empty'}}">{{metadata.organizer || '--'}}</text>
    </view>
    <view class="kpi-cell">
      <text class="kpi-label">参赛队</text>
      <text class="kpi-value {{metadata.participants ? '' : 'is-empty'}}">{{metadata.participants || '--'}}</text>
    </view>
    <view class="kpi-cell">
      <text class="kpi-label">状态</text>
      <text class="kpi-value {{metadata.status ? '' : 'is-empty'}}">{{metadata.status || '--'}}</text>
    </view>
    <view class="kpi-cell" style="grid-column: 1 / -1;">
      <text class="kpi-label">赛期</text>
      <text class="kpi-value">{{eventWindow ? eventWindow.fullRange : (metadata.startDate && metadata.endDate) ? (metadata.startDate + ' ~ ' + metadata.endDate) : '? ~ ?'}}</text>
    </view>
  </view>

  <!-- 赛事概述：自动摘要已有元数据，结构统一 -->
  <view class="overview-card" wx:if="{{metadata}}">
    <view class="overview-head">
      <t-icon name="info-circle" size="28rpx" color="#8a8f99" />
      <text class="overview-title">赛事概述</text>
    </view>
    <view class="overview-body">
      <text class="overview-name">{{displayName}}</text> 是 {{metadata.organizer || '主办方待定'}} 举办的 {{metadata.location ? '位于 ' + metadata.location + ' 的' : ''}} Dota 2 职业赛事。
      赛事采用 <text class="overview-highlight">{{metadata.format || '待定赛制'}}</text>，
      {{metadata.participants ? '共 ' + metadata.participants + ' 支参赛队伍' : '参赛队伍待定'}}。
      {{metadata.prizePool ? '奖金池为 ' + metadata.prizePool + ' ' + (metadata.prizePoolCurrency || 'USD') + '。' : '奖金池待定。'}}
      当前状态：<text class="overview-highlight">{{metadata.status || '未知'}}</text>。
    </view>
  </view>

  <!-- 赛事信息补充（curation 兜底字段，Liquipedia 禁用时尤其有用） -->
  <view class="meta-extra" wx:if="{{metadata && metadata.liquipediaSlug}}">
    <text class="meta-extra-label">Liquipedia：</text>
    <text class="meta-extra-link" bindtap="openLiquipedia" data-slug="{{metadata.liquipediaSlug}}">{{metadata.liquipediaSlug}}（点击复制链接）</text>
  </view>

  <!-- 三 Tab 切换（C 风格 Tournament Center） -->
  <view class="seg">
    <view class="seg-item {{tab === 'matches' ? 'active' : ''}}" bindtap="switchTab" data-key="matches">
      对阵<text class="seg-count">{{totalSeries}}</text>
    </view>
    <view class="seg-item {{tab === 'teams' ? 'active' : ''}}" bindtap="switchTab" data-key="teams">
      参赛队伍<text class="seg-count" wx:if="{{participantsList.length}}">{{participantsList.length}}</text>
    </view>
    <view class="seg-item {{tab === 'standings' ? 'active' : ''}}" bindtap="switchTab" data-key="standings">赛事排名</view>
  </view>

  <skeleton wx:if="{{loading}}" type="detail" />

  <view wx:elif="{{error}}" class="error-block">
    <t-empty icon="info-circle" description="{{error}}" />
    <view class="retry-wrap">
      <t-button theme="primary" size="medium" bindtap="retry">重试</t-button>
    </view>
  </view>

  <!-- ===== Tab 1: 对阵（系列赛聚合 · A 紧凑卡 + B 点缀） ===== -->
  <block wx:elif="{{tab === 'matches'}}">
    <!-- ★ v3 优化项26：cancelled 赛事提示 -->
    <view wx:if="{{cancelledNotice}}" class="cancelled-notice">
      <text>{{cancelledNotice}}</text>
    </view>
    <view wx:elif="{{series.length === 0}}" class="hint-card-enhanced">
      <view class="hint-title">该赛事暂无比赛数据</view>
      <view class="hint-desc">下拉刷新或稍后重试</view>
    </view>

    <block wx:for="{{series}}" wx:for-item="s" wx:for-index="si" wx:key="key">
      <!-- ===== 三段式分段分隔符（2026-07-28 新增） ===== -->
      <!-- LIVE 段分隔符：当 series 属于 LIVE 段（phase=live）且为该段第一项时显示
           修复 BUG：原用 si === 0 判定，当 LIVE 段为空时 UPCOMING 段第一个 series 索引为 0，会误显示 LIVE 分隔符
           修复：改用 si === 0 仅在 liveCount > 0 时才显示（即 LIVE 段非空） -->
      <view wx:if="{{s.phase === 'live' && si === 0 && liveCount > 0}}" class="phase-divider phase-divider-live">
        <view class="phase-divider-bar"></view>
        <text class="phase-divider-text">进行中 · {{liveCount}} 场</text>
      </view>
      <!-- UPCOMING 段分隔符：si === liveCount 时显示（即 LIVE 段结束后）
           ★ v3 优化项⑭：显示确定性标识 -->
      <view wx:if="{{s.phase === 'upcoming' && si === liveCount && upcomingCount > 0}}" class="phase-divider phase-divider-upcoming">
        <view class="phase-divider-bar"></view>
        <text class="phase-divider-text">即将开始 · {{upcomingCount}} 场</text>
      </view>
      <!-- RECENT 段分隔符：si === (liveCount + upcomingCount) 时显示，可点击折叠/展开
           修复 BUG：原用 !s.isUpcoming && !s.isLive 判定，但 isRecent 字段语义冲突
                  （isRecent 仅表示「2h 内结束」，超 2h 的已结束比赛 isRecent=false）
           修复：改用 s.phase === 'recent' 判定，phase 字段是 groupSeries 统一计算的状态 -->
      <view wx:if="{{s.phase === 'recent' && si === (liveCount + upcomingCount) && recentCount > 0}}"
            class="phase-divider phase-divider-recent"
            bindtap="toggleRecentCollapse">
        <view class="phase-divider-bar"></view>
        <text class="phase-divider-text">已结束 · {{recentCount}} 场</text>
        <text class="phase-divider-toggle">{{recentCollapsed ? '展开 ▾' : '折叠 ▴'}}</text>
      </view>

      <!-- ★ v3 优化项21：UPCOMING 日期子标题（每个日期组首条 series 前显示） -->
      <view wx:if="{{s.phase === 'upcoming' && s.showDateHeader && (!s.farFuture || showFarFuture)}}" class="date-sep">
        <text class="date-sep-text">{{s.dateLabel}}</text>
      </view>
      <!-- ★ v3 优化项⑮：RECENT 时间分层子标题（刚刚结束/今天/更早） -->
      <view wx:if="{{s.phase === 'recent' && s.showTimeLayerHeader && !recentCollapsed}}" class="time-layer-sep">
        <text class="time-layer-sep-text">{{s.timeLayerLabel}}</text>
      </view>
      <!-- ===== series-card（RECENT 段折叠隐藏 + 远期 UPCOMING 折叠隐藏） =====
           修复 BUG：原用 !s.isRecent 判定，但 isRecent 仅表示「2h 内结束」
                  超 2h 的已结束比赛 isRecent=false → !s.isRecent=true → 折叠时仍显示（不受控）
           修复：改用 s.phase !== 'recent' 判定，phase 字段统一表示状态
           class 同步修复：用 s.phase 替代 isLive/isUpcoming/isRecent，避免字段语义冲突
           ★ v3 优化项21：farFuture series 在 !showFarFuture 时隐藏 -->
      <view
        wx:if="{{(s.phase !== 'recent' || !recentCollapsed) && (!s.farFuture || showFarFuture)}}"
        class="series-card {{s.phase === 'live' ? 'series-live' : (s.phase === 'upcoming' ? 'series-upcoming' : (s.phase === 'recent' ? 'series-recent' : ''))}}"
      >
        <!-- 系列头部：队A · 大比分/开赛时间 · 队B -->
        <view class="series-head">
          <view class="series-team {{s.teamACls}}" catchtap="openTeam" data-id="{{s.radiantTeamId}}">
            <view class="series-team-logo {{s.teamALogoCls}}">
              <image-fallback src="{{s.radiantLogo}}" placeholder="{{s.radiantName ? s.radiantName[0] : '?'}}" />
            </view>
            <text class="series-team-name">{{s.radiantName || '天辉'}}</text>
            <text wx:if="{{s.seriesWinner === 'A'}}" class="series-win-badge">{{s.aForfeit ? '胜（判胜）' : '胜'}}</text>
          </view>
          <view class="series-score">
            <!-- 未开赛：显示开赛时间，不显示 0:0 比分 -->
            <block wx:if="{{s.phase === 'upcoming'}}">
              <text class="series-scheduled-time">{{s.scheduledTimeText}}</text>
            </block>
            <!-- 已结束但数据缺失：仅显示「已结束」，不强制标识胜负 -->
            <block wx:elif="{{s.seriesMissing}}">
              <text class="series-score-missing">已结束</text>
            </block>
            <block wx:else>
              <text class="series-score-num {{s.scoreACls}}">{{s.scoreA}}</text>
              <text class="series-score-sep">:</text>
              <text class="series-score-num {{s.scoreBCls}}">{{s.scoreB}}</text>
              <text wx:if="{{s.isDraw}}" class="series-draw-badge">平</text>
            </block>
          </view>
          <view class="series-team right {{s.teamBCls}}" catchtap="openTeam" data-id="{{s.direTeamId}}">
            <text class="series-team-name">{{s.direName || '夜魇'}}</text>
            <text wx:if="{{s.seriesWinner === 'B'}}" class="series-win-badge">{{s.bForfeit ? '胜（判胜）' : '胜'}}</text>
            <view class="series-team-logo {{s.teamBLogoCls}}">
              <image-fallback src="{{s.direLogo}}" placeholder="{{s.direName ? s.direName[0] : '?'}}" />
            </view>
          </view>
        </view>

        <!-- 系列元信息：BO标签 + 赛制说明 + LIVE/即将开始/时间 + 小圆点序列 -->
        <view class="series-meta">
          <view class="series-bo-group">
            <text class="series-bo-tag {{s.boTagCls}}">{{s.boType}}</text>
            <text class="series-bo-label">{{s.boLabel}}</text>
          </view>
          <text wx:if="{{s.phase === 'live'}}" class="series-live-tag">● LIVE</text>
          <!-- ★ v3 优化项⑬：LIVE 系列进度（仅 OpenDota 有 games 数据时显示） -->
          <text wx:if="{{s.phase === 'live' && s.liveProgress}}" class="series-live-progress">· {{s.liveProgress}}</text>
          <!-- ★ v3 优化项⑬+30：LIVE 已进行时长（OpenDota 和 Liquipedia 都可显示） -->
          <text wx:if="{{s.phase === 'live' && s.elapsedText}}" class="series-elapsed">· 已进行 {{s.elapsedText}}</text>
          <!-- 未开赛：显示具体开赛时间（替代倒计时标签） -->
          <text wx:elif="{{s.phase === 'upcoming'}}" class="series-upcoming-tag">{{s.scheduledTimeText}}</text>
          <text wx:if="{{s.phase === 'upcoming' && !s.confirmed}}" class="series-tbd-badge">❓ 待定</text>
          <!-- ★ v3 优化项⑭：焦点战标记（双方均为 S-Tier 战队） -->
          <text wx:if="{{s.phase === 'upcoming' && s.matchupQuality === 'focus'}}" class="series-focus-badge">⭐ 焦点战</text>
          <!-- 未开赛不显示小圆点序列（无 match 数据），仅显示开赛时间兜底 -->
          <view class="series-dots" wx:if="{{s.isMulti && s.phase !== 'upcoming'}}">
            <!-- 2026-07-28 修复小圆点颜色 BUG：用 aWin/bWin 判定（按 A/B 队归属），不用 radiantWin（按天辉/夜魇边）。
                 BO3/BO5 换边后，radiant_win=true 不等于 A 队赢；未结束（aWin/bWin 均 false）显示灰色。 -->
            <view wx:for="{{s.games}}" wx:for-item="g" wx:key="match_id" class="series-dot {{g.aWin ? 'a-win' : (g.bWin ? 'b-win' : 'pending')}}"></view>
          </view>
          <text wx:elif="{{s.phase !== 'upcoming'}}" class="series-time">{{s.games[0].time}}</text>
          <!-- ★ v3 优化项⑮：RECENT 总耗时（⏱ Xh Ym） -->
          <text wx:if="{{s.phase === 'recent' && s.totalDurationText}}" class="series-total-duration">⏱ {{s.totalDurationText}}</text>
        </view>

        <!-- 小场列表（单场也走此结构，BO1 仅显示时间行）
             未开赛不渲染小场列表（无 match_id 数据，避免 toggleGame/openMatch 异常） -->
        <view class="series-games" wx:if="{{s.phase !== 'upcoming'}}">
          <view
            class="series-game {{expandedGame === (si + '-' + gi) ? 'expanded' : ''}}"
            wx:for="{{s.games}}"
            wx:for-item="g"
            wx:for-index="gi"
            wx:key="match_id"
          >
            <view class="series-game-main" bindtap="toggleGame" data-idx="{{si + '-' + gi}}">
              <text class="series-game-idx" wx:if="{{s.isMulti}}">G{{gi + 1}}</text>
              <view class="series-game-mini" wx:if="{{s.isMulti}}">
                <text class="series-game-score {{g.radiantWin ? 'win' : 'lose'}}">{{g.radiantScore || 0}}</text>
                <text class="series-game-sep">:</text>
                <text class="series-game-score {{!g.radiantWin ? 'win' : 'lose'}}">{{g.direScore || 0}}</text>
              </view>
              <text class="series-game-time">{{g.time}}</text>
              <text class="series-game-duration" wx:if="{{g.duration}}">· {{g.duration}}</text>
              <text class="series-game-expand">{{expandedGame === (si + '-' + gi) ? '▴' : '▾'}}</text>
            </view>

            <!-- 展开态：英雄阵容 mini 卡 -->
            <view class="series-game-expand-box" wx:if="{{expandedGame === (si + '-' + gi)}}">
              <view wx:if="{{g.loadingDetail}}" class="expand-loading">加载英雄阵容中…</view>
              <block wx:elif="{{g.detail}}">
                <view class="mvp-row" wx:if="{{g.detail.mvp}}">
                  <text class="mvp-tag">★ MVP</text>
                  <text class="mvp-name">{{g.detail.mvp.name}}</text>
                  <text class="mvp-kda">{{g.detail.mvp.kda}} · GPM {{g.detail.mvp.gpm}}</text>
                </view>
                <view class="hero-lineup">
                  <view class="hero-side radiant">
                    <text class="hero-side-label">{{s.radiantName}}</text>
                    <view class="hero-icons">
                      <view class="hero-icon" wx:for="{{g.detail.radiantHeroes}}" wx:for-item="h" wx:key="*this">
                        <image wx:if="{{h.img}}" class="hero-icon-img" src="{{h.img}}" mode="aspectFill" lazy-load />
                        <view wx:else class="hero-icon-box">{{h.short}}</view>
                        <text class="hero-icon-kda">{{h.kda}}</text>
                      </view>
                    </view>
                  </view>
                  <view class="hero-side dire">
                    <text class="hero-side-label">{{s.direName}}</text>
                    <view class="hero-icons">
                      <view class="hero-icon" wx:for="{{g.detail.direHeroes}}" wx:for-item="h" wx:key="*this">
                        <image wx:if="{{h.img}}" class="hero-icon-img" src="{{h.img}}" mode="aspectFill" lazy-load />
                        <view wx:else class="hero-icon-box">{{h.short}}</view>
                        <text class="hero-icon-kda">{{h.kda}}</text>
                      </view>
                    </view>
                  </view>
                </view>
                <view class="report-link" catchtap="openMatch" data-id="{{g.match_id}}">
                  <text>查看完整战报（KDA 表 / GPM / XPM）</text>
                  <t-icon name="chevron-right" size="32rpx" color="#5b9bff" />
                </view>
              </block>
              <view wx:else class="expand-empty">暂无英雄阵容数据</view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- ★ v3 优化项21：远期赛程折叠入口（3天以上的 UPCOMING） -->
    <view wx:if="{{hasFarFuture}}" class="far-future-toggle" bindtap="toggleFarFuture">
      <text>{{showFarFuture ? '收起远期赛程 ▴' : '查看更远赛程 (' + farFutureCount + '场) ▾'}}</text>
    </view>
    <view class="loadmore" wx:if="{{hasMore}}">
      <t-button theme="light" size="medium" bindtap="appendPage" t-class="more-btn">加载更多</t-button>
    </view>
  </block>

  <!-- ===== Tab 2: 参赛队伍（方案 A 数据 + 方案 C 独立 Tab） ===== -->
  <block wx:elif="{{tab === 'teams'}}">
    <view wx:if="{{participantsList.length === 0}}" class="hint-card-enhanced">
      <view class="hint-title">暂无参赛队伍数据</view>
      <view class="hint-desc">可能赛事尚未开赛或未收录</view>
    </view>
    <view wx:else class="teams-card">
      <view class="teams-head">
        <text class="teams-title">参赛队伍</text>
        <text class="teams-count">{{participantsList.length}} 支</text>
      </view>
      <view class="teams-grid">
        <!-- 参赛队伍 chip：已公布可点击跳转，待公布灰色不可点击 -->
        <view class="team-chip {{item.status === 'TBD' || item.name === '待公布' ? 'is-pending' : ''}}" wx:for="{{participantsList}}" wx:for-index="pidx" wx:key="id" catchtap="openTeam" data-id="{{item.id}}">
          <view class="team-chip-logo">
            <image wx:if="{{item.logo}}" class="team-logo-img" src="{{item.logo}}" mode="aspectFill" lazy-load binderror="onParticipantLogoError" data-idx="{{pidx}}" />
            <text wx:else>{{item.name ? item.name[0] : '?'}}</text>
          </view>
          <view class="team-chip-info">
            <text class="team-chip-name">{{item.name}}</text>
            <view class="team-chip-tags">
              <text wx:if="{{item.group}}" class="team-chip-group group-{{item.group}}">{{item.group === 'Play-In' ? 'PI' : item.group}}</text>
              <text wx:if="{{item.region}}" class="team-chip-region">{{item.region}}</text>
            </view>
          </view>
          <text wx:if="{{item.status === 'invited'}}" class="team-chip-badge">直邀</text>
          <text wx:elif="{{item.status === 'qualifier'}}" class="team-chip-badge">预选</text>
        </view>
      </view>
    </view>
  </block>

  <!-- ===== Tab 3: 赛事排名（C 风格 · 仅已结束赛事展示） ===== -->
  <block wx:elif="{{tab === 'standings'}}">
    <view wx:if="{{standingsLoading}}" class="loading-row">聚合队伍排名中…</view>
    <view wx:elif="{{standings.length === 0}}" class="hint-card-enhanced">
      <view class="hint-title">暂无排名数据</view>
      <view class="hint-desc">赛事进行中或尚未结束，排名需比赛完成后聚合</view>
    </view>
    <view wx:else class="standings-card">
      <view class="stand-head">
        <text class="col-rank">名次</text>
        <text class="col-name">队伍</text>
        <text class="col-num">胜</text>
        <text class="col-num">负</text>
        <text class="col-num">胜率</text>
      </view>
      <view class="stand-row" wx:for="{{standings}}" wx:key="team_id" bindtap="openTeam" data-id="{{item.team_id}}">
        <text class="col-rank rank-{{index < 3 ? index + 1 : 'n'}}">
          <text wx:if="{{index === 0}}">🥇</text>
          <text wx:elif="{{index === 1}}">🥈</text>
          <text wx:elif="{{index === 2}}">🥉</text>
          <text wx:else>{{index + 1}}</text>
        </text>
        <text class="col-name">{{item.name}}</text>
        <text class="col-num kda">{{item.wins}}</text>
        <text class="col-num">{{item.losses}}</text>
        <text class="col-num {{item.winRate >= 60 ? 'wr-high' : (item.winRate >= 40 ? 'wr-mid' : 'wr-low')}}">{{item.winRate}}%</text>
      </view>
    </view>
  </block>
</view>
