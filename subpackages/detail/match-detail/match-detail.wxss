.container { padding: 24rpx; }

/* ===== 顶部胜方横幅（A 风格 hero-banner 局部） ===== */
.report-hero {
  position: relative;
  border-radius: var(--radius-xl, 24rpx);
  overflow: hidden;
  margin-bottom: 16rpx;
  height: 180rpx;
  background: linear-gradient(135deg, #1c232c 0%, #0e1116 100%);
}
.report-hero.radiant-win {
  background: linear-gradient(135deg, rgba(95, 211, 95, 0.18) 0%, #0e1116 80%);
  border-left: 6rpx solid #5fd35f;
}
.report-hero.dire-win {
  background: linear-gradient(135deg, rgba(232, 68, 59, 0.18) 0%, #0e1116 80%);
  border-left: 6rpx solid #e8443b;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  padding: 24rpx;
}
.hero-content { width: 100%; }
.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #f0f3f6;
  font-family: var(--font-display, -apple-system, sans-serif);
  margin-bottom: 8rpx;
}
.report-hero.radiant-win .hero-title { color: #5fd35f; }
.report-hero.dire-win .hero-title { color: #e8443b; }
.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  font-size: 24rpx;
  color: #c9d2dd;
  margin-top: 4rpx;
}

/* ===== MVP 卡 ===== */
.mvp-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(90deg, rgba(255, 207, 92, 0.12), rgba(255, 207, 92, 0.04));
  border: 1rpx solid rgba(255, 207, 92, 0.3);
  border-radius: var(--radius-lg, 16rpx);
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}
.mvp-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffcf5c;
  background: rgba(255, 207, 92, 0.2);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill, 999rpx);
}
.mvp-body { flex: 1; min-width: 200rpx; }
.mvp-hero {
  font-size: 24rpx;
  color: #ffcf5c;
  font-weight: 600;
}
.mvp-player {
  font-size: 30rpx;
  font-weight: 700;
  color: #f0f3f6;
  font-family: var(--font-display, -apple-system, sans-serif);
}
.mvp-stats {
  display: flex;
  gap: 16rpx;
  font-size: 22rpx;
  font-family: var(--font-mono, monospace);
  color: #c9d2dd;
  font-variant-numeric: tabular-nums;
}

/* ===== 数据来源行 ===== */
.source-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

/* ===== 区块标题（win/lose tag） ===== */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 20rpx 0 12rpx;
  padding: 0 4rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f0f3f6;
  font-family: var(--font-display, -apple-system, sans-serif);
}
.section-action {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  font-family: var(--font-mono, monospace);
}
.win-tag { color: var(--status-ongoing, #5fd35f); }
.lose-tag { color: #8a8f99; }

/* ===== KDA 表（HLTV 风格） ===== */
.kda-table {
  background: var(--card-bg, #161b22);
  border-radius: var(--radius-lg, 16rpx);
  overflow: hidden;
}
.kda-head, .kda-row {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
}
.kda-head {
  background: var(--card-bg-elevated, #1c232c);
  font-size: 22rpx;
  color: #8a8f99;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}
.kda-row {
  border-top: 1rpx solid #232a33;
  font-size: 26rpx;
  color: #f0f3f6;
  transition: background 120ms ease;
}
.kda-row-hover { background: var(--card-bg-elevated, #1c232c); }

.c-hero {
  width: 100rpx;
  flex-shrink: 0;
}
.hero-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--card-bg-inset, #0f141b);
  border: 1rpx solid #232a33;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #c9d2dd;
}
.hero-box.win-side {
  border-color: rgba(95, 211, 95, 0.4);
  background: rgba(95, 211, 95, 0.08);
}

.c-player {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 8rpx;
}
.c-kda {
  width: 140rpx;
  text-align: center;
  font-family: var(--font-mono, monospace);
  font-variant-numeric: tabular-nums;
  color: #c9d2dd;
}
.c-net {
  width: 100rpx;
  text-align: right;
  font-family: var(--font-numeric, "SF Pro Display", sans-serif);
  font-variant-numeric: tabular-nums;
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #6b7280;
  padding: 24rpx 0 8rpx;
}
.muted { color: #6b7280; }

/* ===== 通用 ===== */
.error-block { display: flex; flex-direction: column; align-items: center; }
.retry-wrap { margin-top: 16rpx; }

/* ===== 出装栏 ===== */
.items-block {
  margin: 8rpx 0 24rpx;
  padding: 12rpx 16rpx;
  background: #0f141b;
  border-radius: 12rpx;
  border: 1rpx solid #1f262f;
}
.items-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 0;
}
.items-hero {
  font-size: 20rpx;
  font-weight: 600;
  color: #5fd3a8;
  min-width: 72rpx;
  text-align: center;
  background: #161b22;
  border-radius: 6rpx;
  padding: 4rpx 6rpx;
}
.items-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  flex: 1;
  align-items: center;
}
.item-icon {
  width: 44rpx;
  height: 32rpx;
  border-radius: 6rpx;
  border: 1rpx solid #2a323d;
  background: #161b22;
}
.items-empty { font-size: 22rpx; color: #4a525d; }

/* ===== 经济/经验差曲线（V4 折线图卡片） ===== */
.chart-card {
  margin: 8rpx 0 32rpx;
  padding: 20rpx 16rpx 16rpx;
  background: #0f141b;
  border-radius: 12rpx;
  border: 1rpx solid #1f262f;
}
.chart-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 8rpx;
  padding: 0 4rpx;
}
.lg-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #c9d2dd;
}
.lg-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}
.chart-axis {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #5b626d;
  text-align: center;
}

