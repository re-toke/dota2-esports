.container { padding: var(--space-3); }

/* ===== 顶部胜方横幅（A 风格 hero-banner 局部） ===== */
.report-hero {
  position: relative;
  border-radius: var(--radius-xl, 24rpx);
  overflow: hidden;
  margin-bottom: var(--space-2);
  height: 180rpx;
  background: linear-gradient(135deg, #222226 0%, #0d0d0d 100%);
}
.report-hero.radiant-win {
  background: linear-gradient(135deg, rgba(95, 211, 95, 0.18) 0%, #0d0d0d 80%);
  border-left: 6rpx solid var(--radiant);
}
.report-hero.dire-win {
  background: linear-gradient(135deg, rgba(232, 68, 59, 0.18) 0%, #0d0d0d 80%);
  border-left: 6rpx solid var(--dire);
}
.hero-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  padding: var(--space-3);
}
.hero-content { width: 100%; }
.hero-title {
  font-size: var(--fs-mega);
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--text-1);
  font-family: var(--font-display, -apple-system, sans-serif);
  margin-bottom: var(--space-1);
}
.report-hero.radiant-win .hero-title { color: var(--radiant); }
.report-hero.dire-win .hero-title { color: var(--dire); }
.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1-5);
  font-size: var(--fs-body);
  color: #c9d2dd;
  margin-top: var(--space-0-5);
}

/* ===== MVP 卡 ===== */
.mvp-card {
  display: flex;
  align-items: center;
  gap: var(--space-1-5);
  background: linear-gradient(90deg, rgba(255, 207, 92, 0.12), rgba(255, 207, 92, 0.04));
  border: 1rpx solid rgba(255, 207, 92, 0.3);
  border-radius: var(--radius-lg, 16rpx);
  padding: var(--space-2) var(--space-2-5);
  margin-bottom: var(--space-2);
  flex-wrap: wrap;
}
.mvp-tag {
  font-size: var(--fs-caption);
  font-weight: 700;
  color: #ffcf5c;
  background: rgba(255, 207, 92, 0.2);
  padding: var(--space-0-5) 14rpx;
  border-radius: var(--radius-pill, 999rpx);
}
.mvp-body { flex: 1; min-width: 200rpx; }
.mvp-hero {
  font-size: var(--fs-body);
  color: #ffcf5c;
  font-weight: 600;
}
.mvp-player {
  font-size: var(--fs-emphasis);
  font-weight: 700;
  color: var(--text-1);
  font-family: var(--font-display, -apple-system, sans-serif);
}
.mvp-stats {
  display: flex;
  gap: var(--space-2);
  font-size: var(--fs-caption);
  font-family: var(--font-mono, monospace);
  color: #c9d2dd;
  font-variant-numeric: tabular-nums;
}

/* ===== 数据来源行 ===== */
.source-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-2);
}

/* ===== 区块标题（win/lose tag） ===== */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: var(--space-2-5) 0 var(--space-1-5);
  padding: 0 var(--space-0-5);
}
.section-title {
  font-size: var(--fs-emphasis);
  font-weight: 700;
  color: var(--text-1);
  font-family: var(--font-display, -apple-system, sans-serif);
}
.section-action {
  font-size: var(--fs-caption);
  letter-spacing: 1rpx;
  font-family: var(--font-mono, monospace);
}
.win-tag { color: var(--status-ongoing, #5fd35f); }
.lose-tag { color: var(--text-2); }

/* ===== KDA 表（HLTV 风格） ===== */
.kda-table {
  background: var(--card-bg, #1a1a1e);
  border-radius: var(--radius-lg, 16rpx);
  overflow: hidden;
}
.kda-head, .kda-row {
  display: flex;
  align-items: center;
  padding: 14rpx var(--space-2);
}
.kda-head {
  background: var(--card-bg-elevated, #222226);
  font-size: var(--fs-caption);
  color: var(--text-2);
  letter-spacing: 1rpx;
  text-transform: uppercase;
}
.kda-row {
  border-top: 1rpx solid #262628;
  font-size: var(--fs-label);
  color: var(--text-1);
  transition: background 120ms ease;
}
.kda-row-hover { background: var(--card-bg-elevated, #222226); }

.c-hero {
  width: 100rpx;
  flex-shrink: 0;
}
.hero-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm, 8rpx);
  background: var(--card-bg-inset, #131316);
  border: 1rpx solid #262628;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-micro);
  font-weight: 700;
  color: #c9d2dd;
}
/* 英雄头像图片（Steam CDN _sb.png，mode=aspectFill 裁切填满） */
.hero-img {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm, 8rpx);
  border: 1rpx solid #262628;
  background: var(--card-bg-inset, #131316);
}
.hero-box.win-side {
  border-color: rgba(95, 211, 95, 0.4);
  background: rgba(95, 211, 95, 0.08);
}

.c-player {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 var(--space-1);
}
.c-kda {
  width: 140rpx;
  text-align: center;
  font-family: var(--font-mono, monospace);
  font-variant-numeric: tabular-nums;
  color: #c9d2dd;
}
.c-net {
  width: 100rpx;
  text-align: right;
  font-family: var(--font-numeric, "SF Pro Display", sans-serif);
  font-variant-numeric: tabular-nums;
}

.footer-tip {
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--text-3);
  padding: var(--space-3) 0 var(--space-1);
}
.muted { color: var(--text-3); }

/* ===== 通用 ===== */
.error-block { display: flex; flex-direction: column; align-items: center; }
.retry-wrap { margin-top: var(--space-2); }

/* ===== 出装栏 ===== */
.items-block {
  margin: var(--space-1) 0 var(--space-3);
  padding: var(--space-1-5) var(--space-2);
  background: #131316;
  border-radius: var(--radius-md);
  border: 1rpx solid #1f262f;
}
.items-row {
  display: flex;
  align-items: center;
  gap: var(--space-1-5);
  padding: 6rpx 0;
}
.items-hero {
  font-size: var(--fs-micro);
  font-weight: 600;
  color: #5fd3a8;
  min-width: 72rpx;
  text-align: center;
  background: #1a1a1e;
  border-radius: var(--radius-sm);
  padding: var(--space-0-5) 6rpx;
}
.items-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  flex: 1;
  align-items: center;
}
.item-icon {
  width: 44rpx;
  height: 32rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid #2a323d;
  background: #1a1a1e;
}
.item-slot {
  display: inline-flex;
  align-items: center;
}
.item-fallback {
  font-size: var(--fs-badge);
  line-height: 32rpx;
  color: #4a525d;
  background: #1a1a1e;
  border: 1rpx solid #2a323d;
  border-radius: var(--radius-sm);
  padding: 0 6rpx;
  max-width: 96rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.items-empty { font-size: var(--fs-caption); color: #4a525d; }

/* ===== 经济/经验差曲线（V4 折线图卡片） ===== */
.chart-card {
  margin: var(--space-1) 0 var(--space-4);
  padding: var(--space-2-5) var(--space-2) var(--space-2);
  background: #131316;
  border-radius: var(--radius-md);
  border: 1rpx solid #1f262f;
}
.chart-legend {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2-5);
  margin-top: var(--space-1);
  padding: 0 var(--space-0-5);
}
.lg-item {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--fs-caption);
  color: #c9d2dd;
}
.lg-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-xs);
}
.chart-axis {
  margin-top: 10rpx;
  font-size: var(--fs-micro);
  color: var(--text-4);
  text-align: center;
}

/* ===== 5.1 内嵌对战 CTA ===== */
.h2h-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: var(--space-2) 0;
  padding: 22rpx var(--space-3);
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, rgba(200, 169, 81, 0.16) 0%, #1a1a1e 100%);
  border: 1rpx solid rgba(200, 169, 81, 0.35);
}
.h2h-cta--hover { opacity: 0.82; }
.h2h-cta-left { display: flex; flex-direction: column; }
.h2h-cta-title {
  font-size: var(--fs-emphasis);
  font-weight: 700;
  color: #e8eef6;
}
.h2h-cta-sub {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  color: var(--text-2);
}
.h2h-cta-arrow {
  font-size: var(--fs-mega);
  color: #C8A951;
  font-weight: 700;
  line-height: 1;
}

