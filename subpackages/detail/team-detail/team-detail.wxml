<view class="container">
  <!-- 头部先行渲染：loading 期间也显示，避免首屏完全被骨架屏阻塞 -->
  <block wx:if="{{!error}}">
    <view class="head">
      <view class="head-logo">
        <image-fallback src="{{team.logo}}" placeholder="{{team.tag || '?'}}" />
      </view>
      <view class="head-info">
        <view class="title">{{team.name || '加载中…'}}</view>
        <view class="head-meta">
          <text wx:if="{{teamPriority && teamPriority.isHighPriority}}" class="priority-badge priority-{{teamPriority.isTI ? 'ti' : 's'}}">{{teamPriority.label}}</text>
          <text wx:if="{{team.tag}}" class="tag-tag">#{{team.tag}}</text>
          <text wx:if="{{team.country}}" class="country-badge">{{team.country}}</text>
          <text wx:if="{{team.lastMatch}}" class="sub">· 最近比赛 {{team.lastMatch}}</text>
        </view>
      </view>
      <view class="star-btn" catchtap="toggleFollow">
        <t-icon name="star" size="48rpx" color="{{followed ? '#ffcf5c' : '#5b626d'}}" />
      </view>
    </view>
  </block>

  <t-skeleton wx:if="{{loading}}" theme="paragraph" loading="{{true}}" />

  <view wx:elif="{{error}}" class="error-block">
    <t-empty icon="info-circle" description="{{error}}" />
    <view class="retry-wrap">
      <t-button theme="primary" size="medium" bindtap="retry">重试</t-button>
    </view>
  </view>

  <block wx:else>
    <!-- 4.1 关键指标锚点卡（单体档案模式）：大字号胜率 + 战绩/评级/最近 -->
    <anchor-card
      title="{{anchorTitle}}"
      bigValue="{{anchorBigValue}}"
      bigLabel="{{anchorBigLabel}}"
      metaList="{{anchorMeta}}"
    />

    <!-- KPI Strip：战绩核心指标（C 风格 · 多列对齐） -->
    <view class="kpi-strip" wx:if="{{team}}">
      <view class="kpi-cell" wx:if="{{team.rating}}">
        <text class="kpi-label">评分</text>
        <text class="kpi-value accent">{{team.rating}}</text>
      </view>
      <view class="kpi-cell">
        <text class="kpi-label">胜</text>
        <text class="kpi-value kpi-win">{{team.wins}}</text>
      </view>
      <view class="kpi-cell">
        <text class="kpi-label">负</text>
        <text class="kpi-value kpi-lose">{{team.losses}}</text>
      </view>
      <view class="kpi-cell">
        <text class="kpi-label">胜率</text>
        <view class="kpi-value-row">
          <text class="kpi-value">{{team.winRate}}</text>
        </view>
      </view>
    </view>

    <!-- 数据溯源合并区（C 风格） -->
    <view class="source-section" wx:if="{{sourceBadges.length || memberQuality || logoSource}}">
      <view class="source-section-head">
        <text class="source-section-title">数据溯源</text>
        <text wx:if="{{updatedLabel}}" class="fresh-label">{{updatedLabel}}</text>
      </view>
      <view class="source-section-body">
        <!-- 成员交叉验证可信度 -->
        <view wx:if="{{memberQuality}}" class="quality-pill quality-{{memberQuality.confidence}}">
          <text class="q-dot"></text>
          <text class="q-text">成员可信度：{{memberQuality.text}}</text>
          <text class="q-src">· {{memberQuality.verifiedCount}}/{{memberQuality.total}} 已核实</text>
        </view>
        <!-- 来源徽标网格 -->
        <view class="source-grid" wx:if="{{sourceBadges.length}}">
          <text class="src-badge src-{{item.key}}" wx:for="{{sourceBadges}}" wx:key="key">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 成员：现役 / 历史 分段控件 -->
    <view class="seg">
      <view class="seg-item {{tab === 'current' ? 'active' : ''}}" bindtap="onTab" data-key="current">现役成员</view>
      <view class="seg-item {{tab === 'history' ? 'active' : ''}}" bindtap="onTab" data-key="history">历史成员</view>
    </view>

    <block wx:if="{{tab === 'current'}}">
      <view wx:if="{{current.length === 0}}" class="hint-card-enhanced">
        <view class="hint-title">暂无现役成员</view>
        <view class="hint-desc">数据源尚未返回当前活跃阵容，可下拉刷新重试</view>
      </view>
      <view
        class="member"
        wx:for="{{current}}"
        wx:key="account_id"
        hover-class="member-hover"
      >
        <view class="member-avatar">
          <image-fallback src="{{item.avatar}}" placeholder="{{item.name ? item.name[0] : '?'}}" round="{{true}}" />
        </view>
        <view class="member-body">
          <view class="member-name-row">
            <text class="member-name">{{item.name}}</text>
            <text wx:if="{{item.verified}}" class="verify-badge">✓ 多源核实</text>
          </view>
          <view class="stat-row">
            <text class="stat-label">{{item.games}} 场</text>
            <view class="stat-bar">
              <view class="stat-bar-fill" style="width:{{item.winPct}}%;"></view>
            </view>
            <text class="stat-value win">{{item.winRate}}</text>
          </view>
        </view>
        <t-icon name="chevron-right" size="40rpx" color="#5b626d" />
      </view>
    </block>

    <block wx:else>
      <view wx:if="{{history.length === 0}}" class="hint-card-enhanced">
        <view class="hint-title">暂无历史成员</view>
        <view class="hint-desc">该战队暂无历史阵容数据</view>
      </view>
      <view
        class="member"
        wx:for="{{history}}"
        wx:key="account_id"
        hover-class="member-hover"
      >
        <view class="member-avatar">
          <image-fallback src="{{item.avatar}}" placeholder="{{item.name ? item.name[0] : '?'}}" round="{{true}}" />
        </view>
        <view class="member-body">
          <view class="member-name-row">
            <text class="member-name">{{item.name}}</text>
            <text wx:if="{{item.verified}}" class="verify-badge">✓ 多源核实</text>
          </view>
          <view class="stat-row">
            <text class="stat-label">{{item.games}} 场</text>
            <view class="stat-bar">
              <view class="stat-bar-fill" style="width:{{item.winPct}}%;"></view>
            </view>
            <text class="stat-value win">{{item.winRate}}</text>
          </view>
        </view>
        <t-icon name="chevron-right" size="40rpx" color="#5b626d" />
      </view>
    </block>

    <!-- 近期战绩 -->
    <view class="section-header">
      <text class="section-title">近期战绩</text>
      <text class="section-action" wx:if="{{matches.length}}">{{matches.length}} / {{totalMatches}}</text>
    </view>
    <view wx:if="{{matches.length === 0 && !matchLoading}}" class="hint-card-enhanced">
      <view class="hint-title">暂无比赛数据</view>
      <view class="hint-desc">该战队近期暂无比赛记录</view>
    </view>

    <!-- vs-card 风格比赛卡：本队 vs 对手 + 比分 + 时长 -->
    <view
      class="vs-card {{item.won ? 'radiant-win' : 'dire-win'}}"
      wx:for="{{matches}}"
      wx:key="match_id"
      bindtap="openOpp"
      data-id="{{item.oppId}}"
    >
      <view class="vs-side home">
        <view class="vs-team">
          <view class="vs-team-logo vs-team-logo-placeholder">{{team.tag ? team.tag[0] : '?'}}</view>
          <text class="vs-team-name">{{team.name}}</text>
          <text wx:if="{{item.won}}" class="vs-win-badge">胜</text>
        </view>
        <text class="vs-score {{item.won ? 'win' : 'lose'}}">{{item.ownScore}}</text>
      </view>
      <view class="vs-center">
        <text class="vs-vs">{{item.won ? 'WIN' : 'LOSS'}}</text>
        <text class="vs-meta">{{item.time}}</text>
        <text class="vs-meta" wx:if="{{item.duration}}">{{item.duration}}</text>
        <text class="vs-meta" wx:if="{{item.league}}">{{item.displayName || item.league}}</text>
      </view>
      <view class="vs-side away">
        <view class="vs-team">
          <view class="vs-team-logo vs-team-logo-placeholder">{{item.oppTag}}</view>
          <text class="vs-team-name">{{item.oppName}}</text>
          <text wx:if="{{!item.won}}" class="vs-win-badge">胜</text>
        </view>
        <text class="vs-score {{item.won ? 'lose' : 'win'}}">{{item.oppScore}}</text>
      </view>
    </view>

    <view class="loadmore" wx:if="{{matchHasMore}}">
      <t-button theme="light" size="medium" bindtap="appendMatches" t-class="more-btn">加载更多</t-button>
    </view>

    <!-- 对战记录（H2H）：按对手聚合胜负，点击进入双方对战详情页（spec B 入口） -->
    <view class="section-header" wx:if="{{h2hList.length > 0}}" style="margin-top: 32rpx;">
      <text class="section-title">对战记录</text>
      <text class="section-action muted">优先展示 S-Tier / TI 赛事</text>
    </view>
    <view class="h2h-list" wx:if="{{h2hList.length > 0}}">
      <view class="h2h-row {{item.topTierLabel ? 'h2h-row-priority' : ''}}" wx:for="{{h2hList}}" wx:key="oppId" bindtap="openH2h" data-a="{{teamId}}" data-b="{{item.oppId}}" hover-class="h2h-row-hover">
        <view class="h2h-opp">
          <view class="h2h-opp-tag">{{item.oppTag}}</view>
          <text class="h2h-opp-name">{{item.oppName}}</text>
          <text wx:if="{{item.topTierLabel}}" class="h2h-tier-badge">{{item.topTierLabel}}</text>
        </view>
        <view class="h2h-record">
          <text class="h2h-win">{{item.wins}}</text>
          <text class="h2h-sep">-</text>
          <text class="h2h-lose">{{item.losses}}</text>
        </view>
        <view class="h2h-meta">
          <text class="h2h-games">{{item.games}} 场<text wx:if="{{item.sTierGames > 0}}" class="h2h-stier">· {{item.sTierGames}} S级</text></text>
          <text class="h2h-winrate {{item.winRate >= 50 ? 'positive' : 'negative'}}">{{item.winRate}}%</text>
        </view>
      </view>
    </view>
  </block>
</view>
