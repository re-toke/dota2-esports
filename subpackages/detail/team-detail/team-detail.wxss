.container { padding: var(--space-3); }

/* ===== 头部（C 风格 · logo + 名称 + 关注） ===== */
.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}
.head-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md, 12rpx);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--card-bg-inset, #F1F3F5);
  border: 1rpx solid var(--td-border-level-1-color);
}
.head-info { flex: 1; min-width: 0; }
.head-info .title {
  font-size: var(--fs-display);
  font-weight: 700;
  color: var(--text-1);
  line-height: var(--lh-tight);
  font-family: var(--font-display, -apple-system, sans-serif);
}
.head-meta {
  display: flex;
  align-items: center;
  gap: var(--space-1-5);
  margin-top: var(--space-1);
  flex-wrap: wrap;
}
.head-meta .sub { font-size: var(--fs-body); color: var(--text-2); }
.tag-tag {
  font-size: var(--fs-caption);
  color: var(--text-2);
  background: var(--td-bg-color-component);
  border: 1rpx solid var(--td-border-level-1-color);
  border-radius: var(--radius-xs);
  padding: 2rpx var(--space-1);
  font-family: var(--font-mono, monospace);
}
.country-badge {
  font-size: var(--fs-micro);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-pill, 999rpx);
  background: var(--radiant-soft);
  color: var(--radiant);
  border: 1rpx solid rgba(95, 211, 95, 0.3);
  font-family: var(--font-mono, monospace);
  letter-spacing: 1rpx;
}
.star-btn { padding: var(--space-0-5) 0 var(--space-0-5) var(--space-2); flex-shrink: 0; min-width: 88rpx; min-height: 88rpx; display: inline-flex; align-items: center; justify-content: flex-start; box-sizing: border-box; }

/* ===== KPI Strip 局部样式（win/lose 颜色） ===== */
.kpi-win { color: var(--status-ongoing, #5fd35f); }
.kpi-lose { color: var(--dire); }

/* ===== 数据溯源合并区（C 风格 · 与 league-detail 一致） ===== */
.source-section {
  background: var(--card-bg-elevated, #F1F3F5);
  border-radius: var(--radius-lg, 16rpx);
  padding: var(--space-2-5) var(--space-3);
  margin-bottom: var(--space-2);
}
.source-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-1-5);
}
.source-section-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.source-section-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-1-5);
}

/* 可信度 pill */
.quality-pill {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--fs-body);
  padding: 6rpx var(--space-2);
  border-radius: var(--radius-pill, 999rpx);
  align-self: flex-start;
}
.quality-pill .q-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.quality-pill .q-text { font-weight: 600; }
.quality-pill .q-src { font-size: var(--fs-caption); opacity: 0.85; }
.quality-high { background: rgba(95, 211, 168, 0.12); color: var(--status-verified); }
.quality-high .q-dot { background: var(--status-verified); }
.quality-medium { background: rgba(255, 207, 92, 0.12); color: var(--dota-gold-strong); }
.quality-medium .q-dot { background: var(--amber-bright); }
.quality-low { background: rgba(107, 114, 128, 0.16); color: var(--text-2); }
.quality-low .q-dot { background: var(--text-2); }

/* ===== 分段控件 ===== */
.seg {
  display: flex;
  background: var(--card-bg-inset, #F1F3F5);
  border-radius: var(--radius-md, 12rpx);
  padding: var(--space-0-5);
  margin: var(--space-2) 0;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: var(--fs-label);
  color: var(--text-2);
  border-radius: var(--radius-sm);
  transition: background 120ms ease, color 120ms ease;
}
.seg-item.active {
  background: var(--card-bg-elevated, #F1F3F5);
  color: var(--text-1);
  font-weight: 600;
}

/* ===== 队员卡片 ===== */
.member {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  background: var(--card-bg, #FFFFFF);
  border-radius: var(--radius-lg, 16rpx);
  padding: 18rpx var(--space-2-5);
  margin-bottom: var(--space-1-5);
  transition: background 120ms ease;
}
.member-hover {
  background: var(--card-bg-elevated, #F1F3F5);
}
.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--card-bg-inset, #F1F3F5);
  border: 1rpx solid var(--td-border-level-1-color);
}
.member-body { flex: 1; min-width: 0; }
.member-name-row {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  margin-bottom: 6rpx;
}
.member-name {
  font-size: var(--fs-subhead);
  color: var(--text-1);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 多源核实徽标 */
.verify-badge {
  font-size: var(--fs-micro);
  color: var(--status-verified, #5fd3a8);
  background: rgba(30, 200, 150, 0.14);
  border-radius: var(--radius-sm);
  padding: 2rpx 10rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* vs-team-logo-placeholder 在 app.wxss 没有定义，这里补充 */
.vs-team-logo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--text-2);
  background: var(--card-bg-inset, #F1F3F5);
  border: 1rpx solid var(--td-border-level-1-color);
}

/* ===== 通用 ===== */
.more-btn { width: 100%; }
.loadmore { display: flex; justify-content: center; margin: var(--space-3) 0 var(--space-1); }
.error-block { display: flex; flex-direction: column; align-items: center; }
.retry-wrap { margin-top: var(--space-2); }

/* ===== 对战记录 H2H ===== */
.h2h-list {
  margin-top: var(--space-1-5);
  background: var(--td-bg-color-container);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.h2h-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2-5) var(--space-3);
  border-bottom: 1rpx solid var(--td-border-level-1-color);
}
.h2h-row:last-child { border-bottom: none; }
.h2h-row-hover { background: var(--td-bg-color-component); }
.h2h-opp {
  display: flex;
  align-items: center;
  gap: var(--space-1-5);
  flex: 1;
  min-width: 0;
}
.h2h-opp-tag {
  font-size: var(--fs-micro);
  font-weight: 700;
  color: var(--status-verified);
  background: var(--td-bg-color-component);
  border-radius: var(--radius-sm);
  padding: var(--space-0-5) var(--space-1);
  min-width: 56rpx;
  text-align: center;
}
.h2h-opp-name {
  font-size: var(--fs-label);
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.h2h-record {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  font-size: var(--fs-emphasis);
  font-weight: 700;
  min-width: 100rpx;
  justify-content: center;
}
.h2h-win { color: var(--radiant); }
.h2h-lose { color: var(--status-negative); }
.h2h-sep { color: var(--text-4); }
.h2h-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--space-0-5);
  min-width: 90rpx;
}
.h2h-games { font-size: var(--fs-caption); color: var(--text-3); }
.h2h-winrate { font-size: var(--fs-body); font-weight: 600; }
.h2h-winrate.positive { color: var(--radiant); }
.h2h-winrate.negative { color: var(--status-negative); }

/* S-Tier / TI 优先级徽标（头部） */
.priority-badge {
  display: inline-block;
  padding: 2rpx var(--space-1-5);
  border-radius: var(--radius-sm);
  font-size: var(--fs-micro);
  font-weight: 600;
  margin-right: var(--space-1);
}
.priority-badge.priority-ti {
  background: rgba(200, 169, 81, 0.18);
  color: var(--dota-gold-strong);
  border: 1rpx solid rgba(200, 169, 81, 0.4);
}
.priority-badge.priority-s {
  background: var(--tier-s-soft);
  color: var(--dota-gold-strong);
  border: 1rpx solid var(--tier-s-line);
}

/* H2H 卡片优先级样式（有 S 级以上对战记录时高亮） */
.h2h-row-priority {
  background: rgba(255, 207, 92, 0.04);
}
.h2h-tier-badge {
  display: inline-block;
  padding: 1rpx var(--space-1);
  border-radius: var(--radius-sm);
  font-size: var(--fs-badge);
  font-weight: 600;
  margin-left: var(--space-1);
  background: rgba(255, 207, 92, 0.15);
  color: var(--dota-gold-strong);
  border: 1rpx solid rgba(255, 207, 92, 0.3);
}
.h2h-stier {
  color: var(--dota-gold-strong);
  font-weight: 500;
  margin-left: var(--space-0-5);
}
