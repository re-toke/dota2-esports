/* pages/privacy/privacy.wxss */
.container {
  padding: 32rpx 32rpx 64rpx;
  background: #0e1116;
  min-height: 100vh;
  color: #e6edf3;
}

.header {
  margin-bottom: 40rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #232a33;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #5fd35f;
  margin-bottom: 12rpx;
}
.meta {
  font-size: 24rpx;
  color: #6b7280;
}

.section {
  margin-bottom: 36rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e6edf3;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #5fd35f;
}
.section-body {
  font-size: 26rpx;
  color: #9aa4b2;
  line-height: 1.7;
  margin-bottom: 16rpx;
}
.para {
  margin-bottom: 12rpx;
}
.list-item {
  font-size: 26rpx;
  color: #7d8794;
  line-height: 1.8;
  padding-left: 16rpx;
}
.em {
  color: #5fd3a8;
  font-weight: 500;
}

.footer {
  margin-top: 48rpx;
  padding: 24rpx;
  background: #161b22;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.footer-text {
  font-size: 22rpx;
  color: #5b626d;
  line-height: 1.6;
  flex: 1;
}
