/* pages/privacy/privacy.wxss */
.container {
  padding: var(--space-4) var(--space-4) 64rpx;
  background: #0d0d0d;
  min-height: 100vh;
  color: #e6edf3;
}

.header {
  margin-bottom: var(--space-5);
  padding-bottom: var(--space-3);
  border-bottom: 1rpx solid #262628;
}
.title {
  font-size: var(--fs-mega);
  font-weight: 700;
  color: var(--dota-gold);
  margin-bottom: var(--space-1-5);
}
.meta {
  font-size: var(--fs-body);
  color: var(--text-3);
}

.section {
  margin-bottom: 36rpx;
}
.section-title {
  font-size: var(--fs-emphasis);
  font-weight: 600;
  color: #e6edf3;
  margin-bottom: var(--space-2);
  padding-left: var(--space-2);
  border-left: 6rpx solid var(--dota-gold);
}
.section-body {
  font-size: var(--fs-label);
  color: var(--text-2);
  line-height: var(--lh-loose);
  margin-bottom: var(--space-2);
}
.para {
  margin-bottom: var(--space-1-5);
}
.list-item {
  font-size: var(--fs-label);
  color: var(--text-2);
  line-height: var(--lh-loose);
  padding-left: var(--space-2);
}
.em {
  color: #5fd3a8;
  font-weight: 500;
}

.footer {
  margin-top: var(--space-6);
  padding: var(--space-3);
  background: #1a1a1e;
  border-radius: var(--radius-md);
  display: flex;
  align-items: flex-start;
  gap: var(--space-1-5);
}
.footer-text {
  font-size: var(--fs-caption);
  color: var(--text-4);
  line-height: var(--lh-relaxed);
  flex: 1;
}
