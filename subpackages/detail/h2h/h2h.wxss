.container { padding: var(--space-3); }

/* ===== VS 头部 ===== */
.vs-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}
.vs-team {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-1-5);
}
.vs-team--away { /* 客队与主队对称 */ }
.vs-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-lg);
  background: var(--card-bg-inset);
  border: 1rpx solid var(--td-border-level-1-color, #E5E7EB);
}
.vs-logo--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-heading);
  font-weight: 800;
  color: var(--dota-gold, #C8A951);
}
.vs-name {
  font-size: var(--fs-label);
  font-weight: 600;
  color: var(--text-1);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  var(--td-bg-color-container)-space: nowrap;
  max-width: 100%;
}
/* 3.4 队名 + 核实标记行：flex 布局，队名溢出省略 + 标记常驻 */
.vs-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  max-width: 100%;
}
.vs-name-row .vs-name {
  flex: 0 1 auto;
  min-width: 0;
  max-width: 70%;
}
.vs-verified {
  flex-shrink: 0;
  font-size: var(--fs-badge);
  font-weight: 600;
  color: var(--h2h-a);
  background: var(--h2h-a-soft);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-pill);
  line-height: var(--lh-relaxed);
  border: 1rpx solid rgba(45, 212, 167, 0.35);
}
.vs-mid {
  flex-shrink: 0;
  width: 72rpx;
  text-align: center;
}
.vs-symbol {
  font-size: var(--fs-emphasis);
  font-weight: 800;
  letter-spacing: 1rpx;
  color: var(--text-3);
}

/* ===== 胜负条形区 ===== */
.h2h-bar-block {
  background: var(--card-bg, #FFFFFF);
  border-radius: var(--radius-lg, 16rpx);
  padding: var(--space-3-5) var(--space-3);
  margin-bottom: var(--space-3);
}
.h2h-bar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.h2h-bar-row:last-of-type { margin-bottom: 0; margin-top: 10rpx; }
.h2h-side {
  font-size: var(--fs-body);
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  var(--td-bg-color-container)-space: nowrap;
  max-width: 60%;
}
.h2h-num {
  font-size: var(--fs-body);
  font-weight: 700;
  font-family: var(--font-numeric, sans-serif);
}
.h2h-num--a { color: var(--h2h-a, #2DD4A7); }
.h2h-num--b { color: var(--h2h-b, #F25C54); }

/* 单条双向双色条形（spec B.3：左主队 / 右客队，按 p 分割） */
.h2h-bar {
  display: flex;
  width: 100%;
  height: 28rpx;
  border-radius: var(--radius-pill, 999rpx);
  overflow: hidden;
  background: var(--card-bg-inset, #F1F3F5);
}
.h2h-bar-fill {
  height: 100%;
  transition: width 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.h2h-bar-fill--a {
  background: var(--h2h-a, #2DD4A7);
  box-shadow: inset 0 0 12rpx rgba(45, 212, 167, 0.35);
}
.h2h-bar-fill--b {
  background: var(--h2h-b, #F25C54);
  box-shadow: inset 0 0 12rpx rgba(242, 92, 84, 0.35);
}

/* ===== 标签 ===== */
.h2h-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1-5);
  margin-top: var(--space-2-5);
}
.h2h-tag {
  font-size: var(--fs-caption);
  font-weight: 600;
  padding: var(--space-0-5) var(--space-2);
  border-radius: var(--radius-pill, 999rpx);
  line-height: var(--lh-relaxed);
}
.h2h-tag--dominate {
  color: var(--h2h-b, #F25C54);
  background: var(--h2h-b-soft, rgba(242, 92, 84, 0.14));
  border: 1rpx solid rgba(242, 92, 84, 0.4);
}
.h2h-tag--even {
  color: #9bb0c9;
  background: rgba(155, 176, 201, 0.12);
  border: 1rpx solid rgba(155, 176, 201, 0.35);
}
.h2h-tag--streak {
  color: var(--h2h-a, #2DD4A7);
  background: var(--h2h-a-soft, rgba(45, 212, 167, 0.14));
  border: 1rpx solid rgba(45, 212, 167, 0.4);
}

/* ===== 历次交锋列表 ===== */
.h2h-match {
  position: relative;
  overflow: hidden;
  background: var(--card-bg, #FFFFFF);
  border-radius: var(--radius-md, 12rpx);
  padding: var(--space-2-5) var(--space-3) var(--space-2-5) var(--space-4);
  margin-bottom: 14rpx;
}
.h2h-match::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6rpx;
  background: var(--td-border-level-1-color, #E5E7EB);
}
.h2h-match.tier-sss::before { background: var(--tier-sss); }
.h2h-match.tier-s::before { background: var(--tier-s); }
.h2h-match.tier-a::before { background: var(--tier-a); }
.h2h-match.tier-b::before { background: var(--tier-b); }
/* 3.2 关键场次高亮（S 级以上赛事） */
.h2h-match--key {
  border: 1rpx solid rgba(200, 169, 81, 0.55);
  box-shadow: 0 0 0 1rpx rgba(200, 169, 81, 0.15), 0 4rpx 14rpx rgba(200, 169, 81, 0.12);
}
.h2h-key-flag {
  font-size: var(--fs-micro);
  font-weight: 700;
  color: var(--text-1);
  background: var(--dota-gold);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-pill);
  flex-shrink: 0;
}
.h2h-match-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-1-5);
}
.h2h-league {
  font-size: var(--fs-label);
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  var(--td-bg-color-container)-space: nowrap;
  flex: 1;
  min-width: 0;
}
.h2h-league--plain { color: var(--text-2); }
.h2h-date {
  font-size: var(--fs-caption);
  color: var(--text-3);
  font-family: var(--font-mono, monospace);
  flex-shrink: 0;
}
.h2h-match-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}
.h2h-score {
  font-size: var(--fs-heading);
  font-weight: 800;
  font-family: var(--font-numeric, sans-serif);
  letter-spacing: 1rpx;
}
.h2h-result {
  font-size: var(--fs-body);
  font-weight: 700;
}
.h2h-score.win, .h2h-result.win { color: var(--h2h-a, #2DD4A7); }
.h2h-score.lose, .h2h-result.lose { color: var(--h2h-b, #F25C54); }

/* ===== 空态 / 骨架 ===== */
.h2h-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx var(--space-5);
}
.h2h-skeleton {
  padding: var(--space-5) 0;
}
/* §8.3 骨架屏 shimmer 动画（2026-07-29）：与 components/skeleton 保持一致 */
.sk-logo, .sk-bar {
  position: relative;
  overflow: hidden;
}
.sk-logo::after, .sk-bar::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(90deg, transparent 0%, var(--td-bg-color-component-active) 50%, transparent 100%);
  transform: translateX(-100%);
  animation: sk-shimmer 1.4s ease-in-out infinite;
}
@keyframes sk-shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}
@media (prefers-reduced-motion: reduce) {
  .sk-logo::after, .sk-bar::after { animation: none; }
}
.sk-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-lg);
  background: var(--card-bg-elevated, #F1F3F5);
  margin: 0 auto var(--space-3);
}
.sk-bar {
  height: 28rpx;
  border-radius: var(--radius-pill);
  background: var(--card-bg-elevated, #F1F3F5);
  margin-bottom: var(--space-2);
}

/* ===== 3.3 近期状态雷达卡 ===== */
.radar-card {
  background: var(--card-bg, #FFFFFF);
  border: 1rpx solid var(--td-border-level-1-color);
  border-radius: var(--radius-lg);
  padding: var(--space-2) var(--space-1) var(--space-1-5);
  margin-bottom: var(--space-2);
}
.radar-legend {
  display: flex;
  justify-content: center;
  gap: var(--space-5);
  margin-top: var(--space-0-5);
}
.rl-item {
  display: flex;
  align-items: center;
  font-size: var(--fs-caption);
  color: var(--text-3);
}
.rl-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}
