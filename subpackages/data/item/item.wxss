.container { padding: var(--space-3); }

.search { margin-bottom: var(--space-2); }

/* 分类筛选（横向滚动） */
.cat-bar { white-space: nowrap; margin-bottom: var(--space-1-5); }
.cat {
  display: inline-block;
  font-size: var(--fs-body);
  color: var(--text-2);
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: var(--radius-pill);
  padding: var(--space-1) var(--space-3);
  margin-right: var(--space-1-5);
  transition: all 0.15s ease;
}
.cat.active {
  color: #1F2937;
  background: #C8A951;
  border-color: #C8A951;
  font-weight: 600;
}

/* 排序 + 仅看配方 */
.filter-bar { display: flex; flex-wrap: wrap; gap: var(--space-1-5); margin-bottom: var(--space-1-5); }
.filter-spacer { flex: 1; }
.chip {
  font-size: var(--fs-body);
  color: var(--text-2);
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: var(--radius-pill);
  padding: var(--space-1) 22rpx;
  transition: all 0.15s ease;
}
.chip.active {
  color: #1F2937;
  background: #C8A951;
  border-color: #C8A951;
  font-weight: 600;
}

.item-list { margin-top: var(--space-1); }

.item-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--card-bg, #FFFFFF);
  border: 1rpx solid #E5E7EB;
  border-radius: var(--radius-lg, 16rpx);
  padding: var(--space-2) var(--space-2-5);
  margin-bottom: var(--space-1-5);
  transition: transform 0.12s ease, background 0.12s ease;
}
.item-row.skel { padding: var(--space-3); }
.item-row--hover { background: var(--card-bg-elevated, #F1F3F5); transform: scale(0.99); }

/* 图标区 */
.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  flex-shrink: 0;
  background: rgba(200, 169, 81, 0.10);
  border: 1rpx solid rgba(200, 169, 81, 0.25);
}

.item-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.item-name {
  font-size: var(--fs-subhead);
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-sub {
  font-size: var(--fs-micro);
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-tags { display: flex; flex-wrap: wrap; gap: var(--space-1); }
.item-tag {
  font-size: var(--fs-micro);
  color: var(--text-2);
  background: #F1F3F5;
  border: 1rpx solid #E5E7EB;
  border-radius: var(--radius-sm);
  padding: 2rpx 10rpx;
}
.item-tag.recipe { color: #C8A951; border-color: rgba(200, 169, 81, 0.4); }
.item-tag.shop { color: #4aa3ff; border-color: rgba(74, 163, 255, 0.35); }
.item-tag.neutral { color: #b98bff; border-color: rgba(185, 139, 255, 0.4); }

.item-cost { flex-shrink: 0; }
.item-cost-num { font-size: var(--fs-emphasis); font-weight: 800; color: var(--dota-gold, #C8A951); font-family: var(--font-mono, monospace); }
.item-cost-num.free { font-size: var(--fs-body); color: var(--text-2); }
