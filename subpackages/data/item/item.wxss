.container { padding: 24rpx; }

.search { margin-bottom: 16rpx; }

/* 分类筛选（横向滚动） */
.cat-bar { white-space: nowrap; margin-bottom: 12rpx; }
.cat {
  display: inline-block;
  font-size: 24rpx;
  color: #9aa4b2;
  background: #161b22;
  border: 1rpx solid #232a33;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  margin-right: 12rpx;
  transition: all 0.15s ease;
}
.cat.active {
  color: #0e1116;
  background: #C8A951;
  border-color: #C8A951;
  font-weight: 600;
}

/* 排序 + 仅看配方 */
.filter-bar { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.filter-spacer { flex: 1; }
.chip {
  font-size: 24rpx;
  color: #9aa4b2;
  background: #161b22;
  border: 1rpx solid #232a33;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  transition: all 0.15s ease;
}
.chip.active {
  color: #0e1116;
  background: #C8A951;
  border-color: #C8A951;
  font-weight: 600;
}

.item-list { margin-top: 8rpx; }

.item-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--card-bg, #161b22);
  border: 1rpx solid #1f262f;
  border-radius: var(--radius-lg, 16rpx);
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  transition: transform 0.12s ease, background 0.12s ease;
}
.item-row.skel { padding: 24rpx; }
.item-row--hover { background: var(--card-bg-elevated, #1c232c); transform: scale(0.99); }

/* 图标区 */
.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: rgba(200, 169, 81, 0.10);
  border: 1rpx solid rgba(200, 169, 81, 0.25);
}

.item-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #f0f3f6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-sub {
  font-size: 20rpx;
  color: #6b7280;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.item-tag {
  font-size: 20rpx;
  color: #9aa4b2;
  background: #0f141b;
  border: 1rpx solid #232a33;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.item-tag.recipe { color: #C8A951; border-color: rgba(200, 169, 81, 0.4); }
.item-tag.shop { color: #4aa3ff; border-color: rgba(74, 163, 255, 0.35); }
.item-tag.neutral { color: #b98bff; border-color: rgba(185, 139, 255, 0.4); }

.item-cost { flex-shrink: 0; }
.item-cost-num { font-size: 30rpx; font-weight: 800; color: var(--dota-gold, #C8A951); font-family: var(--font-mono, monospace); }
.item-cost-num.free { font-size: 24rpx; color: #8a8f99; }
