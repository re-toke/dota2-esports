.container { padding: 24rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }

.search { margin-bottom: 16rpx; }

.filter-bar { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.filter-spacer { flex: 1; }
.chip {
  font-size: 24rpx;
  color: #9aa4b2;
  background: #161b22;
  border: 1rpx solid #232a33;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  transition: all 0.15s ease;
}
.chip.active {
  color: #0e1116;
  background: #C8A951;
  border-color: #C8A951;
  font-weight: 600;
}

.hero-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 8rpx;
}

.hero-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  overflow: hidden;
  background: var(--card-bg, #161b22);
  border: 1rpx solid #1f262f;
  border-radius: var(--radius-lg, 16rpx);
  padding: 18rpx 20rpx;
  transition: transform 0.12s ease, background 0.12s ease;
}
.hero-card.skel { padding: 24rpx; }
.hero-card--hover { background: var(--card-bg-elevated, #1c232c); transform: scale(0.99); }

.hero-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid;
  flex-shrink: 0;
}
.hero-initial { font-size: 34rpx; font-weight: 800; font-family: var(--font-mono, monospace); }
.hero-avatar { width: 68rpx; height: 68rpx; border-radius: 50%; display: block; background: #0f141b; }

.hero-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.hero-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #f0f3f6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-tags { display: flex; align-items: center; gap: 6rpx; font-size: 22rpx; }
.hero-attr { font-weight: 600; }
.hero-attr2 { color: #8a8f99; }
.hero-dot { color: #4b5563; }
.hero-role {
  font-size: 20rpx;
  color: #6b7280;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-win { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; min-width: 0; overflow: hidden; }
.hero-win-num { font-size: 28rpx; font-weight: 700; color: var(--dota-gold, #C8A951); font-family: var(--font-mono, monospace); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 110rpx; }
.hero-win-label { font-size: 18rpx; color: #6b7280; }
