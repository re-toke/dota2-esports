.container { padding: var(--space-3); }

/* ===== 头部 ===== */
.head { display: flex; align-items: center; gap: var(--space-2-5); margin-bottom: var(--space-3); }
.head-icon { width: 110rpx; height: 110rpx; border-radius: var(--radius-lg); overflow: hidden; flex-shrink: 0; }
.head-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.head-name { font-size: var(--fs-display); font-weight: 800; color: var(--text-1); }
.head-sub { font-size: var(--fs-caption); color: var(--text-3); font-family: var(--font-mono, monospace); }

/* ===== 区块 ===== */
.block { background: var(--card-bg, #FFFFFF); border: 1rpx solid var(--td-border-level-1-color); border-radius: var(--radius-lg, 16rpx); padding: var(--space-2-5) var(--space-3); margin-bottom: var(--space-2); }
.block-title { font-size: var(--fs-label); font-weight: 700; color: var(--text-1); margin-bottom: var(--space-2); }

.info-row { display: flex; align-items: center; justify-content: space-between; padding: var(--space-1-5) 0; border-bottom: 1rpx solid var(--td-border-level-1-color); }
.info-row:last-child { border-bottom: none; }
.info-label { font-size: var(--fs-label); color: var(--text-2); }
.info-value { font-size: var(--fs-label); font-weight: 600; color: var(--text-1); font-family: var(--font-mono, monospace); }
.info-value.muted { color: var(--text-2); font-weight: 400; }

/* 待补充 */
.block.pending { background: var(--td-bg-color-component); border-style: dashed; }
.pending-item { display: flex; align-items: flex-start; gap: 10rpx; padding: var(--space-1) 0; font-size: var(--fs-body); color: var(--text-2); line-height: var(--lh-relaxed); }
.pending-item t-icon { margin-top: 2rpx; flex-shrink: 0; }

/* §8.3 合成组件列表 */
.recipe-list { display: flex; flex-direction: column; gap: var(--space-1-5); }
.recipe-item { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-1-5); background: var(--td-bg-color-component); border-radius: var(--radius-md); border: 1rpx solid var(--td-border-level-1-color); }
.recipe-icon { width: 64rpx; height: 64rpx; border-radius: var(--radius-md); overflow: hidden; flex-shrink: 0; }
.recipe-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--space-0-5); }
.recipe-name { font-size: var(--fs-label); font-weight: 600; color: var(--text-1); }
.recipe-cost { font-size: var(--fs-caption); color: var(--dota-gold); font-family: var(--font-mono, monospace); }
.recipe-cost.muted { color: var(--text-2); font-weight: 400; }

/* P1 缺口补齐（2026-08-31）：出装统计 */
.usage-hero { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-1-5) 0; border-bottom: 1rpx solid var(--td-border-level-1-color); }
.usage-hero:last-of-type { border-bottom: none; }
.usage-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; overflow: hidden; flex-shrink: 0; }
.usage-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--space-0-5); }
.usage-name { font-size: var(--fs-label); font-weight: 600; color: var(--text-1); overflow: hidden; text-overflow: ellipsis; var(--td-bg-color-container)-space: nowrap; }
.usage-meta { font-size: var(--fs-caption); color: var(--text-3); font-family: var(--font-mono, monospace); }
.usage-win-wrap { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-0-5); flex-shrink: 0; }
.usage-win { font-size: var(--fs-label); font-weight: 700; color: var(--dota-gold); font-family: var(--font-mono, monospace); }
.usage-win-label { font-size: var(--fs-caption); color: var(--text-3); }
.timing-chips { display: flex; flex-wrap: wrap; gap: var(--space-1-5); }
.timing-chip { display: flex; flex-direction: column; align-items: center; gap: var(--space-0-5); padding: var(--space-1-5) var(--space-2-5); background: var(--td-bg-color-component); border: 1rpx solid var(--td-border-level-1-color); border-radius: var(--radius-md); }
.timing-min { font-size: var(--fs-caption); color: var(--text-2); }
.timing-share { font-size: var(--fs-label); font-weight: 700; color: var(--text-1); font-family: var(--font-mono, monospace); }
.usage-note { margin-top: var(--space-1-5); font-size: var(--fs-caption); color: var(--text-3); line-height: var(--lh-relaxed); }

.detail-foot {
  font-size: var(--fs-caption);
  color: var(--text-3);
  padding: var(--space-1-5) 0 var(--space-1);
  line-height: var(--lh-relaxed);
}
