{
  "pages": [
    "pages/index/index",
    "pages/leagues/leagues",
    "pages/teams/teams",
    "pages/follow/follow",
    "pages/data/data",
    "pages/search/search"
  ],
  "subpackages": [
    {
      "root": "subpackages/detail",
      "name": "detail",
      "pages": [
        "league-detail/league-detail",
        "match-detail/match-detail",
        "team-detail/team-detail",
        "h2h/h2h",
        "privacy/privacy"
      ]
    },
    {
      "root": "subpackages/data",
      "name": "data",
      "pages": [
        "hero/hero",
        "hero-detail/hero-detail",
        "item/item",
        "item-detail/item-detail"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["detail"]
    },
    "pages/leagues/leagues": {
      "network": "all",
      "packages": ["detail"]
    },
    "pages/teams/teams": {
      "network": "all",
      "packages": ["detail"]
    },
    "pages/data/data": {
      "network": "all",
      "packages": ["data"]
    },
    "pages/search/search": {
      "network": "wifi",
      "packages": ["data"]
    }
  },
  "__usePrivacyCheck__": true,
  "window": {
    "backgroundTextStyle": "dark",
    "navigationBarBackgroundColor": "#0d0d0d",
    "navigationBarTitleText": "DOTA2赛事",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#0d0d0d"
  },
  "tabBar": {
    "custom": true,
    "color": "#6b6b73",
    "selectedColor": "#FFD15C",
    "backgroundColor": "#0d0d0d",
    "borderStyle": "black",
    "list": [
      { "pagePath": "pages/index/index", "text": "首页" },
      { "pagePath": "pages/leagues/leagues", "text": "赛事" },
      { "pagePath": "pages/teams/teams", "text": "战队" },
      { "pagePath": "pages/follow/follow", "text": "我的" },
      { "pagePath": "pages/data/data", "text": "资料库" }
    ]
  },
  "sitemapLocation": "sitemap.json"
}
