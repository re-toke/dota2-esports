/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  padding-top: 10rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(13, 13, 13, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

/* §4.4 blur 降级（2026-07-29）：低端机型关闭 blur 减少掉帧 */
.tab-bar--no-blur {
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.tab-bar__border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 209, 92, 0.18) 50%, transparent 100%);
  transform: scaleY(0.5);
  transform-origin: 0 0;
}

.tab-bar__item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  flex: 1;
  padding: var(--space-1-5) 0 var(--space-1);
  color: #6b6b73;
  transition: color 0.18s ease, transform 0.12s ease;
}

.tab-bar__item--active {
  color: #FFD15C;
}

.tab-bar__item--pressed {
  transform: scale(0.92);
}

.tab-bar__icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-bar__item--active .tab-bar__icon-wrap {
  transform: translateY(-4rpx);
}

.tab-bar__icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
  line-height: 1;
}

/* 批次0（2026-08-30）：PNG 图标选中态放大（对应原 t-icon 52rpx 选中尺寸） */
.tab-bar__item--active .tab-bar__icon {
  width: 52rpx;
  height: 52rpx;
}

.tab-bar__dot {
  position: absolute;
  bottom: -6rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #FFD15C;
  box-shadow: 0 0 10rpx rgba(255, 209, 92, 0.5);
}

.tab-bar__text {
  margin-top: var(--space-1);
  font-size: var(--fs-caption);
  line-height: 1;
  transition: font-size 0.18s ease, font-weight 0.18s ease;
}

.tab-bar__item--active .tab-bar__text {
  font-size: var(--fs-body);
  font-weight: 600;
}

/* 安全区由 .tab-bar 的 padding-bottom 处理 */

/* 批次2（2026-08-30）· PRD §5：底部安全区改不透明纯深色。
   iOS Home 指示条区域原为半透明毛玻璃底，白色指示条对比突兀；
   现该区域覆盖与页面背景同值的不透明 #0d0d0d，内容区保留毛玻璃视觉分层。
   无刘海设备 env()=0，::after 零高度，无副作用。 */
.tab-bar::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: env(safe-area-inset-bottom);
  background: #0d0d0d;
}