/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  padding-top: 10rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

/* §4.4 blur 降级（2026-07-29）：低端机型关闭 blur 减少掉帧 */
.tab-bar--no-blur {
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.tab-bar__border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.06);
  transform: scaleY(0.5);
  transform-origin: 0 0;
}

.tab-bar__item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  flex: 1;
  padding: 12rpx 0 8rpx;
  color: #8a8f99;
  transition: color 0.18s ease, transform 0.12s ease;
}

.tab-bar__item--active {
  color: #C8A951;
}

.tab-bar__item--pressed {
  transform: scale(0.92);
}

.tab-bar__icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-bar__item--active .tab-bar__icon-wrap {
  transform: translateY(-4rpx);
}

.tab-bar__icon {
  display: block;
  line-height: 1;
}

.tab-bar__dot {
  position: absolute;
  bottom: -6rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #C8A951;
  box-shadow: 0 0 10rpx rgba(200, 169, 81, 0.5);
}

.tab-bar__text {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1;
  transition: font-size 0.18s ease, font-weight 0.18s ease;
}

.tab-bar__item--active .tab-bar__text {
  font-size: 24rpx;
  font-weight: 600;
}

/* 安全区由 .tab-bar 的 padding-bottom 处理 */