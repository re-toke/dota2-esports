<view class="tab-bar {{blurDisabled ? 'tab-bar--no-blur' : ''}}" style="background-color: {{backgroundColor}};">
  <view class="tab-bar__border"></view>
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tab-bar__item {{selected === index ? 'tab-bar__item--active' : ''}}"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    hover-class="tab-bar__item--pressed"
    hover-start-time="0"
    hover-stay-time="120"
    bindtap="switchTab"
  >
    <view class="tab-bar__icon-wrap">
      <!-- 批次0（2026-08-30）：t-icon 换 game-icons PNG（wxml 无法内联 SVG） -->
      <image
        class="tab-bar__icon"
        src="{{selected === index ? item.iconOn : item.iconOff}}"
        mode="aspectFit"
      />
      <view wx:if="{{selected === index}}" class="tab-bar__dot"></view>
    </view>
    <text class="tab-bar__text">{{item.text}}</text>
  </view>
</view>