/* ===== TDesign 设计变量（先引入完整 token 集，再强制暗色覆盖） ===== */
@import 'miniprogram_npm/tdesign-miniprogram/common/style/theme/_index.wxss';

/* 雾峰雪 Mist Peak v2.0 亮色系主题：冷雾底 + 矿物色调 + 留白节奏制造层次 */
page {
  /* 天辉夜魇配色：胜=天辉绿 / 负=夜魇红 */
  --radiant: #5fd35f;
  --radiant-strong: #46c457;
  --radiant-soft: rgba(95, 211, 95, 0.12);
  --dire: #e8443b;
  --dire-strong: #c9352d;
  --dire-soft: rgba(232, 68, 59, 0.12);

  /* 品牌色：DOTA2 暗金 #C8A951（强调色，区别于 TDesign 默认蓝）
     说明：胜/负语义色 --radiant(--dire) 保持不变，仅 UI 强调色（按钮/选中/链接）改用暗金 */
  --dota-red: #A41E1E;
  --dota-red-strong: #7a1414;
  --dota-gold: #C8A951;
  --dota-gold-strong: #b08a3e;
  --dota-gold-soft: #FDF6E3;
  --td-brand-color: #C8A951;
  --td-brand-color-active: #b08a3e;
  --td-brand-color-disabled: #D9C891;
  --td-brand-color-light: #FDF6E3;
  --td-brand-color-light-active: #FBEDC7;
  --td-brand-color-focus: #FDF6E3;
  --td-primary-color-7: #C8A951;
  --td-primary-color-8: #d8be7a;
  --td-text-color-brand: #B08A3E;
  --td-text-color-link: #B08A3E;

  /* ===== 全局 Tier 用色 Token（雾峰雪 v2.0 亮色系，四级化 S/Indigo A/B/C 规范） =====
     单一来源：所有等级色彩统一由此定义，各页面/组件仅引用 Token，禁止散落字面量。
     规范映射：SSS 并入 S（实底金块角标） / S=S-Tier(暗金·品牌金) / A=A-Tier(Indigo) / B=B-Tier(蓝) / C=社区赛(灰)
     v2.0：A 级 violet #8B5CF6 因 KPL 联想被否，2026-09-05 最终锁定 indigo #6366F1 */
  --tier-sss: #C8A951;          /* 已并入 S · 旧 SSS 锚点的别名（保留向后兼容） */
  --tier-s:   #C8A951;          /* S-Tier · 暗金（品牌色，含原 SSS） */
  --tier-a:   #6366F1;          /* A-Tier · Indigo（Tailwind indigo-500） */
  --tier-b:   #3B82F6;          /* B-Tier · 蓝（Tailwind blue-500） */
  --tier-c:   #94A3B8;          /* 社区赛 · 灰（Tailwind slate-400） */
  --tier-sss-soft: #FDF6E3;     /* 同 tier-s-soft */
  --tier-s-soft:   #FDF6E3;     /* 浅金底纹（实色浅底，弃用半透明叠加） */
  --tier-a-soft:   #EEF0FB;     /* 浅 indigo 底 */
  --tier-b-soft:   #EBF4FE;     /* 浅蓝底 */
  --tier-c-soft:   #F1F5F9;     /* 浅灰底 */
  /* 等级描边色（0.4 alpha，用于筛选 chip / 卡片边框等需要半透明的场景） */
  --tier-sss-line: rgba(200, 169, 81, 0.40);
  --tier-s-line:   rgba(200, 169, 81, 0.40);
  --tier-a-line:   rgba(99, 102, 241, 0.40);
  --tier-b-line:   rgba(59, 130, 246, 0.40);
  --tier-c-line:   rgba(148, 163, 184, 0.40);

  /* 夜魇红：危险/错误/取消关注 */
  --td-error-color: #e8443b;
  --td-error-color-active: #c9352d;
  --td-error-color-disabled: #F4B8B4;
  --td-error-color-light: rgba(232, 68, 59, 0.10);
  --td-error-color-light-active: rgba(232, 68, 59, 0.18);
  --td-text-color-error: #e8443b;

  /* 背景（雾峰雪：冷雾底 + 纯白卡 + 冷雾灰内嵌） */
  --td-bg-color-page: #F8F9FA;
  --td-bg-color-container: #FFFFFF;
  --td-bg-color-container-active: #F8F9FA;
  --td-bg-color-secondarycontainer: #FFFFFF;
  --td-bg-color-component: #F1F3F5;
  --td-bg-color-component-active: #E5E7EB;
  --td-bg-color-component-disabled: #F8F9FA;
  --td-bg-color-specialcomponent: #FFFFFF;

  /* 文字（雾峰雪 v2.0：亮底深字反相，灰阶四档化）
     --text-* 为语义别名，指向同值 --td-*；页面统一引用 --text-*，禁止散落字面量灰 */
  --text-1: #1F2937;               /* 主文字（AAA 15.9:1） */
  --text-2: #4B5563;               /* 次要文字（AAA 9.2:1） */
  --text-3: #6B7280;               /* 已结束/新鲜度/非关键装饰（AA+ 5.8:1） */
  --text-4: #9CA3AF;               /* 占位/禁用（AA 大字 3.3:1） */
  --td-text-color-primary: var(--text-1);
  --td-text-color-secondary: var(--text-2);
  --td-text-color-placeholder: var(--text-4);
  --td-text-color-disabled: var(--text-4);
  --td-text-color-anti: var(--text-1);

  /* 边框/分割线（雾峰雪：冷雾灰） */
  --td-border-level-1-color: #E5E7EB;
  --td-component-stroke: #E5E7EB;
  --td-border-level-2-color: var(--text-3);
  --td-component-border: #D1D5DB;

  /* 遮罩 */
  --td-mask-active: rgba(0, 0, 0, 0.4);
  --td-mask-background: rgba(255, 255, 255, 0.9);

  /* 全局背景与文字（雾峰雪方案：冷雾纸面底）
     注：战场图背景层已移除（v2.0 §阶段 4），不再使用 bg-page / bg-page-dim */
  background: var(--td-bg-color-page);
  color: var(--text-1);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: var(--fs-subhead);
}

/* ===== 雾峰雪 v2.0：战场图背景层 + 上下暗化遮罩全部移除（§阶段 4）
   原 .bg-page / .bg-page-dim / .bg-mask-top / .bg-mask-bottom 样式不再需要；
   页面背景统一由 page {} 的 var(--td-bg-color-page) 纯色承载，不再有任何暗化层。 */

/* ===== 全局 Tier 用色 Token 工具类（雾峰雪 v2.0：彩条改实色，弃用双色渐变） =====
   仅定义实色，几何尺寸（彩条宽度/定位）由各卡片 .tier-* 容器自身的 ::before 提供。
   各页面/组件统一引用此处 Token，禁止散落字面量（见 #14）。 */
.tier-sss::before { background: var(--tier-sss); }
.tier-s::before   { background: var(--tier-s); }
.tier-a::before   { background: var(--tier-a); }
.tier-b::before   { background: var(--tier-b); }
.tier-c::before   { background: var(--tier-c); }
/* 等级文本色工具类（供 t-tag / 文字直接引用） */
.tier-text-sss { color: var(--tier-sss); }
.tier-text-s   { color: var(--tier-s); }
.tier-text-a   { color: var(--tier-a); }
.tier-text-b   { color: var(--tier-b); }
.tier-text-c   { color: var(--tier-c); }

/* 胜率颜色分级工具类（全局：teams / league-detail 共用，统一收敛到 kpi Token，禁止本地散落定义） */
.wr-high { color: var(--kpi-primary, #5fd35f); }
.wr-mid  { color: var(--kpi-warning, #f0aa28); }
.wr-low  { color: var(--text-4); }

view, text { box-sizing: border-box; }

/* 通用容器 */
.container { padding: 24rpx; }

/* 带自定义 tabBar 的页面容器，预留底部导航栏高度 + 安全区。
   160rpx 缓冲：实测自定义 tabBar 高 ~128rpx（10+56+8+22-24+12+1 边线），
   原 132rpx 仅留 4rpx 余量，渲染/字体抖动易让最后一行被 tabBar 遮盖 → 表现"滚到底还有信息看不到"。
   leagues 页曾为此单独覆写到 148rpx；此处直接抬到 160rpx 后各页通用，leagues 覆写可一并收敛。 */
.container.with-tab-bar { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }

/* 批次0（2026-08-30）：非 tab 页（teams/data 等退出 tabBar 的页面）容器，
   无 custom-tab-bar，仅留常规呼吸空间 + 安全区，避免原 160rpx 底部空白断层。 */
.container.with-safe-bottom { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }

/* 搜索栏上下间距 */
.search-wrap { margin: 8rpx 0 20rpx; }

/* 卡片（雾峰雪 v2.0：纯白底 + 极淡边框 + 极淡阴影） */
.card {
  background: var(--card-grad);
  border-radius: 14rpx;
  border: 0.5rpx solid var(--td-border-level-1-color);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--card-inner-shadow);
}

/* 行布局 */
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }

/* 文字（雾峰雪 v2.0：亮底深字） */
.title { font-size: var(--fs-heading); font-weight: 600; color: var(--text-1); }
.sub { font-size: var(--fs-body); color: var(--text-2); }
.muted { color: var(--text-3); }
.bold { font-weight: 600; }

/* 等级标签（雾峰雪 v2.0：实色浅底 + 深字，弃用半透明叠加） */
.tag {
  display: inline-block;
  font-size: var(--fs-caption);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  line-height: var(--lh-relaxed);
}
.tag-sss { background: var(--dota-gold-soft); color: var(--tier-s-text); }
.tag-s { background: var(--dota-gold-soft); color: var(--tier-s-text); }
.tag-a { background: var(--tier-a-soft); color: var(--tier-a-text); }
.tag-b { background: var(--tier-b-soft); color: var(--tier-b-text); }
.tag-c { background: var(--tier-c-soft); color: var(--tier-c-text); }

/* 胜负色：天辉绿=胜 / 夜魇红=负 */
.win { color: var(--radiant); }
.lose { color: var(--dire); }

/* 加载 / 空态 */
.center { text-align: center; color: var(--text-3); padding: 80rpx 0; }

/* ===== v11 聚光灯 Phase 7：Error 错误态 =====
   用法：<view class="error-strip"><t-icon name="error-circle" color="var(--dire)"/> <text>信号中断，正在重连…</text><t-button size="small" theme="primary" bindtap="retry">重试</t-button></view> */
.error-strip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  background: rgba(232, 68, 59, 0.08);
  border: 1rpx solid rgba(232, 68, 59, 0.2);
}
.error-strip text {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--dire);
}

/* 搜索框（TDesign 之外的兜底 · 雾峰雪 v2.0：纯白底 + 极淡边框） */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--card-grad);
  border: 1rpx solid var(--td-border-level-1-color);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--card-inner-shadow);
}
.search-bar input { flex: 1; margin-left: 12rpx; color: var(--text-1); }

/* 分段选择（筛选条）—— 暗色运动风：选中=品牌金 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.filter-bar .chip {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: var(--fs-label);
  color: var(--text-3);
  background: var(--td-bg-color-component);
  border: 1rpx solid var(--td-border-level-1-color);
  border-radius: 12rpx;
}
.filter-bar .chip.active {
  color: var(--tier-s-text);
  background: var(--dota-gold-soft);
  border-color: rgba(200,169,81,0.4);
}

/* 新鲜度标签（更新于 X 前）推到最右 */
.filter-bar .fresh {
  margin-left: auto;
  align-self: center;
  font-size: var(--fs-caption);
  white-space: nowrap;
  padding-left: 8rpx;
}

/* 分段选择（通用，用于 现役/历史、关注分类等 · 雾峰雪 v2.0：雾灰底 + 金浅底激活） */
.seg {
  display: flex;
  background: var(--td-bg-color-page);
  border: 1rpx solid var(--td-border-level-1-color);
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: var(--fs-subhead);
  color: var(--text-3);
  padding: 14rpx 0;
  border-radius: 10rpx;
}
.seg-item.active {
  background: var(--dota-gold-soft);
  color: var(--tier-s-text);
  font-weight: 600;
}

/* 加载更多按钮容器 */
.loadmore { text-align: center; padding: 24rpx 0; }

/* 天辉→夜魇 渐变签名条（页面可选使用 · 雾峰雪 v2.0：保留渐变，用于签名效果） */
.radiant-dire-bar {
  height: 6rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--radiant) 0%, var(--dota-gold) 50%, var(--dire) 100%);
  margin-bottom: 20rpx;
}


/* ===================================================================
   B+C 混合设计系统 · 共享 token 与组件类
   - 移动动态卡片（B）用于列表/关注页：大圆角、左右对阵、状态脉冲
   - 数据指挥台（C）用于详情页：KPI strip、表格化、来源溯源网格
   - 决赛/重要赛事可叠加方案 A 局部强化（hero banner）
   =================================================================== */

page {
  /* ===== 字体 token ===== */
  /* 数字等宽：胜率/比分/KDA 等，确保数字对齐 */
  --font-numeric: "SF Pro Display", "Inter", -apple-system, "PingFang SC", sans-serif;
  /* 等宽代码：match_id / steam_id 等 */
  --font-mono: "JetBrains Mono", "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  /* 显示字体：标题（仅详情页头部与决赛 hero 使用，列表页仍用系统字体保持性能） */
  --font-display: "SF Pro Display", -apple-system, "PingFang SC", sans-serif;

  /* ===== 间距 token（4rpx 递进全阶梯；v18 扩充半阶 4/12/20/28rpx） ===== */
  --space-0-5: 4rpx;    /* 半阶 1 */
  --space-1:   8rpx;
  --space-1-5: 12rpx;   /* 半阶 1.5 */
  --space-2:   16rpx;
  --space-2-5: 20rpx;   /* 半阶 2.5 */
  --space-3:   24rpx;
  --space-3-5: 28rpx;   /* 半阶 3.5 */
  --space-4:   32rpx;
  --space-5:   40rpx;
  --space-6:   48rpx;

  /* ===== 圆角 token（v18 新增 --radius-xs: 4rpx） ===== */
  --radius-xs:  4rpx;
  --radius-sm:  8rpx;
  --radius-md:  12rpx;
  --radius-lg:  16rpx;
  --radius-xl:  24rpx;
  --radius-pill: 999rpx;

  /* ===== 状态色 token（雾峰雪 v2.0：LIVE 改 red-500，对比度 4.0:1 过 WCAG-AA） ===== */
  --status-live: #EF4444;          /* 直播中：脉冲红（red-500，比珊瑚红对比度更高） */
  --status-ongoing: #5fd35f;       /* 进行中：天辉绿 */
  --status-upcoming: #f0aa28;      /* 即将到来：琥珀 */
  --status-ended: #6b7280;         /* 已结束：灰 */
  --status-verified: #5fd3a8;      /* 多源验证：青绿 */

  /* ===== H2H 双方对战条形配色（spec B.3：主队青绿 / 客队红） ===== */
  --h2h-a: #2DD4A7;                /* 主队（左）强调色：青绿/Radiant 风 */
  --h2h-a-soft: rgba(45, 212, 167, 0.14);
  --h2h-b: #F25C54;                /* 客队（右）强调色：红/Dire 风 */
  --h2h-b-soft: rgba(242, 92, 84, 0.14);

  /* ===== 来源溯源 token（数据可信度徽标） ===== */
  --source-opendota: #5fd35f;
  --source-stratz: #6054f1;
  --source-steam: #1b2838;
  --source-liquipedia: #ffcf5c;
  --source-curation: #9bb0c9;

  /* ===================================================================
     ★ 2026-09-10（P3 token 化 Phase 2）：补齐此前「无同值 token」的语义色
     来源：audit:colors 审计出的剩余硬编码色中「主题相关」的两类
       ① 黑 tint（暗色主题需翻转为白色微透，否则黑叠黑不可见）
       ② 不透明语义色（≥2 处复用）
     未纳入：半透明装饰色（金色/品牌色 alpha 变体）—— 叠在亮/暗底上表现一致，
       属主题无关，保留字面量；单次使用的装饰色同理。
     =================================================================== */

  /* --- 叠加层黑 tint（暗色主题需翻转为 --overlay-* 的白色对应档） --- */
  --overlay-02: rgba(0, 0, 0, 0.02);   /* 极淡底纹 / hover（最常用） */
  --overlay-03: rgba(0, 0, 0, 0.03);
  --overlay-04: rgba(0, 0, 0, 0.04);
  --overlay-05: rgba(0, 0, 0, 0.05);
  --overlay-06: rgba(0, 0, 0, 0.06);
  --overlay-08: rgba(0, 0, 0, 0.08);
  --overlay-12: rgba(0, 0, 0, 0.12);
  --scrim-40:   rgba(0, 0, 0, 0.40);   /* 模态/抽屉遮罩 */

  /* --- 琥珀亮色（比赛流「即将到来」分隔条 / 质量点 / 近期边框） ---
     注意：与 --source-liquipedia 同值但**语义不同**，故独立定义 */
  --amber-bright: #ffcf5c;

  /* --- 弱化次要文字（日期范围 / 焦点日期 / H2H 辅助文案） ---
     ★ 2026-09-20 修复「字体模糊看不清」：原值 #9bb0c9 对白底仅 **2.22:1**
       （低于 WCAG AA 正文 4.5:1）——它本是**深色主题的浅色**（为深底设计），
       留在亮色主题里表现为"发虚、看不清"。现统一指向 --text-3 (#6B7280, 4.83:1)。
     ⚠️ 亮色底上**不存在**"比 --text-3 更浅且仍合格"的正文色（4.5:1 的上限约 #767676）——
        要更弱的层级请用**字号/字重**，不要靠调浅颜色。
        仅「占位/禁用」态可用 --text-4（AA 对 disabled 文本豁免）。
     ⚠️ 暗色 v1.2 启动时，本 token 需重新指定深色主题值。 */
  --text-muted: var(--text-3);

  /* --- 链接 / 可点击文字 ---
     ★ 2026-09-20 修复：原 #5b9bff 对白底仅 **2.77:1**（可点击文字同样需 AA 4.5:1），
       而它被用于「展开/显示更多/BO2 标签」等**真实可读文字**（league-detail 4 处）。
       改为 #2563EB（白底 5.17:1 / 页底 4.90:1，色相仍是蓝，视觉变化小）。
     ⚠️ 配套：使用方的浅蓝 tint 字面量 `rgba(91,155,255,α)` 已同步改为 `rgba(37,99,235,α)`，
        避免「文字换色但底色/描边仍是旧蓝」的色相不一致。 */
  --link: #2563EB;

  /* --- 深灰蓝（详情页正文次级色 + 对阵未定节点） --- */
  --slate-deep: #3a4250;
  --slate-text: #4a525d;
  --slate-bar: #5a6068;             /* 分段条底色 */

  /* --- 极浅文字 ---
     ★ 2026-09-20 同上修正：原 #c0c4cc(1.75:1) / #b9b9b9(1.96:1) 在亮色底上**不可读**。
     ⚠️ 复核确认：本 token 的实际用途**不是占位符**，而是**
       分组标题（league-detail .phase-divider-text）与日期分隔线（.date-sep-text）**
       等**真实内容**（且 font-weight:600）→ 必须满足正文级 4.5:1，故统一指向 --text-3。 */
  --text-faint: var(--text-3);
  --text-faint-2: var(--text-3);

  /* --- 胜负/趋势（H2H、英雄克制） --- */
  --status-worst: #e0533d;          /* 英雄克制最差组 */
  --status-negative: #e74c3c;       /* H2H 负向 / 胜率负值 */

  /* --- Tier 软底上的深色文字（背景 token 已存在，此处补文字侧） --- */
  --tier-s-text: #7a6520;           /* 浅金底上的深金字（.tag-sss/.tag-s） */
  --tier-a-text: #3730a3;           /* 浅靛底上的深靛字（.tag-a） */
  --tier-b-text: #1e40af;           /* 浅蓝底上的深蓝字（.tag-b） */
  --tier-c-text: #374151;           /* 浅灰底上的深灰字（.tag-c） */

  /* ===== 卡片层级（雾峰雪：纯白卡 + 极淡边框 + 极淡外阴影，弃用渐变/inner-shadow） ===== */
  --card-bg: #FFFFFF;
  --card-bg-elevated: #FFFFFF;     /* 浮起卡片：直播卡/KPI strip（亮色下与普通卡同底，靠阴影区分） */
  --card-bg-inset: #F1F3F5;         /* 内嵌区：表格行/cell（冷雾灰） */
  /* v2.0 弃用对角线渐变基底，改纯白 */
  --card-grad: #FFFFFF;
  /* v2.0 弃用内阴影叠层，改极淡外阴影（几乎看不见但有微抬起感） */
  --card-inner-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);

  /* ===== Tier 色浸染改纯色竖条（雾峰雪 v2.0：弃用浸染渐变，改 4rpx 纯色左侧竖条） =====
     色标单位使用 rpx 与项目 Token 体系一致（1rpx ≈ 0.5px @2x） */
  --card-glow-sss: linear-gradient(90deg, var(--tier-sss) 0%, var(--tier-sss) 4rpx, transparent 4rpx);
  --card-glow-s:   linear-gradient(90deg, var(--tier-s) 0%, var(--tier-s) 4rpx, transparent 4rpx);
  --card-glow-a:   linear-gradient(90deg, var(--tier-a) 0%, var(--tier-a) 4rpx, transparent 4rpx);
  --card-glow-b:   linear-gradient(90deg, var(--tier-b) 0%, var(--tier-b) 4rpx, transparent 4rpx);
  --card-glow-c:   linear-gradient(90deg, var(--tier-c) 0%, var(--tier-c) 4rpx, transparent 4rpx);
  /* LIVE 特殊：v2.0 无涂装，卡片不再有 LIVE 浸染色带（保留 token 兼容但置空效果） */
  --card-glow-live: linear-gradient(90deg, transparent 0%, transparent 4rpx, transparent 4rpx);

  /* ===== 数据指挥台 KPI 色（C 风格专用，仅用于强调单个 KPI） ===== */
  --kpi-primary: #5fd35f;
  --kpi-warning: #f0aa28;
  --kpi-info: #6054f1;

  /* ===== 字体排版 Token（v11 聚光灯 §1.4.1 · 九级字号阶梯，v17 扩充） ===== */
  --fs-hero:     52rpx;   /* 英雄首字母大字、详情页大数字 */
  --fs-mega:     40rpx;   /* VS 比分、英雄标题、大图标 */
  --fs-display:  36rpx;   /* 页面主标题、品牌栏大标题 */
  --fs-heading:  32rpx;   /* 卡片标题（赛事名称、战队名） */
  --fs-emphasis: 30rpx;   /* KPI 数值、分区强调标题 */
  --fs-subhead:  28rpx;   /* 分段标签、对话框标题 */
  --fs-label:    26rpx;   /* 分区标签、tab 文字、快捷入口名 */
  --fs-body:     24rpx;   /* 正文（比赛信息、详情描述） */
  --fs-caption:  22rpx;   /* 辅助文字（日期、来源、状态标签） */
  --fs-micro:    20rpx;   /* 极小标注（角标、版本号、KPI 单位） */
  --fs-badge:    18rpx;   /* 徽章、胜负标识、极小辅助 */

  /* 字重 */
  --fw-bold:     700;
  --fw-semibold: 600;
  --fw-medium:   500;
  --fw-regular:  400;

  /* 行高（无单位比值，跟随字号自动缩放） */
  --lh-tight:    1.3;     /* Display / 大标题紧凑排版 */
  --lh-normal:   1.4;     /* Heading / Subhead */
  --lh-relaxed:  1.6;     /* Body（长文本阅读舒适） */
  --lh-loose:    1.7;     /* 多行长文本（协议/隐私/帮助） */

  /* 字体特性：tabular-nums 让数字对齐 */
  font-variant-numeric: tabular-nums;
}

/* ===================================================================
   共享组件 1：KPI Strip（C 风格 · 详情页元数据多列展示）
   用法：<view class="kpi-strip"> <view class="kpi-cell">...</view> ... </view>
   =================================================================== */
.kpi-strip {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-3);
  background: var(--card-bg-elevated);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  margin-bottom: var(--space-2);
}
.kpi-cell {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
  overflow: hidden;
}
.kpi-label {
  font-size: var(--fs-caption);
  color: var(--text-3);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  line-height: var(--lh-normal);
}
.kpi-value {
  font-size: var(--fs-emphasis);
  font-weight: 600;
  color: var(--text-1);
  font-family: var(--font-numeric);
  line-height: var(--lh-normal);
  word-break: break-word;
  white-space: normal;
}
.kpi-value.is-empty {
  color: var(--text-4);
  font-weight: 400;
}
.kpi-value.accent { color: var(--kpi-primary); }
.kpi-value.warning { color: var(--kpi-warning); }
.kpi-value.info { color: var(--kpi-info); }
.kpi-unit {
  font-size: var(--fs-caption);
  color: var(--text-3);
  font-weight: 400;
  margin-left: 4rpx;
}

/* ===================================================================
   共享组件 2：Source Badge（来源溯源徽标）
   用法：<view class="src-badge src-opendota">OpenDota</view>
   =================================================================== */
.src-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--fs-micro);
  padding: 2rpx 10rpx;
  border-radius: var(--radius-pill);
  background: var(--td-bg-color-component);
  color: var(--text-3);
  line-height: var(--lh-relaxed);
  border: 1rpx solid transparent;
}
.src-badge::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}
.src-opendota { color: var(--source-opendota); background: rgba(95, 211, 95, 0.10); }
.src-stratz { color: var(--source-stratz); background: rgba(96, 84, 241, 0.14); }
.src-steam { color: #66c0f4; background: rgba(27, 40, 56, 0.45); }
.src-liquipedia { color: var(--source-liquipedia); background: rgba(255, 207, 92, 0.12); }
.src-curation { color: var(--source-curation); background: rgba(155, 176, 201, 0.12); }
.src-verified { color: var(--status-verified); background: rgba(95, 211, 168, 0.12); }

/* 来源溯源网格（详情页合并 quality-bar/name-fix/liq-banner/meta-card 为一区） */
.source-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  align-items: center;
}
.source-grid .src-badge { margin-right: 4rpx; }

/* ===================================================================
   共享组件 3：Fresh Label（新鲜度标签，统一全站）
   用法：<text class="fresh-label">{{updatedLabel}}</text>
   =================================================================== */
.fresh-label {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--fs-micro);
  color: var(--text-3);
  font-family: var(--font-mono);
  line-height: var(--lh-normal);
}
.fresh-label::before {
  content: '⟳';
  font-size: var(--fs-caption);
}
/* D1 赛程更新时间（2026-08-03）：与 OpenDota 数据新鲜度标签并排时留间距 + 更淡色区分 */
.schedule-fresh-label {
  margin-left: 16rpx;
  color: var(--text-4);
}
.schedule-fresh-label::before {
  content: '🕒';
  font-size: var(--fs-caption);
}

/* ===================================================================
   共享组件 4：Match VS Card（B 风格 · 左右对阵紧凑式）
   用法：<view class="vs-card"> <view class="vs-side home">...</view>
        <view class="vs-center">...</view> <view class="vs-side away">...</view> </view>
   替换原双行布局，横向利用屏幕宽度，比分居中突出
   =================================================================== */
.vs-card {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: var(--space-2);
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: var(--space-2) var(--space-3);
  margin-bottom: var(--space-2);
  position: relative;
  overflow: hidden;
}
.vs-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 4rpx;
  background: var(--card-bg-inset);
}
.vs-card.radiant-win::before { background: var(--status-ongoing); }
.vs-card.dire-win::before { background: var(--dire); }
.vs-side {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}
.vs-side.away { align-items: flex-end; text-align: right; }
.vs-team {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
}
.vs-side.away .vs-team { flex-direction: row-reverse; }
.vs-team-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-md);
  background: var(--card-bg-inset);
  flex-shrink: 0;
}
.vs-team-name {
  font-size: var(--fs-subhead);
  font-weight: 500;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 200rpx;
}
.vs-score {
  font-size: var(--fs-mega);
  font-weight: 700;
  font-family: var(--font-numeric);
  line-height: 1;
}
.vs-score.win { color: var(--status-ongoing); }
.vs-score.lose { color: var(--dire); }
/* 胜方「胜」徽章（金色强调，区别于 faction 绿/红比分） */
.vs-win-badge {
  margin-left: 8rpx;
  font-size: var(--fs-badge);
  font-weight: 700;
  color: var(--tier-s-text);
  background: var(--dota-gold-soft);
  border: 1rpx solid rgba(200,169,81,0.4);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  line-height: var(--lh-normal);
  letter-spacing: 1rpx;
  flex-shrink: 0;
}
.vs-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 80rpx;
}
.vs-vs {
  font-size: var(--fs-caption);
  color: var(--text-3);
  font-weight: 600;
  letter-spacing: 1rpx;
}
.vs-meta {
  font-size: var(--fs-micro);
  color: var(--text-3);
  font-family: var(--font-mono);
  white-space: nowrap;
}

/* ===================================================================
   共享组件 5：Stat Row（C 风格 · 表格化数据行）
   用法：<view class="stat-row"> <text class="stat-label">胜率</text>
        <view class="stat-bar"><view class="stat-bar-fill" style="width:65%"></view></view>
        <text class="stat-value">65%</text> </view>
   =================================================================== */
.stat-row {
  display: grid;
  grid-template-columns: 120rpx 1fr 80rpx;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-1) 0;
}
.stat-label {
  font-size: var(--fs-body);
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.stat-bar {
  height: 12rpx;
  background: var(--card-bg-inset);
  border-radius: var(--radius-pill);
  overflow: hidden;
}
.stat-bar-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--status-ongoing);
  transition: width 240ms ease;
}
.stat-bar-fill.warning { background: var(--status-upcoming); }
.stat-bar-fill.danger { background: var(--dire); }
.stat-value {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-1);
  font-family: var(--font-numeric);
  text-align: right;
}

/* ===================================================================
   共享组件 7：Hero Banner（方案 A 局部强化 · 仅 SSS 级赛事/TI 决赛）
   用法：<view class="hero-banner" style="background-image:url(...)">
        <view class="hero-overlay"></view>
        <view class="hero-content">...</view> </view>
   =================================================================== */
.hero-banner {
  position: relative;
  width: 100%;
  height: 280rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--space-2);
  background-size: cover;
  background-position: center;
  background-color: var(--card-bg-inset);
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(14, 17, 22, 0.3) 0%, rgba(14, 17, 22, 0.85) 100%);
}
.hero-content {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: var(--space-3);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.hero-title {
  font-size: var(--fs-mega);
  font-weight: 700;
  color: var(--text-1);
  font-family: var(--font-display);
  /* 雾峰雪 v2.0：亮底去掉强阴影 */
  line-height: var(--lh-tight);
}
.hero-meta {
  display: flex;
  gap: var(--space-2);
  align-items: center;
  font-size: var(--fs-body);
  color: var(--text-3);
}

/* ===================================================================
   共享组件 8：Empty Hint Card（增强版空态引导）
   用于无数据场景的引导卡片
   =================================================================== */
.hint-card-enhanced {
  background: var(--card-bg-elevated);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin: var(--space-3) 0;
  border-left: 6rpx solid var(--status-upcoming);
}
.hint-card-enhanced .hint-title {
  font-size: var(--fs-emphasis);
  font-weight: 600;
  color: var(--status-upcoming);
  margin-bottom: var(--space-2);
}
.hint-card-enhanced .hint-desc {
  font-size: var(--fs-label);
  color: #9aa4b2;
  line-height: var(--lh-relaxed);
  margin-bottom: var(--space-3);
}
.hint-card-enhanced .hint-step {
  font-size: var(--fs-body);
  color: #7d8794;
  line-height: var(--lh-loose);
  margin-top: var(--space-1);
}
/* 数据源健康提示（2026-08-11 长期架构改进落地）：链路异常时警告色而非「暂无数据」蓝 */
.hint-card-enhanced .hint-title.hint-warn {
  color: #d97757;
}

/* ★ v8.31（详情页感知优化）：加载期「同步中」脉冲点（与 leagues 页 sync-bar 同款视觉语言）。
   明确的活动指示比静止文字提示的感知等待时间更短。 */
.sync-row {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}
.sync-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--dota-gold, #C8A951);
  flex-shrink: 0;
  animation: sync-pulse 1.2s ease-in-out infinite;
}
@keyframes sync-pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.85); }
  50%      { opacity: 1;    transform: scale(1.15); }
}

/* ===================================================================
   共享组件 9：Section Header（统一区块标题）
   用法：<view class="section-header"><text class="section-title">近期战绩</text>
        <text class="section-action">查看全部</text></view>
   =================================================================== */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--space-2) var(--space-1);
  margin-top: var(--space-3);
}
.section-title {
  font-size: var(--fs-subhead);
  font-weight: 600;
  color: var(--text-1);
  letter-spacing: 1rpx;
}
.section-action {
  font-size: var(--fs-caption);
  color: var(--text-3);
  font-family: var(--font-mono);
}

/* ===================================================================
   共享组件 10：Brand Logo（Dire 阵营符号 · 暗色聚光灯设计语言）
   用法：<image class="brand-logo" src="/assets/brand-logo.png" mode="aspectFill" />
   或 <image class="brand-logo brand-logo--sm" src="/assets/brand-logo.png" mode="aspectFill" />
   图片 LOGO：保留 DOTA2 Dire 符号原形 + 深炭底/聚光灯微光/天辉绿-夜魇红阵营色点缀。
   版权安全：Dire 符号为 Valve 游戏内阵营标记，非商标 logo，已添加原创设计修饰层。
   =================================================================== */
.brand-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.brand-logo--sm {
  width: 72rpx;
  height: 72rpx;
  border-radius: 6rpx;
}

/* 品牌栏（列表页顶部：Logo + 名称 + 副标题） */
.brand-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.brand-text { display: flex; flex-direction: column; gap: 2rpx; min-width: 0; }
.brand-title {
  font-size: var(--fs-display);
  font-weight: 700;
  color: var(--text-1);
  font-family: var(--font-display, sans-serif);
  line-height: var(--lh-tight);
}
.brand-sub {
  font-size: var(--fs-caption);
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.brand-search {
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--td-bg-color-component);
  border: 1rpx solid var(--td-border-level-1-color);
}

/* ===================================================================
   共享组件 11：动效工具类（V2 · 列表项入场 / 内容淡入 / 按压反馈）
   - .anim-fade-up：错峰淡入 + 上滑（与 wxml 内联 animation-delay 配合）
   - .anim-fade：内容出现时的一次性淡入（骨架屏 → 真实内容 cross-fade）
   - .tap-scale：按压微缩放（作为无自有 hover 类的列表项 hover-class 使用）
   说明：页面级转场需 Skyline 渲染引擎；WebView 下小程序系统控制转场，
   故 V2 仅落地「列表/卡片入场 + 内容淡入 + 按压反馈」三项客户端可控动效。
   =================================================================== */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.anim-fade-up {
  animation: fadeUp 0.42s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}
.anim-fade {
  animation: fadeIn 0.35s ease both;
}
.tap-scale {
  transform: scale(0.98);
  transition: transform 0.12s ease;
}

/* ===================================================================
   共享组件 12：无障碍工具类（v17 落地）
   - .touchable：保证可点击元素最小触控目标 88rpx（44px WCAG AA 标准）
   - @media (prefers-reduced-motion: reduce)：尊重用户减少动画偏好
   =================================================================== */
.touchable {
  min-width: 88rpx;
  min-height: 88rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 无障碍：用户启用「减少动态效果」时关闭所有装饰性循环动画 */
@media (prefers-reduced-motion: reduce) {
  .live-pulse,
  .signal-active,
  .league-item--ongoing,
  .anim-fade-up,
  .anim-fade {
    animation: none !important;
  }
  .tap-scale {
    transition: none !important;
  }
}

/* ===================================================================
   动效 Token（v11 聚光灯 §1.4.2）：缓动曲线 + 时长 + 关键动画
   所有动画统一引用 Token；infinite 循环仅用于环境氛围动画（呼吸/光晕）
   =================================================================== */
page {
  /* 缓动曲线 */
  --ease-out:    cubic-bezier(0.16, 1, 0.3, 1);       /* 元素入场/展开 */
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);      /* 持续循环动画 */
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);   /* 弹性反馈（tabBar 选中） */
  --ease-back:   cubic-bezier(0.68, -0.3, 0.27, 1.3); /* 弹出（toast/徽章） */

  /* 时长 Token */
  --dur-fast:   150ms;   /* 微交互（hover/点击反馈） */
  --dur-normal: 300ms;   /* 过渡（卡片淡入/页面切换/浸染展开） */
  --dur-slow:   600ms;   /* 叙事动画（光晕呼吸/LIVE 脉冲） */
  --dur-breath: 2400ms;  /* 呼吸循环（LIVE 脉冲/信号点）：参照平静呼吸 12-20 次/分，落在 ~25 次/分 区间，平缓不急促 */
  --dur-sway:   1600ms;  /* 中等节奏装饰动画（加载更多待命光晕/箭头浮动/标签脉冲）：介于过渡与平静呼吸之间，约 37 次/分 */
}

/* ① LIVE 脉冲呼吸（赛事列表/详情页进行中卡片）
   节奏：吸气(0→35%) → 峰值保持(35→55%) → 呼气(55→90%) → 静息(90→100%)，模拟真实呼吸而非急促闪烁。
   雾峰雪 v2.0：光晕色统一 --status-live var(--status-live)（red-500，4.0:1 过 WCAG-AA）。 */
@keyframes pulse-glow {
  0%       { box-shadow: 0 0 4rpx  rgba(239, 68, 68, 0.20); }
  35%, 55% { box-shadow: 0 0 14rpx rgba(239, 68, 68, 0.50); }
  90%      { box-shadow: 0 0 4rpx  rgba(239, 68, 68, 0.20); }
  100%     { box-shadow: 0 0 4rpx  rgba(239, 68, 68, 0.20); }
}
.live-pulse {
  animation: pulse-glow var(--dur-breath) var(--ease-in-out) infinite;
}

/* ② 信号激活脉冲（我的页面·赛事提醒已开启徽章）—— 同呼吸节奏 */
@keyframes signal-dot {
  0%       { opacity: 0.4; transform: scale(0.8); }
  35%, 55% { opacity: 1.0; transform: scale(1.2); }
  90%      { opacity: 0.4; transform: scale(0.8); }
  100%     { opacity: 0.4; transform: scale(0.8); }
}
.signal-active {
  animation: signal-dot var(--dur-breath) var(--ease-in-out) infinite;
}

/* ③ 卡片入场（列表页首次渲染 + 分页加载）——与既有 fadeUp 兼容，规范名 fade-up */
@keyframes fade-up {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.anim-fade-up-spec {
  animation: fade-up var(--dur-normal) var(--ease-out) both;
}

/* ④ 触控按压反馈（规范 §1.4.2 标准版，区别于上面 .tap-scale 静态 scale）
   雾峰雪 v2.0：亮色系下 opacity 反馈不明显，增加填底 + scale 复合反馈 */
.tap-scale:active {
  transform: scale(0.97);
  background: var(--td-bg-color-component-active, #E5E7EB);
  transition: transform var(--dur-fast) var(--ease-spring),
              background var(--dur-fast) var(--ease-out);
}

/* ⑤ 关注星标填充动画（从空心→实心） */
@keyframes star-fill {
  from { transform: scale(0.6); opacity: 0.3; }
  to   { transform: scale(1);   opacity: 1; }
}
.star-fill {
  animation: star-fill var(--dur-normal) var(--ease-out) both;
}
