/* ===== TDesign 设计变量（先引入完整 token 集，再强制暗色覆盖） ===== */
@import 'miniprogram_npm/tdesign-miniprogram/common/style/theme/_index.wxss';

/* 暗色极简风主题：深色底 + 等级彩条 + 天辉绿/夜魇红胜负语义 */
page {
  /* 天辉夜魇配色：胜=天辉绿 / 负=夜魇红 */
  --radiant: #5fd35f;
  --radiant-strong: #46c457;
  --radiant-soft: rgba(95, 211, 95, 0.12);
  --dire: #e8443b;
  --dire-strong: #c9352d;
  --dire-soft: rgba(232, 68, 59, 0.12);

  /* 品牌色：DOTA2 暗金 #C8A951（强调色，区别于 TDesign 默认蓝）
     说明：胜/负语义色 --radiant(--dire) 保持不变，仅 UI 强调色（按钮/选中/链接）改用暗金 */
  --dota-red: #A41E1E;
  --dota-red-strong: #7a1414;
  --dota-gold: #C8A951;
  --dota-gold-strong: #b08a3e;
  --dota-gold-soft: rgba(200, 169, 81, 0.14);
  --td-brand-color: #C8A951;
  --td-brand-color-active: #b08a3e;
  --td-brand-color-disabled: #4a4228;
  --td-brand-color-light: rgba(200, 169, 81, 0.14);
  --td-brand-color-light-active: rgba(200, 169, 81, 0.24);
  --td-brand-color-focus: rgba(200, 169, 81, 0.14);
  --td-primary-color-7: #C8A951;
  --td-primary-color-8: #d8be7a;
  --td-text-color-brand: #C8A951;
  --td-text-color-link: #C8A951;

  /* ===== 全局 Tier 用色 Token（暗色设计系统，S金/A紫/B蓝 规范） =====
     单一来源：所有等级色彩统一由此定义，各页面/组件仅引用 Token，禁止散落字面量。
     规范映射：SSS=TI官方(亮金) / S=S-Tier(暗金·品牌金) / A=A-Tier(紫) / B=B-Tier(蓝) / C=社区赛(灰)
     用途：等级彩条(::before)、t-tag 文本色(.tier-text-*)、筛选 chip 描边(.gc--*) 等。 */
  --tier-sss: #FFD15C;          /* TI 官方顶级 · 亮金 */
  --tier-s:   #C8A951;          /* S-Tier · 暗金（品牌色） */
  --tier-a:   #A777E3;          /* A-Tier · 紫 */
  --tier-b:   #5B9BD5;          /* B-Tier · 蓝 */
  --tier-c:   #7A8696;          /* 社区赛 · 灰 */
  --tier-sss-soft: rgba(255, 209, 92, 0.14);
  --tier-s-soft:   rgba(200, 169, 81, 0.14);
  --tier-a-soft:   rgba(167, 119, 227, 0.14);
  --tier-b-soft:   rgba(91, 155, 213, 0.14);
  --tier-c-soft:   rgba(122, 134, 150, 0.14);
  /* 等级描边色（0.4 alpha，用于筛选 chip / 卡片边框等需要半透明的场景） */
  --tier-sss-line: rgba(255, 209, 92, 0.40);
  --tier-s-line:   rgba(200, 169, 81, 0.40);
  --tier-a-line:   rgba(167, 119, 227, 0.40);
  --tier-b-line:   rgba(91, 155, 213, 0.40);
  --tier-c-line:   rgba(122, 134, 150, 0.40);

  /* 夜魇红：危险/错误/取消关注 */
  --td-error-color: #e8443b;
  --td-error-color-active: #c9352d;
  --td-error-color-disabled: #5a2b28;
  --td-error-color-light: rgba(232, 68, 59, 0.12);
  --td-error-color-light-active: rgba(232, 68, 59, 0.22);
  --td-text-color-error: #e8443b;

  /* 背景（深色） */
  --td-bg-color-page: #0e1116;
  --td-bg-color-container: #161b22;
  --td-bg-color-container-active: #1c232c;
  --td-bg-color-secondarycontainer: #161b22;
  --td-bg-color-component: #1c232c;
  --td-bg-color-component-active: #232a33;
  --td-bg-color-component-disabled: #161b22;
  --td-bg-color-specialcomponent: #161b22;

  /* 文字 */
  --td-text-color-primary: #f0f3f6;
  --td-text-color-secondary: #8a8f99;
  --td-text-color-placeholder: #5b626d;
  --td-text-color-disabled: #5b626d;
  --td-text-color-anti: #f0f3f6;

  /* 边框/分割线 */
  --td-border-level-1-color: #232a33;
  --td-component-stroke: #232a33;
  --td-border-level-2-color: #2b333d;
  --td-component-border: #2b333d;

  /* 遮罩 */
  --td-mask-active: rgba(0, 0, 0, 0.6);
  --td-mask-background: rgba(14, 17, 22, 0.96);

  /* 全局背景与文字 */
  background: #0e1116;
  color: #f0f3f6;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
}

/* ===== 全局 Tier 用色 Token 工具类（暗色设计系统，S金/A紫/B蓝 规范） =====
   仅定义颜色，几何尺寸（彩条宽度/定位）由各卡片 .tier-* 容器自身的 ::before 提供。
   各页面/组件统一引用此处 Token，禁止散落字面量（见 #14）。 */
.tier-sss::before { background: var(--tier-sss); }
.tier-s::before   { background: var(--tier-s); }
.tier-a::before   { background: var(--tier-a); }
.tier-b::before   { background: var(--tier-b); }
.tier-c::before   { background: var(--tier-c); }
/* 等级文本色工具类（供 t-tag / 文字直接引用） */
.tier-text-sss { color: var(--tier-sss); }
.tier-text-s   { color: var(--tier-s); }
.tier-text-a   { color: var(--tier-a); }
.tier-text-b   { color: var(--tier-b); }
.tier-text-c   { color: var(--tier-c); }

/* 胜率颜色分级工具类（全局：teams / league-detail 共用，统一收敛到 kpi Token，禁止本地散落定义） */
.wr-high { color: var(--kpi-primary, #5fd35f); }
.wr-mid  { color: var(--kpi-warning, #f0aa28); }
.wr-low  { color: #8a8f99; }

view, text { box-sizing: border-box; }

/* 通用容器 */
.container { padding: 24rpx; }

/* 带自定义 tabBar 的页面容器，预留底部导航栏高度 + 安全区 */
.with-tab-bar { padding-bottom: calc(132rpx + env(safe-area-inset-bottom)); }

/* 搜索栏上下间距 */
.search-wrap { margin: 8rpx 0 20rpx; }

/* 卡片（暗色底无边框，极简） */
.card {
  background: #161b22;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

/* 行布局 */
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }

/* 文字 */
.title { font-size: 32rpx; font-weight: 600; color: #f0f3f6; }
.sub { font-size: 24rpx; color: #8a8f99; }
.muted { color: #8a8f99; }
.bold { font-weight: 600; }

/* 等级标签（暗底上用半透明亮色） */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.6;
}
.tag-sss { background: rgba(240,170,40,.22); color: #ffcf5c; }
.tag-s { background: rgba(95,211,95,.18); color: #5fd35f; }
.tag-a { background: rgba(240,170,40,.18); color: #f0aa28; }
.tag-b { background: rgba(120,140,160,.18); color: #9bb0c9; }
.tag-c { background: rgba(120,140,160,.12); color: #7a8696; }

/* 胜负色：天辉绿=胜 / 夜魇红=负 */
.win { color: #5fd35f; }
.lose { color: #e8443b; }

/* 加载 / 空态 */
.center { text-align: center; color: #8a8f99; padding: 80rpx 0; }

/* 搜索框（TDesign 之外的兜底） */
.search-bar {
  display: flex;
  align-items: center;
  background: #161b22;
  border: 1rpx solid #232a33;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 20rpx;
}
.search-bar input { flex: 1; margin-left: 12rpx; color: #f0f3f6; }

/* 分段选择（筛选条）—— 暗色运动风：选中=天辉绿 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.filter-bar .chip {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #8a8f99;
  background: #161b22;
  border: 1rpx solid #232a33;
  border-radius: 12rpx;
}
.filter-bar .chip.active {
  color: #0e1116;
  background: var(--dota-gold);
  border-color: var(--dota-gold);
}

/* 新鲜度标签（更新于 X 前）推到最右 */
.filter-bar .fresh {
  margin-left: auto;
  align-self: center;
  font-size: 22rpx;
  white-space: nowrap;
  padding-left: 8rpx;
}

/* 分段选择（通用，用于 现役/历史、关注分类等） */
.seg {
  display: flex;
  background: #0e1116;
  border: 1rpx solid #232a33;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #8a8f99;
  padding: 14rpx 0;
  border-radius: 10rpx;
}
.seg-item.active {
  background: var(--dota-gold);
  color: #0e1116;
  font-weight: 600;
}

/* 加载更多按钮容器 */
.loadmore { text-align: center; padding: 24rpx 0; }

/* 天辉→夜魇 渐变签名条（页面可选使用） */
.radiant-dire-bar {
  height: 6rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #5fd35f 0%, #8a7d3b 50%, #e8443b 100%);
  margin-bottom: 20rpx;
}

/* ===================================================================
   B+C 混合设计系统 · 共享 token 与组件类
   - 移动动态卡片（B）用于列表/关注页：大圆角、左右对阵、状态脉冲
   - 数据指挥台（C）用于详情页：KPI strip、表格化、来源溯源网格
   - 决赛/重要赛事可叠加方案 A 局部强化（hero banner）
   =================================================================== */

page {
  /* ===== 字体 token ===== */
  /* 数字等宽：胜率/比分/KDA 等，确保数字对齐 */
  --font-numeric: "SF Pro Display", "Inter", -apple-system, "PingFang SC", sans-serif;
  /* 等宽代码：match_id / steam_id 等 */
  --font-mono: "JetBrains Mono", "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  /* 显示字体：标题（仅详情页头部与决赛 hero 使用，列表页仍用系统字体保持性能） */
  --font-display: "SF Pro Display", -apple-system, "PingFang SC", sans-serif;

  /* ===== 间距 token ===== */
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;

  /* ===== 圆角 token ===== */
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
  --radius-pill: 999rpx;

  /* ===== 状态色 token（统一全站语义） ===== */
  --status-live: #1ec896;          /* 直播中：脉冲绿 */
  --status-ongoing: #5fd35f;       /* 进行中：天辉绿 */
  --status-upcoming: #f0aa28;      /* 即将到来：琥珀 */
  --status-ended: #6b7280;         /* 已结束：灰 */
  --status-verified: #5fd3a8;      /* 多源验证：青绿 */

  /* ===== H2H 双方对战条形配色（spec B.3：主队青绿 / 客队红） ===== */
  --h2h-a: #2DD4A7;                /* 主队（左）强调色：青绿/Radiant 风 */
  --h2h-a-soft: rgba(45, 212, 167, 0.14);
  --h2h-b: #F25C54;                /* 客队（右）强调色：红/Dire 风 */
  --h2h-b-soft: rgba(242, 92, 84, 0.14);

  /* ===== 来源溯源 token（数据可信度徽标） ===== */
  --source-opendota: #5fd35f;
  --source-stratz: #6054f1;
  --source-steam: #1b2838;
  --source-liquipedia: #ffcf5c;
  --source-curation: #9bb0c9;

  /* ===== 卡片层级（增加深度感，不再全平 #161b22） ===== */
  --card-bg: #161b22;
  --card-bg-elevated: #1c232c;     /* 浮起卡片：直播卡/KPI strip */
  --card-bg-inset: #0f141b;         /* 内嵌区：表格行/cell */

  /* ===== 数据指挥台 KPI 色（C 风格专用，仅用于强调单个 KPI） ===== */
  --kpi-primary: #5fd35f;
  --kpi-warning: #f0aa28;
  --kpi-info: #6054f1;

  /* 字体特性：tabular-nums 让数字对齐 */
  font-variant-numeric: tabular-nums;
}

/* ===================================================================
   共享组件 1：KPI Strip（C 风格 · 详情页元数据多列展示）
   用法：<view class="kpi-strip"> <view class="kpi-cell">...</view> ... </view>
   =================================================================== */
.kpi-strip {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-3);
  background: var(--card-bg-elevated);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  margin-bottom: var(--space-2);
}
.kpi-cell {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
  overflow: hidden;
}
.kpi-label {
  font-size: 22rpx;
  color: #8a8f99;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  line-height: 1.4;
}
.kpi-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #f0f3f6;
  font-family: var(--font-numeric);
  line-height: 1.35;
  word-break: break-word;
  white-space: normal;
}
.kpi-value.is-empty {
  color: #5b626d;
  font-weight: 400;
}
.kpi-value.accent { color: var(--kpi-primary); }
.kpi-value.warning { color: var(--kpi-warning); }
.kpi-value.info { color: var(--kpi-info); }
.kpi-unit {
  font-size: 22rpx;
  color: #8a8f99;
  font-weight: 400;
  margin-left: 4rpx;
}

/* ===================================================================
   共享组件 2：Source Badge（来源溯源徽标）
   用法：<view class="src-badge src-opendota">OpenDota</view>
   =================================================================== */
.src-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-pill);
  background: rgba(120, 140, 160, 0.12);
  color: #9bb0c9;
  line-height: 1.6;
  border: 1rpx solid transparent;
}
.src-badge::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}
.src-opendota { color: var(--source-opendota); background: rgba(95, 211, 95, 0.10); }
.src-stratz { color: var(--source-stratz); background: rgba(96, 84, 241, 0.14); }
.src-steam { color: #66c0f4; background: rgba(27, 40, 56, 0.45); }
.src-liquipedia { color: var(--source-liquipedia); background: rgba(255, 207, 92, 0.12); }
.src-curation { color: var(--source-curation); background: rgba(155, 176, 201, 0.12); }
.src-verified { color: var(--status-verified); background: rgba(95, 211, 168, 0.12); }

/* 来源溯源网格（详情页合并 quality-bar/name-fix/liq-banner/meta-card 为一区） */
.source-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  align-items: center;
}
.source-grid .src-badge { margin-right: 4rpx; }

/* ===================================================================
   共享组件 3：Fresh Label（新鲜度标签，统一全站）
   用法：<text class="fresh-label">{{updatedLabel}}</text>
   =================================================================== */
.fresh-label {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: #6b7280;
  font-family: var(--font-mono);
  line-height: 1.4;
}
.fresh-label::before {
  content: '⟳';
  font-size: 22rpx;
}

/* ===================================================================
   共享组件 4：Match VS Card（B 风格 · 左右对阵紧凑式）
   用法：<view class="vs-card"> <view class="vs-side home">...</view>
        <view class="vs-center">...</view> <view class="vs-side away">...</view> </view>
   替换原双行布局，横向利用屏幕宽度，比分居中突出
   =================================================================== */
.vs-card {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: var(--space-2);
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: var(--space-2) var(--space-3);
  margin-bottom: var(--space-2);
  position: relative;
  overflow: hidden;
}
.vs-card::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 4rpx;
  background: var(--card-bg-inset);
}
.vs-card.radiant-win::before { background: var(--status-ongoing); }
.vs-card.dire-win::before { background: var(--dire); }
.vs-side {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}
.vs-side.away { align-items: flex-end; text-align: right; }
.vs-team {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
}
.vs-side.away .vs-team { flex-direction: row-reverse; }
.vs-team-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-md);
  background: var(--card-bg-inset);
  flex-shrink: 0;
}
.vs-team-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #f0f3f6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 200rpx;
}
.vs-score {
  font-size: 40rpx;
  font-weight: 700;
  font-family: var(--font-numeric);
  line-height: 1;
}
.vs-score.win { color: var(--status-ongoing); }
.vs-score.lose { color: var(--dire); }
/* 胜方「胜」徽章（金色强调，区别于 faction 绿/红比分） */
.vs-win-badge {
  margin-left: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #1a1205;
  background: linear-gradient(135deg, #ffcf5c, #C8A951);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}
.vs-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 80rpx;
}
.vs-vs {
  font-size: 22rpx;
  color: #6b7280;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.vs-meta {
  font-size: 20rpx;
  color: #6b7280;
  font-family: var(--font-mono);
  white-space: nowrap;
}

/* ===================================================================
   共享组件 5：Stat Row（C 风格 · 表格化数据行）
   用法：<view class="stat-row"> <text class="stat-label">胜率</text>
        <view class="stat-bar"><view class="stat-bar-fill" style="width:65%"></view></view>
        <text class="stat-value">65%</text> </view>
   =================================================================== */
.stat-row {
  display: grid;
  grid-template-columns: 120rpx 1fr 80rpx;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-1) 0;
}
.stat-label {
  font-size: 24rpx;
  color: #8a8f99;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.stat-bar {
  height: 12rpx;
  background: var(--card-bg-inset);
  border-radius: var(--radius-pill);
  overflow: hidden;
}
.stat-bar-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--status-ongoing);
  transition: width 240ms ease;
}
.stat-bar-fill.warning { background: var(--status-upcoming); }
.stat-bar-fill.danger { background: var(--dire); }
.stat-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #f0f3f6;
  font-family: var(--font-numeric);
  text-align: right;
}

/* ===================================================================
   共享组件 7：Hero Banner（方案 A 局部强化 · 仅 SSS 级赛事/TI 决赛）
   用法：<view class="hero-banner" style="background-image:url(...)">
        <view class="hero-overlay"></view>
        <view class="hero-content">...</view> </view>
   =================================================================== */
.hero-banner {
  position: relative;
  width: 100%;
  height: 280rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--space-2);
  background-size: cover;
  background-position: center;
  background-color: var(--card-bg-inset);
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(14, 17, 22, 0.3) 0%, rgba(14, 17, 22, 0.85) 100%);
}
.hero-content {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: var(--space-3);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #f0f3f6;
  font-family: var(--font-display);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.6);
  line-height: 1.2;
}
.hero-meta {
  display: flex;
  gap: var(--space-2);
  align-items: center;
  font-size: 24rpx;
  color: #c9d1d9;
}

/* ===================================================================
   共享组件 8：Empty Hint Card（增强版空态引导）
   用于无数据场景的引导卡片
   =================================================================== */
.hint-card-enhanced {
  background: var(--card-bg-elevated);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin: var(--space-3) 0;
  border-left: 6rpx solid var(--status-upcoming);
}
.hint-card-enhanced .hint-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--status-upcoming);
  margin-bottom: var(--space-2);
}
.hint-card-enhanced .hint-desc {
  font-size: 26rpx;
  color: #9aa4b2;
  line-height: 1.6;
  margin-bottom: var(--space-3);
}
.hint-card-enhanced .hint-step {
  font-size: 24rpx;
  color: #7d8794;
  line-height: 1.7;
  margin-top: var(--space-1);
}

/* ===================================================================
   共享组件 9：Section Header（统一区块标题）
   用法：<view class="section-header"><text class="section-title">近期战绩</text>
        <text class="section-action">查看全部</text></view>
   =================================================================== */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--space-2) var(--space-1);
  margin-top: var(--space-3);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #f0f3f6;
  letter-spacing: 1rpx;
}
.section-action {
  font-size: 22rpx;
  color: #6b7280;
  font-family: var(--font-mono);
}

/* ===================================================================
   共享组件 10：Brand Logo（DOTA2 风格纯 CSS 标识，无外部资源）
   用法：<view class="brand-logo" /> 或 <view class="brand-logo brand-logo--sm" />
   红盾 + 暗金描边 + “D2” 字样，用于关于页 / 启动页 / 列表页品牌栏
   =================================================================== */
.brand-logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  background: linear-gradient(155deg, var(--dota-red) 0%, var(--dota-red-strong) 100%);
  border: 3rpx solid var(--dota-gold);
  box-shadow: 0 4rpx 14rpx rgba(164, 30, 30, 0.35);
  flex-shrink: 0;
}
.brand-logo::after {
  content: 'D2';
  font-family: var(--font-display, sans-serif);
  font-size: 44rpx;
  font-weight: 800;
  color: var(--dota-gold);
  letter-spacing: 1rpx;
}
.brand-logo--sm {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  border-width: 2rpx;
}
.brand-logo--sm::after { font-size: 28rpx; }

/* 品牌栏（列表页顶部：Logo + 名称 + 副标题） */
.brand-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.brand-text { display: flex; flex-direction: column; gap: 2rpx; min-width: 0; }
.brand-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #f0f3f6;
  font-family: var(--font-display, sans-serif);
  line-height: 1.2;
}
.brand-sub {
  font-size: 22rpx;
  color: #8a8f99;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.brand-search {
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #161b22;
  border: 1rpx solid rgba(255,255,255,0.08);
}

/* ===================================================================
   共享组件 11：动效工具类（V2 · 列表项入场 / 内容淡入 / 按压反馈）
   - .anim-fade-up：错峰淡入 + 上滑（与 wxml 内联 animation-delay 配合）
   - .anim-fade：内容出现时的一次性淡入（骨架屏 → 真实内容 cross-fade）
   - .tap-scale：按压微缩放（作为无自有 hover 类的列表项 hover-class 使用）
   说明：页面级转场需 Skyline 渲染引擎；WebView 下小程序系统控制转场，
   故 V2 仅落地「列表/卡片入场 + 内容淡入 + 按压反馈」三项客户端可控动效。
   =================================================================== */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.anim-fade-up {
  animation: fadeUp 0.42s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}
.anim-fade {
  animation: fadeIn 0.35s ease both;
}
.tap-scale {
  transform: scale(0.98);
  transition: transform 0.12s ease;
}
